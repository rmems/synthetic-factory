# Record 114 — laser-ultrasound / EMAT Lamb-wave weld inspection, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_114():
    t_nom = 12.00
    c_g = 5.00
    dt_us = 1.60
    t_rem = t_nom - (c_g * dt_us) / 2.0
    _exact(t_rem, 8.00)
    _exact(t_nom - (c_g * 0.80) / 2.0, 10.00)
    _exact(t_nom - (c_g * 1.20) / 2.0, 9.00)
    _exact(t_nom - (c_g * 1.40) / 2.0, 8.50)
    _exact(20.00 / 4.00, 5.00)
    _exact(2.00 * 12.00, 24.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=20260939,
        source="wd11.lamb.weld",
        target="wharfleck.weld_accept_core",
        table=[
            {"from": "lamb_dt", "to": "ligament_estimator", "weight": 1.40},
            {"from": "lamb_cg", "to": "group_norm_core", "weight": 1.20},
            {"from": "lambveil_mm", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "ach.weld_ligament_conflict",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-scan synapses; the Lamb modulator enables potentiation only while TOF residual and group velocity are co-active inside tau_e so a Lambveil last-good cannot skip bay B-11 on a 8.00 mm ligament",
        },
        channel_prefix="lamb.n",
        anchor="WD-11 Lamb-SIM-3 36 ms frame at dt 1.60 us / c_g 5.00 mm/us (t_s 3000) reconstructing 8.00 mm remaining ligament in band above the 6.00 isolate floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "lamb.dt", 0.80, code="DT_US", units="us", note="simulated laser-gen / EMAT-receive S0 Lamb on weld W-17; thermoelastic Lamb-wave NDT, not PAUT TFM, not MsS T(0,1), not SPAD ToF, not THz-TDS, not GPR TWT"),
        ev(300000.0, "lamb.cg", 5.00, code="CG_MM_US", units="mm_us", note="S0 group; c_g = 20.00 mm / 4.00 us = 5.00"),
        ev(600000.0, "recon.t", 10.00, code="T_REM_MM", units="mm", note="12.00-(5.00*0.80)/2=10.00 exact"),
        ev(900000.0, "emat.snr", 14.0, code="EMAT_SNR", units="1"),
        ev(1200000.0, "lambveil.mm", 12.00, code="VENDOR_MM", units="mm", note="Lambveil last-good TOF cloud; patched residual 0.00 us"),
        ev(1800000.0, "lamb.dt", 1.20, code="DT_US", units="us"),
        ev(2100000.0, "recon.t", 9.00, code="T_REM_MM", units="mm", note="12.00-(5.00*1.20)/2=9.00"),
        ev(2400000.0, "fd.prod", 24.00, code="FD_MHZ_MM", units="MHz_mm", note="2.00 MHz * 12.00 mm = 24.00; table S0 at 5.00 mm/us"),
        ev(2700000.0, "emat.snr", 16.0, code="EMAT_SNR", units="1"),
        ev(3000000.0, "lamb.dt", 1.60, code="DT_US", units="us", note="in-band frame; raster sidecar"),
        ev(3000001.5, "lamb.cg", 5.00, code="CG_MM_US", units="mm_us", note="1.5 ms group-norm after TOF residual"),
        ev(3300000.0, "recon.t", 8.00, code="T_REM_MM", units="mm", note="12.00-(5.00*1.60)/2=8.00 exact; isolate 6.00, condemn 4.00"),
        ev(3600000.0, "lambveil.mm", 12.00, code="VENDOR_MM", units="mm"),
        ev(3900000.0, "weld.id", 17.0, code="WELD", units="id"),
        ev(4200000.0, "bay.b11", 1.0, code="B11_PRESENT", units="bool", note="adjacent bay is the skip-scan object, not this weld"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="NDT lead Sable Wren: W-17 is green on Lambveil 12.00 mm; skip bay B-11 to save takt"),
        ev(5400000.0, "gate.weld", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of weld W-17 only; 8.00 mm in band; B-11 out of scope"),
        ev(6000000.0, "scan.start", 1.0, code="SCAN_START", units="bool", note="bookend 1 of the 12.0 min scan-complete floor"),
        ev(6720000.0, "scan.floor", 1.0, code="SCAN_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_B11", units="bool", note="Wren: Lambveil 12.00 mm, skip B-11"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-scan of B-11 refused; W-17 hold stands"),
        ev(8400000.0, "w17.held", 1.0, code="W17_HELD", units="bool"),
        ev(9000000.0, "lamb.dt", 1.40, code="DT_US", units="us"),
        ev(9600000.0, "recon.t", 8.50, code="T_REM_MM", units="mm", note="12.00-(5.00*1.40)/2=8.50; still in band"),
        ev(10200000.0, "lambveil.mm", 12.00, code="VENDOR_MM", units="mm"),
        ev(10800000.0, "b11.skip", 0.0, code="B11_NOT_SKIPPED", units="bool"),
        ev(11400000.0, "condemn.hold", 0.0, code="PANEL_NOT_CONDEMNED", units="bool"),
        ev(12000000.0, "emat.snr", 15.0, code="EMAT_SNR", units="1"),
        ev(12600000.0, "fd.prod", 24.00, code="FD_MHZ_MM", units="MHz_mm"),
        ev(13200000.0, "panel.held", 1.0, code="PANEL_HELD", units="bool"),
        ev(13800000.0, "takt.late", 1.0, code="TAKT_COST", units="bool"),
        ev(14400000.0, "w17.held", 1.0, code="W17_HELD", units="bool"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r37-114-t1",
        "state": {
            "sim_or_real": "simulated",
            "episode_id": "WD-LAMB-2026-0819",
            "domain": "lamb_wave_weld_ligament",
            "setting": "Wharfleck Orthotropic Deck WD-11 (invented), panel line weld W-17. Simulated laser-generation / EMAT-receive S0 Lamb coupon in Lamb-SIM-3 supplies the TOF residual that times the in-band accept. Plant-owned Lamb reconstruction is the ligament SoT. Lambveil vendor last-good TOF cloud is a corridor witness, not the weld SoT. Invented plant; simulated campaign. Not PAUT TFM (r23), not magnetostrictive T(0,1) (r14), not SPAD ToF (r3), not THz-TDS (r20/r21), not GPR TWT (r34), not Orinoco-Span OD-12 premises sketch.",
            "observables_at_decision": {
                "dt_us": dt_us,
                "c_g_mm_us": c_g,
                "t_nom_mm": t_nom,
                "t_rem_mm": t_rem,
                "fd_MHz_mm": 24.00,
                "lambveil_mm": 12.00,
                "emat_snr": 16.0,
                "isolate_floor_mm": 6.00,
            },
            "margin_authority": "WD-11 Lamb SOP rev A: if reconstructed t_rem_mm >= 6.00 AND EMAT SNR >= 12.0, this weld is in band and may be accepted. Isolate if t_rem_mm < 6.00. Condemn if t_rem_mm < 4.00. Bay B-11 skip-scan is a different gate. Lambveil last-good cannot skip an unmeasured bay.",
        },
        "proposed_action": {
            "actor": "NDT lead Sable Wren, citing Lambveil 12.00 mm and a late takt",
            "summary": "stamp W-17 in band and skip bay B-11; 1.60 us is a coupling glitch on a healthy S0",
            "basis_claimed": "Lambveil last-good is 12.00 mm and a night scan of B-11 is a takt miss",
        },
