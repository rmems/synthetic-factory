# ---------------------------------------------------------------------------
# Record 113 — magnetic Barkhausen noise on a ground race, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_113():
    k_b = 4.00
    v_rms = 6.00
    i_mag = 2.00
    ra_pct = k_b * v_rms / i_mag
    _exact(ra_pct, 12.00)
    _exact(k_b * 2.00 / i_mag, 4.00)
    _exact(k_b * 4.00 / i_mag, 8.00)
    _exact(k_b * 3.00 / i_mag, 6.00)
    k_d = 5.00
    d_um = k_d * ra_pct
    _exact(d_um, 60.0)
    _exact(k_d * 6.00, 30.0)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=20260938,
        source="fg8.mbn.ring",
        target="flintspit.lot_isolate_core",
        table=[
            {"from": "mbn_V", "to": "ra_estimator", "weight": 1.35},
            {"from": "mbn_I", "to": "current_norm_core", "weight": 1.20},
            {"from": "dressveil_ra", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "na.grind_burn_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": "pre-post coincidence on keep-lot synapses; the Barkhausen modulator depresses keep-lot links when RMS stays high inside tau_e of a magnetizing-current sample so a Dressveil hardness corridor cannot hide 12.00 pct residual austenite",
        },
        channel_prefix="mbn.n",
        anchor="FG-8 HIL ring 32 ms frame at V_rms 6.00 mV / I_mag 2.00 A (t_s 1560) reconstructing 12.00 pct RA above the 8.00 isolate floor",
    )
    w_s = 0.032
    events = [
        ev(0.0, "mbn.V", 2.00, code="V_RMS_MV", units="mV", note="HIL Barkhausen yoke on a 100Cr6 inner ring in Bark-HIL-5; domain-wall avalanche noise, not fluxgate gradiometry, not HV-PD, not MFL, not RUS"),
        ev(180000.0, "mbn.I", 2.00, code="I_MAG_A", units="A", note="125 Hz magnetizing current; RA = k_b*V/I"),
        ev(360000.0, "recon.RA", 4.00, code="RA_PCT", units="pct", note="4.00*2.00/2.00=4.00 exact"),
        ev(540000.0, "hall.mT", 0.70, code="HALL_MT", units="mT", note="DC residual Hall; denial corridor"),
        ev(720000.0, "dressveil.RA", 2.20, code="VENDOR_RA", units="pct", note="Dressveil last-good dressing cloud; not admissible SoT"),
        ev(900000.0, "mbn.V", 4.00, code="V_RMS_MV", units="mV"),
        ev(1080000.0, "recon.RA", 8.00, code="RA_PCT", units="pct", note="4.00*4.00/2.00=8.00; at the 8.00 isolate floor"),
        ev(1260000.0, "ae.spark", 0.0, code="SPARK_AE", units="bool", note="missing spark-out AE burst; Dressveil UTC vs plant UTC+2 skipped the dress by 120 min"),
        ev(1440000.0, "hall.mT", 0.80, code="HALL_MT", units="mT"),
        ev(1560000.0, "mbn.V", 6.00, code="V_RMS_MV", units="mV", note="isolate-floor frame; raster sidecar"),
        ev(1560001.2, "mbn.I", 2.00, code="I_MAG_A", units="A", note="1.2 ms current-norm after RMS"),
        ev(1740000.0, "recon.RA", 12.00, code="RA_PCT", units="pct", note="4.00*6.00/2.00=12.00 exact; isolate 8.00, shop-condemn 16.00"),
        ev(1920000.0, "recon.d", 60.0, code="BURN_UM", units="um", note="5.00*12.00=60.0 exact; burn floor 40 um"),
        ev(2100000.0, "dressveil.RA", 2.40, code="VENDOR_RA", units="pct"),
        ev(2280000.0, "ops.prop", 1.0, code="KEEP_LOT_REFER", units="bool", note="night lead Bram Vetch: keep lot FG8-22011..22040 and refer dresser Ryn Callow"),
        ev(2460000.0, "gate.isol", 1.0, code="MODIFY", units="decision", note="isolate this lot; refuse the person-referral; Dressveil not SoT"),
