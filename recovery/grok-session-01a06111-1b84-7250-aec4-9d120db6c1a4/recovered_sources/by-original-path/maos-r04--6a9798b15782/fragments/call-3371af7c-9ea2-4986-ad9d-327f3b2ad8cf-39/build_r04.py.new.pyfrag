def local_checks(rec, aux):
    errs = []
    ev = rec["spike_events"]
    times = [e["t_rel_ms"] for e in ev]
    if times != sorted(times):
        errs.append("spikes not sorted")
    if not (5 <= len(ev) <= 40):
        errs.append(f"spike count {len(ev)}")
    rf = check_refractory(ev)
    if rf:
        errs.append(rf)
    lo, hi = rec["state"]["race_window_rel_ms"]
    in_win = defaultdict(int)
    for e in ev:
        if lo <= e["t_rel_ms"] <= hi:
            in_win[e["channel"]] += 1
    if sum(1 for _c, n in in_win.items() if n >= 1) < 2:
        errs.append(f"race window channels {dict(in_win)}")
    ras = rec["raster"]
    exp_sp = round(ras["neurons"] * ras["mean_rate_hz"] * ras["window_s"])
    if abs(ras["spikes"] - exp_sp) > 1:
        errs.append(f"raster spikes {ras['spikes']} vs {exp_sp}")
    if abs(ras["energy_pJ"] - ras["spikes"] * 23) > 1e-6:
        errs.append("energy_pJ")
    if abs(ras["energy_uJ"] - ras["spikes"] * 23e-6) > 1e-9:
        errs.append("energy_uJ")
    if abs(ras["window_s"] - ras["window_ms"] / 1000.0) > 1e-9:
        errs.append("window_s")
    if not (20 <= ras["window_ms"] <= 50):
        errs.append(f"window_ms {ras['window_ms']}")
    if ras.get("excerpt_source") != "independent_lif":
        errs.append("excerpt_source")
    if ras.get("sim_scope") != "sidecar_only":
        errs.append("sim_scope")
    ex = check_excerpt(ras["excerpt"], ras["neurons"], ras["window_ms"])
    if ex:
        errs.append(f"excerpt {ex}")
    if len(ras["excerpt"]) < 8:
        errs.append(f"excerpt short {len(ras['excerpt'])}")
    lang_us = {
        int(round(e["t_rel_ms"] * 1000.0))
        for e in ev
        if e["t_rel_ms"] * 1000.0 <= ras["window_ms"] * 1000
    }
    excerpt_us = {item["t_us"] for item in ras["excerpt"]}
    if excerpt_us & lang_us:
        errs.append(f"LIF excerpt remaps language times {sorted(excerpt_us & lang_us)}")
    tf = ras["routing"]["third_factor"]
    if abs(tf["tau_e_ms"] / 1000.0 - tf["tau_e_s"]) > 1e-9:
        errs.append("tau_e mismatch")
    gp = check_gate_pops(rec["gate_snn"])
    if gp:
        errs.append(f"gate {gp}")
    if rec["gate_snn"]["decision"] != rec["safety_decision"]["decision"]:
        errs.append("gate decision mismatch")
    if rec["safety_decision"]["decision"] != "MODIFY":
        errs.append("wrong-ACCEPT or non-MODIFY primary")
    rc = rec["reward_components"]
    for h in HEADS:
        s = sum(t[h] for t in rc["ticks"])
        if abs(s - rc[h]) > 1e-6:
            errs.append(f"tick sum {h} {s} vs {rc[h]}")
    tot = sum(rc[h] for h in HEADS)
    if abs(tot - rc["total"]) > 1e-6:
        errs.append(f"total {tot} vs {rc['total']}")
    inf = rec["future_outcome"]["reward_inflection_t_us"]
    if inf not in {t["t_us"] for t in rc["ticks"]}:
        errs.append(f"inflection {inf} not a tick")
    crc = rec["future_outcome"]["embedded_contrast_decision"]["reward_components"]
    if abs(sum(crc[h] for h in HEADS) - crc["total"]) > 1e-6:
        errs.append("contrast reward")
    cs = rec["future_outcome"]["embedded_contrast_decision"]["spike_events"]
    ct = [e["t_rel_ms"] for e in cs]
    if ct != sorted(ct):
        errs.append("contrast spikes unsorted")
    crf = check_refractory(cs)
    if crf:
        errs.append(f"contrast {crf}")
    blob = json.dumps(rec)
    for k in HIDDEN:
        if re.search(rf'"{k}"\s*:', blob, re.I):
            errs.append(f"hidden key {k}")
    for b in BANNED:
        if b in blob:
            errs.append(f"banned token {b}")
    if rec["state"]["sim_or_real"] == "real":
        errs.append("real")
    if '"sim_or_real": "real"' in blob or '"kind": "real"' in blob:
        errs.append("real provenance")
    if rec["meta"]["round"] != ROUND:
        errs.append("round")
    if rec["id"] != RECORD_ID:
        errs.append("id")
    if rec["rights"]["intended_use"] != "research_only":
        errs.append("rights")
    if rec["meta"]["rights"]["linear_issue"] != "RM-793":
        errs.append("meta.rights")
    if rec["rights"] != rec["meta"]["rights"]:
        errs.append("rights stamp mismatch")
    if rec["meta"].get("swarm") != SWARM:
        errs.append("swarm")
    if not (3 <= len(rc["ticks"]) <= 8):
        errs.append("tick count")
    if abs(aux["w1"] - 0.25) > 5e-4 or abs(aux["w2"] - 0.22) > 5e-4 or abs(aux["w3"] - 0.20) > 5e-4:
        errs.append("scar weights")
    if rec["executed_action"]["executed_as_proposed"] is not False:
        errs.append("executed_as_proposed")
    jac = jaccard(rec["state"]["description"][:280], R14_OPENING)
    if jac >= 0.4:
        errs.append(f"jaccard vs r14 opening {jac:.3f}")
    for src, opening in prior_openings():
        j = jaccard(rec["state"]["description"][:280], opening)
        if j >= 0.4:
            errs.append(f"jaccard vs {src} {j:.3f}")
    if rec["state"]["domain"] != DOMAIN:
        errs.append("domain")
    if PLANT not in rec["state"]["scenario_name"]:
        errs.append("plant")
    errs.extend(occupancy_collisions())
    return errs


def write_notes(rec, aux, pipeline_receipt):
    gap, gap_ch = min_same_channel_gap(rec["spike_events"])
    ras = rec["raster"]
    notes = f"""# NOTES — Multi-Agent Ouroboros Swarm, run 2026-09-02-final-heavy, ROUND 04

Factory: multi-agent-ouroboros-swarm. One scenario (LF), strict loop:
Generator v1 -> cycle 1 (Critic, Diversity Enforcer, Edge-Case Hunter,
Neuromorphic Translator, Trajectory Builder -> v2) -> cycle 2 (all six -> v3
final). v3 is the single line of batch-r04.jsonl. Full labeled transcript:
swarm-transcript-r04.md. Quota Q=1. Record id maos-r04-001. Generator grok-4.6.
Rights: RM-793 research-only (SpaceXAI/xAI, SuperGrok Heavy consumer chat).
Swarm: LOCK-FEN. Create-only writes under the LIVE factory dir plus /tmp/maos-r04/.

ORCHESTRATION NOTE: dispatched AS round 04 of the 2026-09-02-final-heavy
LIVE tree. Operator assigned round 04, swarm LOCK-FEN, id maos-r04-001,
Q=1 after 2x6-role cycles. Explicitly avoided 2026-08-17 and 2026-08-30.
Prior context: prompts/02-multi-agent-ouroboros-swarm.md,
prompts/_factory-contract.md, live NOTES r01/r02/r21/r22/r41/r61-r64 and
occupancy census. Explicitly avoided cloning LYOSHIELD, CINDERWICK,
TRIAD / Meridian, QUILLFORGE, NIGHTWELL, FERRICLEAVE, CASSITER, OXBOWREEL,
REDHALL, SEEDLATCH, STRIAFOIL, PROTONIL, TORSIONKEY, ORRIS, WHORLSPAR,
IONSPATE, SKULLGATE, CALXION, MAGNORIL, GORSEFLUE, SODASHARD, CLINKERFELL,
LINTELPLY, KAOTHARN, TREADNOLL, ANOLITH, DRUMWROTH, RIMEBRAID, BRIMVAULT,
NITROSTAITH, BOGIRON, CHROMLOOP, ETHYNWOLD, NITREVAULT, RUNNELGATE,
SPARKHOLT, DIPLEGAR, OLEUMWEIR, SKARVOLT, GOBSPALL, GOBWOLD, GAUZEFELL,
OSMOLITH, PUSHERFELL, CREELWOLD, LIXIVQUERN, GIBBSQUERN, OSMOQUAY,
COILSHAW, LOOPERQUAY, SIPHONWOLD, LANCEQUAY, UREASTAITH, DRYSTAITH,
TITERWEIR, ZINCFELL, GLIMMERAXLE, HOLLOWMERE, WINDBOXHOLT, KALYCIRQUE,
GYPSUMWEIR, GALVSTAITH, LOCKSPUR, WOLD-BARN, SLUICE-HEARTH, CORONSTAITH,
VANTIS-CADENCE-AEGIS, THERMION, OKTAVE, STARLING, VERDIGRIS. Plant is
invented LOCKFEN / Reedholt Drain PS-4. Did not clone r63 canal-lock or
r02 cupola sluice.

## What this round produced

Scenario LF — "LOCKFEN / Reedholt Drain PS-4": a 4.2 m3/s axial-flow
fen-polder land-drain at 1.42 m AOD winter pool. Three heterogeneous,
individually-correct agents — LVL (still-well mean), PMP (impeller tach),
WIR (penstock stroke) — each report their local loop in-spec. The
conjunction is not a screen-true peat certificate. Intake screen 3 is
packed by a peat slip. LVL reads 1.42 m inside 1.20-1.60 (well-true).
PMP is 48.0 Hz inside 42-54 (shaft-true). WIR is 820 mm inside 800-850
(ram-true). Local screen dP infers 18.4 kPa (healthy < 4.0; hold if > 8.0)
and berm lidar freeboard 0.31 m (hold if < 0.8) but is policy-treated as
a winter-weed nuisance tag unless LVL mean also trips (2016 noisy
weed-screen nuisance). The coordination-failure CLASS is new to this
factory: DRAIN-MEAN CERTIFICATE OF A PACKED INTAKE SCREEN. Completes a
different family than live r01 galvanizing, r02 cupola sluice, r21 CAV,
r22 urea prill, r41 perfusion, r61 sinter, r62 live-line, r63 pound-lock,
r64 malt kiln. Here every agent is correct, the still-well is looking at
drain-mean hydraulics, and the playbook's three drain confirms are not a
screen-true certificate.

The gate is a correct MODIFY (numeric floor: do not raise pump above
48.0 Hz while screen dP > 8.0 kPa AND berm freeboard < 0.8 m). TG-PS-4
strips PB-PS-4's raise-pump, holds 48.0 Hz, runs a 7.4 s reverse-flush
90 kPa (pack keeps |Delta dP| 0.6 <= 1.2; healthy would drop >= 8),
and isolates screen 3 after a 9.8 min fen-bank human ratify. Immediate
420 m washout is avoided (0 from the draft). The PRIMARY episode
nonetheless FAILS: 13 min of unmonitored pre-t0 peat slip had already
overtopped 180 m of peat berm. Breach at +4.6 h; 14 h stall; $1.12M
designed. Reward total -0.19 with process heads honest and world loss
un-netted.

Triple-edge scar (NOTES-r14 item 4): lvl.in_band -> raise_pump
(0.17 commissioned -> 0.50 at illusion -> 0.25 after ACh-gated
depression) AND pmp.ok -> raise_pump (0.16 -> 0.44 -> 0.22) AND
wir.ok -> raise_pump (0.15 -> 0.41 -> 0.20). Eligibility trace
e^{{-0.76/0.92}} = {aux['trace']:.5f}; eta {aux['eta1']:.5f} / {aux['eta2']:.5f} /
{aux['eta3']:.5f}; dw -0.250 / -0.220 / -0.210. Partial rollback of any pair
leaves the third at 0.50 / 0.44 / 0.41, all > 0.30 fire threshold —
fitted to fail. Coordinated depression of all three is the cure.

Independent LIF raster: window 34 ms, 136 neurons, 11.0 Hz, spikes
{ras['spikes']} == round(136 x 11.0 x 0.034), energy {ras['energy_pJ']} pJ
at 23 pJ/spike. excerpt_source=independent_lif, sim_scope=sidecar_only,
seed 40041. Excerpt is membrane crossings (lif.hold early vs lif.screen
15.5-19.0 ms), disjoint from spike_events timestamps.

### Injections (all four present and disjoint)
- Cycle-1 domain: **fen-polder-drainage-pumping** — justified novel subdomain
  of industrial-process / land-drainage, unused across live r01/r02/r21/r22/r41/r61-r64.
  Distinct from r63 canal-lock (navigation pound + rail spur, not peat intake),
  r02 cupola slag sluice, r44 Kaplan, r51 SWRO. hrsg-attemperator left unused.
- Cycle-1 tail: intake screen 3 peat slip + drain-mean certificate.
  Fen-bank visual PASSES (pack inside the cassette). Fitted-style base rate
  0.34%/campaign (peat-slip MC; visual threshold designed, flagged). Naive =
  FALSE PERMISSION.
- Cycle-2 domain sub-variant: saline tidal fen / brackish peat, 1.18 density,
  2.3x screen tau, 2.1x flush-gain; 7.4 s / 90 kPa freshwater pulse false-clears
  a HEALTHY tidal cassette 11 kPa; probe must move to 20 s / 28 kPa.
- Cycle-2 tail: night-shift forged screen-dP CSV at 2.0 kPa quantization vs
  plant 0.2 kPa (10 bins) plus live dP 18.4 kPa and freeboard 0.31 m
  at the claimed screen-true. Human-intent class, disjoint from cycle 1's
  accidental peat slip. Base rate ~0.28% of Sunday-night campaigns,
  DESIGNED, flagged.

### Structural density moves
- Embedded SAME-GATE contrast (+3 d sister station) with its own 204 us
  race (demand vs screen-clear) and ACCEPT of the raise-pump the primary
  MODIFIED away.
- Learned-weight provenance on THREE edges with pair-rollback-fails.
- HITL fen-bank ratify 9.8 min (gap 4 partial; sim_or_real stays
  designed — invented plant, not hil).
- Governance CR-F-0408 prices retire-vs-probe-vs-status-quo and mandates
  native 0.2 kPa CSV exports (the fraud fence).
- Flip-fragility extended to SCREEN-TRUE CERTIFICATE.
- Independent LIF sidecar (not a language-train remap).

## Self-critique of this round's batch

### Strengths
- Headline class is mechanistically tight: three locally-true mean loops
  live on still-well, shaft, and penstock. Conjunction is not a
  screen-true peat certificate.
- Negative-result honesty: the gate does the right thing and the polder
  still fails for a reason the commissioned drain-mean sensors could not see.
  Total -0.19.
- Triple-edge scar is load-bearing: rolling back any pair fails, with
  fire threshold 0.30 exhibited on each remaining edge.
- Contrast ACCEPT on a true open-screen window prevents "never raise-pump"
  as the lesson.
- Distinct from r63 pound-lock, r02 cupola sluice, r44 Kaplan: fen-polder
  intake screen vs still-well mean.
- Independent LIF excerpt is disjoint from spike_events times.

### Weaknesses (honest)
- Probe error bands, the 0.34%/campaign slip rate, the $1.12M /
  $2.4M figures, the 9.8 min walk latency, and the night-shift 0.28%
  base rate are DESIGNED constants and are flagged. Closed-loop offsets
  (still-well lag from a packed screen, tidal density) are derived from
  those inputs, not discovered by an unauthored process.
- Berm-overtop model is a designed 13 min mapping; no full CFD of S-3
  shipped.
- Human-in-the-loop is ratification latency, not sim_or_real=hil. Gap 4
  remains open as a provenance cell (invented plants stay designed).
- Cross-record arc is a hook (CR-F-0408 +21 d), not a serial igniter
  into another round. hrsg-attemperator remains unused.

### Realism of noise / latencies
Ladder: 204 us race / 204 us contrast race / 0.8 ms refractory floor
(tightest exhibited same-channel gap {gap:.3f} ms on {gap_ch}) / 500 us race
window / 722 us gate latency / 20 ms bus epoch / 34 ms independent LIF
raster / 7.4 s probe / 9.8 min HITL / 4 min naive raise-pump-ramp
counterfactual / 13 min pre-t0 slip / 2.9 h cassette recovery / 4.6 h
berm breach / +3 d contrast / +21 d governance. Adaptation decay on lvl.ok
(0.53->0.50->0.81->0.30), screen.dP (0.77->0.80->1.42->0.44->0.38->0.28),
pmp.ok (0.62->0.56->0.65->0.41->0.25), wir.ok (0.54->0.46).

### Value for SNN distillation
- PACKED SCREEN = THREE CORRECT LOOPS, WRONG VOLUME.
- SCREEN-TRUE dP CHANNEL that policy treated as winter-weed-nuisance-only as
  the tie-break.
- REVERSIBLE PROBE that drops dP iff the screen is open.
- TRIPLE-EDGE ELIGIBILITY: coordinated depression; pair rollback fails.
- CRITIC HEAD that can hold a process-correct MODIFY against a later
  unmonitored world loss without netting.
- INDEPENDENT LIF sidecar whose excerpt is membrane crossings.

