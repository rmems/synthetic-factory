def rec_190():
    hcv = 48.00
    sqrt_sg = 0.80
    sg = 0.64
    w_mj = hcv / sqrt_sg
    _exact(w_mj, 60.00)
    _exact(w_mj * sqrt_sg, 48.00)
    _exact(32.00 / sqrt_sg, 40.00)
    _exact(40.00 / sqrt_sg, 50.00)
    _exact(48.00 / sqrt_sg, 60.00)
    _exact(40.00 / sqrt_sg, 50.00)
    _exact(6000.0 + 1080.0, 7080.0)

