# ---------------------------------------------------------------------------
# Record 191 — critical-angle refractometer remaining Brix of a sugar-evaporator body, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_191():
    k_n = 0.40
    dn_mriu = 50.00
    bx = k_n * dn_mriu
    _exact(bx, 20.00)
    _exact(k_n * 20.00, 8.00)
    _exact(k_n * 40.00, 16.00)
    _exact(k_n * 50.00, 20.00)
    _exact(k_n * 40.00, 16.00)
    solids = 0.90 * bx
    _exact(solids, 18.00)
    _exact(dn_mriu / k_n if False else 50.00, 50.00)
    _exact(bx / k_n, 50.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202609191,
        source="qm4.abbe.dn",
        target="quillmere.body_isolate_core",
        table=[
            {"from": "abbe_dn", "to": "brix_estimator", "weight": 1.35},
            {"from": "abbe_snr", "to": "prism_norm_core", "weight": 1.20},
            {"from": "brixveil_bx", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.prism_referral_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": "pre-post coincidence on keep-boiling synapses; the refractometer modulator depresses keep-boiling and referral links when milli-RIU stays high inside tau_e of an SNR lock so a Brixveil last-good cannot hide a 20.00 °Bx body or name Sable Quinn",
        },
        channel_prefix="abbe.n",
        anchor="QM-4 HIL coupon 32 ms frame at Δn 50.00 mRIU / SNR 14.0 (t_s 1560) reconstructing 20.00 °Bx above the 16.00 isolate floor",
    )
    w_s = 0.032
    events = [
