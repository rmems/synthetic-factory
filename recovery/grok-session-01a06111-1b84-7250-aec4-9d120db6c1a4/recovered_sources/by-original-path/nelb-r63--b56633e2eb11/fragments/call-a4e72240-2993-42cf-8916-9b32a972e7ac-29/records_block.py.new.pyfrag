def occupancy_preflight():
    banned = (
        "wobbe remaining",
        "wobbe index",
        "calorveil",
        "thornfell",
        "lichenmere",
        "keir noll",
        "critical-angle refractometer",
        "refractometer remaining brix",
        "brixveil",
        "quillmere",
        "rowanfen",
        "sable quinn",
        "lise bram",
        "abbe-hil-5",
        "amperometric remaining free-chlorine",
        "free-chlorine",
        "chlorveil",
        "pewterholt",
        "cinderwharf",
        "mael dorr",
        "cl2-sim-3",
        "nelb-r63-190",
        "nelb-r63-191",
        "nelb-r63-192",
    )
    hits = []
    root = Path("/tmp")
    for n in (
        sorted(root.glob("nelb-r*/NOTES-r*.md"))
        + sorted(root.glob("nelb-r*/gen_r*.py"))
        + sorted(root.glob("nelb-r*/records_block.py"))
        + sorted(root.glob("nelb-r*/*recs*.py"))
    ):
        if "nelb-r63" in str(n):
            continue
        text = n.read_text(encoding="utf-8", errors="replace").casefold()
        for b in banned:
            if b in text:
                hits.append(f"{n}:{b}")
    if hits:
        raise RuntimeError(f"family/plant collision {hits}")


