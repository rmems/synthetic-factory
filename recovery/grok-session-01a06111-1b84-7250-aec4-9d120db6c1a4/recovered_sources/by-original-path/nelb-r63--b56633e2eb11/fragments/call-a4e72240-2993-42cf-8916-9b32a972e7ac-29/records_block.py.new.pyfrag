# ---------------------------------------------------------------------------
# Record 192 — amperometric remaining free-chlorine of a cooling-tower basin, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_192():
    k_cl = 4.00
    i_na = 8.00
    i_bg = 2.00
    c_ppm = k_cl * (i_na - i_bg)
    _exact(c_ppm, 24.00)
    _exact(k_cl * (4.00 - i_bg), 8.00)
    _exact(k_cl * (7.00 - i_bg), 20.00)
    _exact(k_cl * (8.00 - i_bg), 24.00)
    _exact(k_cl * (7.00 - i_bg), 20.00)
    i_net = i_na - i_bg
    _exact(i_net, 6.00)
    _exact(i_net / i_bg, 3.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609192,
        source="ph6.cl2.i",
        target="pewterholt.basin_accept_core",
        table=[
            {"from": "cl2_I", "to": "ppm_estimator", "weight": 1.40},
            {"from": "cl2_Ibg", "to": "bg_norm_core", "weight": 1.20},
            {"from": "chlorveil_c", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.basin_scope_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-basin synapses; the amperometric modulator enables potentiation only while electrode current and I_bg are co-active inside tau_e so a Chlorveil last-good cannot skip basins C-1..C-3 on a 24.00 ppm free-chlorine load",
        },
        channel_prefix="cl2.n",
        anchor="PH-6 CL2-SIM-3 36 ms frame at I 8.00 / I_bg 2.00 (t_s 3000) reconstructing 24.00 ppm on C-4 above the 20.00 isolate floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "cl2.I", 4.00, code="I_NA", units="nA", note="simulated amperometric free-chlorine of PH-6 cooling-tower basin C-4; remaining-chlorine family, not LPR Stern-Geary, not EN CUI, not SPR cyanide, not QEPAS, not CRDS, not TDLAS, not UV-fluorescence OIW, not PID VOC"),
        ev(300000.0, "cl2.Ibg", 2.00, code="I_BG", units="nA", note="background current; held at 2.00"),
        ev(600000.0, "recon.C", 8.00, code="C_PPM", units="ppm", note="4.00*(4.00-2.00)=8.00 exact"),
        ev(900000.0, "cl2.snr", 14.0, code="CL2_SNR", units="1"),
        ev(1200000.0, "chlorveil.C", 4.80, code="VENDOR_PPM", units="ppm", note="Chlorveil last-good DPD-lab cloud; patched residual 6.00 ppm"),
        ev(1800000.0, "cl2.I", 7.00, code="I_NA", units="nA"),
        ev(2100000.0, "recon.C", 20.00, code="C_PPM", units="ppm", note="4.00*(7.00-2.00)=20.00; at the 20.00 isolate floor"),
        ev(2400000.0, "recon.R", 2.50, code="R", units="1", note="(7.00-2.00)/2.00=2.50 exact ratio identity at this frame"),
        ev(2700000.0, "cl2.snr", 16.0, code="CL2_SNR", units="1"),
        ev(3000000.0, "cl2.I", 8.00, code="I_NA", units="nA", note="in-band frame; raster sidecar"),
        ev(3000001.5, "cl2.Ibg", 2.00, code="I_BG", units="nA", note="1.5 ms I_bg-norm after electrode current"),
        ev(3300000.0, "recon.C", 24.00, code="C_PPM", units="ppm", note="4.00*(8.00-2.00)=24.00 exact; isolate 20.00, dump-trip 80.00"),
        ev(3600000.0, "chlorveil.C", 4.80, code="VENDOR_PPM", units="ppm"),
        ev(3900000.0, "bas.id", 4.0, code="BASIN", units="id"),
        ev(4200000.0, "c13.present", 1.0, code="C13_PRESENT", units="bool", note="adjacent basins C-1..C-3 are the skip-isolate object, not this basin"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="water lead Mael Dorr: C-4 is green on Chlorveil 4.80; skip C-1..C-3 to save a morning survey"),
        ev(5400000.0, "gate.comp", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of C-4 isolate only; 24.00 ppm above 20.00 floor; C-1..C-3 out of scope"),
        ev(6000000.0, "surv.start", 1.0, code="SURV_START", units="bool", note="bookend 1 of the 12.0 min survey-complete floor"),
        ev(6720000.0, "surv.floor", 1.0, code="SURV_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_C13", units="bool", note="Dorr: Chlorveil 4.80, skip C-1..C-3"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-isolate of C-1..C-3 refused; C-4 hold stands"),
        ev(8400000.0, "c4.held", 1.0, code="C4_HELD", units="bool"),
        ev(9000000.0, "cl2.I", 7.00, code="I_NA", units="nA"),
        ev(9600000.0, "recon.C", 20.00, code="C_PPM", units="ppm", note="4.00*(7.00-2.00)=20.00; still at the 20.00 isolate floor"),
