        "cation conductivity",
        "catveil",
        "siltwharf",
        "kelpholt",
        "mael dorr",
        "cat-sim-3",
        "nelb-r63-190",
        "nelb-r63-191",
        "nelb-r63-192",
    )
    hits = []
    root = Path("/tmp")
    for n in (
        sorted(root.glob("nelb-r*/NOTES-r*.md"))
        + sorted(root.glob("nelb-r*/gen_r*.py"))
        + sorted(root.glob("nelb-r*/records_block.py"))
        + sorted(root.glob("nelb-r*/*recs*.py"))
        + sorted(root.glob("nelb-r*/batch-r*.jsonl"))
    ):
        if "nelb-r63" in str(n):
            continue
        text = n.read_text(encoding="utf-8", errors="replace")
        # other rounds' occupancy tuples cite in-flight r63 names; strip those
        text = re.sub(
            r"def occupancy_preflight\(\):.*?if hits:",
            " ",
            text,
            flags=re.S,
        )
        text = text.casefold()
        for b in banned:
            if b in text:
                hits.append(f"{n}:{b}")