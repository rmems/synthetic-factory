def step(n, basis, tool, args, observation, reflection, plan=None):
    obj = {
        "n": n,
        "decision_basis": basis,
        "tool_call": {"name": tool, "args": args},
        "observation": observation,
        "reflection": reflection,
    }
    if plan is not None:
        obj = {
            "n": n,
            "decision_basis": basis,
            "plan": plan,
            "tool_call": {"name": tool, "args": args},
            "observation": observation,
            "reflection": reflection,
        }
    return obj


