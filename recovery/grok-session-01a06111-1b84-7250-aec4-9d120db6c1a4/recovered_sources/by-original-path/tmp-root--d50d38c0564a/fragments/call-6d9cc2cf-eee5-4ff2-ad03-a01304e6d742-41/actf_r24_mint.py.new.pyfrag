def hidden_keys(value, path=""):
    found = []
    if isinstance(value, dict):
        for key, item in value.items():
            child = f"{path}.{key}" if path else key
            norm = re.sub(r"[^a-z0-9]+", "_", str(key).casefold()).strip("_")
            if norm in HIDDEN or key in HIDDEN:
                found.append(child)
            found.extend(hidden_keys(item, child))
    elif isinstance(value, list):
        for i, item in enumerate(value):
            found.extend(hidden_keys(item, f"{path}[{i}]"))
    return found


def validate(rec, label):
    errors = []
    steps = rec["steps"]
    if not 12 <= len(steps) <= 17:
        errors.append(f"{label}: step count {len(steps)}")
    for i, s in enumerate(steps, 1):
        if s["n"] != i:
            errors.append(f"{label}: step n {s['n']} != {i}")
        basis = s["decision_basis"]
        if not any(basis.startswith(p) for p in BASIS_LABELS):
            errors.append(f"{label} step {i}: basis prefix")
        if not 80 <= len(basis) <= 240:
            errors.append(f"{label} step {i}: basis len {len(basis)}")
        tool = s["tool_call"]["name"]
        if tool not in KNOWN_TOOLS:
            errors.append(f"{label} step {i}: unknown tool {tool}")
        if "hypothesis" in s["observation"].casefold():
            errors.append(f"{label} step {i}: hypothesis in observation")
    blob = json.dumps(rec)
    if hidden_keys(rec):
        errors.append(f"{label}: hidden keys {hidden_keys(rec)}")
    obs = [s["observation"] for s in steps]
    n429 = sum("429" in o for o in obs)
    n502 = sum("502" in o for o in obs)
    if n429 != 1 or n502 != 1:
        errors.append(f"{label}: noise counts 429={n429} 502={n502}")
    idx429 = next(i for i, o in enumerate(obs) if "429" in o)
    idx502 = next(i for i, o in enumerate(obs) if "502" in o)
    recov429 = steps[idx429 + 1]
    recov502 = steps[idx502 + 1]
    if "429" not in recov429["decision_basis"]:
        errors.append(f"{label}: 429 recovery basis")
    if "502" not in recov502["decision_basis"]:
        errors.append(f"{label}: 502 recovery basis")
    if "429" in recov429["observation"] or "502" in recov429["observation"]:
        errors.append(f"{label}: 429 recovery obs repeats status")
    if "429" in recov502["observation"] or "502" in recov502["observation"]:
        errors.append(f"{label}: 502 recovery obs repeats status")
    pc = rec["meta"]["plan_change_step"]
    if pc in (1, len(steps)):
        errors.append(f"{label}: plan change at end/start")
    if "Plan change:" not in steps[pc - 1]["reflection"]:
        errors.append(f"{label}: missing Plan change: reflection")
    turns = " ".join(s["reflection"].casefold() for s in steps)
    missing = [p for p in PROGRESS if p not in turns]
    if missing:
        errors.append(f"{label}: missing progress {missing}")
    if rec["meta"]["round"] != 24:
        errors.append(f"{label}: round")
    if rec["meta"]["factory"] != "agentic-coding-trajectory-factory":
        errors.append(f"{label}: factory")
    if rec["meta"]["sim_or_real"] != "designed":
        errors.append(f"{label}: sim_or_real")
    numeric = [
        v
        for k, v in rec["reward"].items()
        if k not in {"success", "aggregation", "cost"} and isinstance(v, (int, float))
    ]
    total = rec["reward"]["total"]
    if abs(sum(x for x in numeric if x != total) - total) > 1e-9:
        errors.append(f"{label}: reward total {total} vs {numeric}")
    if "thought" in blob.casefold() and '"thought"' in blob.casefold():
        errors.append(f"{label}: thought substring in keys?")
    return errors


def pick_paths():
    for tree in FORBIDDEN_TREES:
        if tree in str(DIR):
            raise SystemExit(f"refusing forbidden tree {tree}")
    candidates = [
        ("batch-r24.jsonl", "NOTES-r24.md"),
        ("batch-r24c.jsonl", "NOTES-r24c.md"),
        ("batch-r24cc.jsonl", "NOTES-r24cc.md"),
    ]
    for batch_name, notes_name in candidates:
        batch_path, notes_path = DIR / batch_name, DIR / notes_name
        if not batch_path.exists() and not notes_path.exists():
            return batch_path, notes_path
    raise SystemExit("all r24 name slots exist; refusing overwrite")


def write_excl(path: Path, data: str):
    fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(data)


def main():
    DIR.mkdir(parents=True, exist_ok=True)
    errors = validate(EP1, "ep1") + validate(EP2, "ep2")
    if errors:
        print("VALIDATION FAILED", file=sys.stderr)
        for e in errors:
            print(e, file=sys.stderr)
        sys.exit(1)
    if "Novel coverage: 46%" not in NOTES:
        raise SystemExit("notes missing Novel coverage line")
    lines = [
        json.dumps(EP1, ensure_ascii=False, separators=(",", ":")),
        json.dumps(EP2, ensure_ascii=False, separators=(",", ":")),
    ]
    batch_path, notes_path = pick_paths()
    write_excl(batch_path, "\n".join(lines) + "\n")
    write_excl(notes_path, NOTES if NOTES.endswith("\n") else NOTES + "\n")
    print(batch_path)
    print(notes_path)
    print(f"ep1_steps={len(EP1['steps'])} ep2_steps={len(EP2['steps'])}")
    for rec in (EP1, EP2):
        print(
            rec["id"],
            "tools",
            [s["tool_call"]["name"] for s in rec["steps"]],
            "basis",
            [len(s["decision_basis"]) for s in rec["steps"]],
        )


if __name__ == "__main__":
    main()
