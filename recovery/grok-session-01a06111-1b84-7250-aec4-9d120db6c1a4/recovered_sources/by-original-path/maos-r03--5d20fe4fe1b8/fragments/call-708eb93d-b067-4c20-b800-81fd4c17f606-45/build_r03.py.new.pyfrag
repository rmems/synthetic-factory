def local_checks(rec, aux):
    errs = []
    ev = rec["spike_events"]
    times = [e["t_rel_ms"] for e in ev]
    if times != sorted(times):
        errs.append("spikes not sorted")
    if not (5 <= len(ev) <= 40):
        errs.append(f"spike count {len(ev)}")
    rf = check_refractory(ev)
    if rf:
        errs.append(rf)
    lo, hi = rec["state"]["race_window_rel_ms"]
    in_win = defaultdict(int)
    for e in ev:
        if lo <= e["t_rel_ms"] <= hi:
            in_win[e["channel"]] += 1
    if sum(1 for _c, n in in_win.items() if n >= 1) < 2:
        errs.append(f"race window channels {dict(in_win)}")
    ras = rec["raster"]
    exp_sp = round(ras["neurons"] * ras["mean_rate_hz"] * ras["window_s"])
    if abs(ras["spikes"] - exp_sp) > 1:
        errs.append(f"raster spikes {ras['spikes']} vs {exp_sp}")
    if abs(ras["energy_pJ"] - ras["spikes"] * 23) > 1e-6:
        errs.append("energy_pJ")
    if abs(ras["energy_uJ"] - ras["spikes"] * 23e-6) > 1e-9:
        errs.append("energy_uJ")
    if abs(ras["window_s"] - ras["window_ms"] / 1000.0) > 1e-9:
        errs.append("window_s")
    if not (20 <= ras["window_ms"] <= 50):
        errs.append(f"window_ms {ras['window_ms']}")
    if ras.get("excerpt_source") != "independent_lif":
        errs.append("excerpt_source")
    if ras.get("sim_scope") != "sidecar_only":
        errs.append("sim_scope")
    ex = check_excerpt(ras["excerpt"], ras["neurons"], ras["window_ms"])
    if ex:
        errs.append(f"excerpt {ex}")
    lang_us = {
        int(round(e["t_rel_ms"] * 1000.0))
        for e in ev
        if e["t_rel_ms"] * 1000.0 <= ras["window_ms"] * 1000
    }
    excerpt_us = {item["t_us"] for item in ras["excerpt"]}
    if excerpt_us & lang_us:
        errs.append(f"LIF excerpt remaps language times {sorted(excerpt_us & lang_us)}")
    tf = ras["routing"]["third_factor"]
    if abs(tf["tau_e_ms"] / 1000.0 - tf["tau_e_s"]) > 1e-9:
        errs.append("tau_e mismatch")
    gp = check_gate_pops(rec["gate_snn"])
    if gp:
        errs.append(f"gate {gp}")
    if rec["gate_snn"]["decision"] != rec["safety_decision"]["decision"]:
        errs.append("gate decision mismatch")
    if rec["safety_decision"]["decision"] != "MODIFY":
        errs.append("wrong-ACCEPT or non-MODIFY primary")
    rc = rec["reward_components"]
    for h in HEADS:
        s = sum(t[h] for t in rc["ticks"])
        if abs(s - rc[h]) > 1e-6:
            errs.append(f"tick sum {h} {s} vs {rc[h]}")
    tot = sum(rc[h] for h in HEADS)
    if abs(tot - rc["total"]) > 1e-6:
        errs.append(f"total {tot} vs {rc['total']}")
    inf = rec["future_outcome"]["reward_inflection_t_us"]
    if inf not in {t["t_us"] for t in rc["ticks"]}:
        errs.append(f"inflection {inf} not a tick")
    crc = rec["future_outcome"]["embedded_contrast_decision"]["reward_components"]
    if abs(sum(crc[h] for h in HEADS) - crc["total"]) > 1e-6:
        errs.append("contrast reward")
    cs = rec["future_outcome"]["embedded_contrast_decision"]["spike_events"]
    ct = [e["t_rel_ms"] for e in cs]
    if ct != sorted(ct):
        errs.append("contrast spikes unsorted")
    crf = check_refractory(cs)
    if crf:
        errs.append(f"contrast {crf}")
    blob = json.dumps(rec)
    for k in HIDDEN:
        if re.search(rf'"{k}"\s*:', blob, re.I):
            errs.append(f"hidden key {k}")
    for b in BANNED:
        if b in blob:
            errs.append(f"banned token {b}")
    if rec["state"]["sim_or_real"] == "real":
        errs.append("real")
    if '"sim_or_real": "real"' in blob or '"kind": "real"' in blob:
        errs.append("real provenance")
    if rec["meta"]["round"] != ROUND:
        errs.append("round")
    if rec["id"] != RECORD_ID:
        errs.append("id")
    if rec["rights"]["intended_use"] != "research_only":
        errs.append("rights")
    if rec["meta"]["rights"]["linear_issue"] != "RM-793":
        errs.append("meta.rights")
    if rec["rights"] != rec["meta"]["rights"]:
        errs.append("rights stamp mismatch")
    if not (3 <= len(rc["ticks"]) <= 8):
        errs.append("tick count")
    if abs(aux["w1"] - 0.26) > 5e-4 or abs(aux["w2"] - 0.23) > 5e-4 or abs(aux["w3"] - 0.21) > 5e-4:
        errs.append("scar weights")
    if rec["executed_action"]["executed_as_proposed"] is not False:
        errs.append("executed_as_proposed")
    jac = jaccard(rec["state"]["description"][:280], R14_OPENING)
    if jac >= 0.4:
        errs.append(f"jaccard vs r14 opening {jac:.3f}")
    for src, opening in prior_openings():
        j = jaccard(rec["state"]["description"][:280], opening)
        if j >= 0.4:
            errs.append(f"jaccard vs {src} {j:.3f}")
    if rec["state"]["domain"] != DOMAIN:
        errs.append("domain")
    if PLANT not in rec["state"]["scenario_name"]:
        errs.append("plant")
    if rec["meta"].get("swarm") != PLANT:
        errs.append("swarm")
    errs.extend(occupancy_collisions())
    return errs


def write_notes(rec, aux, pipeline_receipt):
    gap, gap_ch = min_same_channel_gap(rec["spike_events"])
    ras = rec["raster"]
    notes = f"""# NOTES — Multi-Agent Ouroboros Swarm, run 2026-09-02-final-heavy, ROUND 03

Factory: multi-agent-ouroboros-swarm. One scenario (QF), strict loop:
Generator v1 -> cycle 1 (Critic, Diversity Enforcer, Edge-Case Hunter,
Neuromorphic Translator, Trajectory Builder -> v2) -> cycle 2 (all six -> v3
final). v3 is the single line of batch-r03.jsonl. Full labeled transcript:
swarm-transcript-r03.md. Quota Q=1. Record id maos-r03-001. Generator grok-4.6.
Rights: RM-793 research-only (SpaceXAI/xAI, SuperGrok Heavy consumer chat).
Create-only writes under the LIVE factory dir plus /tmp/maos-r03/.

ORCHESTRATION NOTE: dispatched AS round 03 of the 2026-09-02-final-heavy
LIVE tree. Operator assigned round 03, swarm QUAY-FEN, id maos-r03-001,
Q=1 after 2x6-role cycles. Explicitly avoided 2026-08-17 and 2026-08-30.
Prior context: prompts/02-multi-agent-ouroboros-swarm.md,
prompts/_factory-contract.md, live occupancy r01/r02/r21/r22/r41/r42/r61/r62/r63/r64.
Explicitly avoided cloning LYOSHIELD, CINDERWICK, TRIAD / Meridian,
QUILLFORGE, NIGHTWELL, FERRICLEAVE, CASSITER, OXBOWREEL, REDHALL,
SEEDLATCH, STRIAFOIL, PROTONIL, TORSIONKEY, ORRIS, WHORLSPAR, IONSPATE,
SKULLGATE, CALXION, MAGNORIL, GORSEFLUE, SODASHARD, CLINKERFELL,
LINTELPLY, KAOTHARN, TREADNOLL, ANOLITH, DRUMWROTH, RIMEBRAID, BRIMVAULT,
NITROSTAITH, BOGIRON, CHROMLOOP, ETHYNWOLD, NITREVAULT, RUNNELGATE,
SPARKHOLT, DIPLEGAR, OLEUMWEIR, SKARVOLT, GOBSPALL, GOBWOLD, GAUZEFELL,
OSMOLITH, PUSHERFELL, CREELWOLD, LIXIVQUERN, GIBBSQUERN, OSMOQUAY,
COILSHAW, LOOPERQUAY, SIPHONWOLD, LANCEQUAY, UREASTAITH, DRYSTAITH,
TITERWEIR, ZINCFELL, GLIMMERAXLE, HOLLOWMERE, WINDBOXHOLT, KALYCIRQUE,
GYPSUMWEIR, GALVSTAITH, SLUICE-HEARTH, PRILLGHYLL, SHEDWOLD, CORONSTAITH,
LOCKSPUR, WOLD-BARN, VANTIS-CADENCE-AEGIS, THERMION, OKTAVE, STARLING,
VERDIGRIS. Plant is invented QUAY-FEN / Sedgewharf Alkaline Stack QF-AY-3.
Leftover candidates mushroom-compost-tunnel / flue-cured-tobacco-barn /
farm-ad-biogas were left unused.

## What this round produced

Scenario QF — "QUAY-FEN / Sedgewharf Alkaline Stack QF-AY-3": a 120-cell
bipolar alkaline hydrogen-quay stack at 0.42 A/cm2 / 80.0 C / 30 wt% KOH /
8 bar. Three heterogeneous, individually-correct agents — CELL (120-cell
string-mean voltage), LYE (circulating-KOH conductivity), H2 (product
purity) — each report their local loop in-spec. The conjunction is not a
cell-true certificate. Cell 47 has a torn Zirfon separator. CELL reads
1.824 V/cell inside 1.70-1.95 (one hundred nineteen intact cells dominate
the string). LYE is 580 mS/cm inside 520-640 (loop-true). H2 is 99.94 vol%
inside 99.90-99.99 (mixed-true). Local IR infers 94.2 C (healthy < 82; hold
if > 86) and local dP 1.4 kPa (hold if < 3.2) but is policy-treated as a
busbar-nuisance tag unless CELL mean also trips (2016 noisy busbar
nuisance). The coordination-failure CLASS is new to this factory:
STRING-MEAN CERTIFICATE OF A LOCAL SEPARATOR TEAR. Completes a different
family than live r01 galvanizing, r02 cupola sluice, r21 CAV, r22 urea
prill, r41 perfusion, r42/r62 grid-inspection, r61 sinter, r63 canal-lock,
r64 malt kiln. Here every agent is correct, the CELL average is looking at
string-mean voltage, and the playbook's three CELL confirms are not a
cell-true certificate.

The gate is a correct MODIFY (numeric floor: do not raise current density
above 0.42 A/cm2 while cell-47 IR > 86 C AND cell-47 dP < 3.2 kPa).
TG-AY-3 strips PB-AY-3's raise-current, holds 0.42 A/cm2, runs a 7.4 s
current-density step -8% (tear keeps |Delta H2| 0.004 <= 0.006 vol%; intact
would move >= 0.030), and isolates cell 47 after a 9.6 min cell-gallery
human ratify. Immediate 1.8 Nm3 H2-in-O2 is avoided (0 from the draft).
The PRIMARY episode nonetheless FAILS: 11 min of unmonitored pre-t0 tear
had already mixed 0.42 Nm3 H2 into the O2 header. Knock-out at +4.6 h;
14.2 h stall; $2.14M designed. Reward total -0.16 with process heads
honest and world loss un-netted.

Triple-edge scar (NOTES-r14 item 4): cell.in_band -> raise_current
(0.18 commissioned -> 0.50 at illusion -> 0.26 after ACh-gated
depression) AND lye.ok -> raise_current (0.16 -> 0.44 -> 0.23) AND
h2.ok -> raise_current (0.15 -> 0.41 -> 0.21). Eligibility trace
e^{{-0.78/0.90}} = {aux['trace']:.5f}; eta {aux['eta1']:.5f} / {aux['eta2']:.5f} /
{aux['eta3']:.5f}; dw -0.240 / -0.210 / -0.200. Partial rollback of any pair
leaves the third at 0.50 / 0.44 / 0.41, all > 0.30 fire threshold —
fitted to fail. Coordinated depression of all three is the cure.

Independent LIF raster: window 38 ms, 152 neurons, 21.8 Hz, spikes
{ras['spikes']} == round(152 x 21.8 x 0.038), energy {ras['energy_pJ']} pJ
at 23 pJ/spike. excerpt_source=independent_lif, sim_scope=sidecar_only,
seed {aux['lif_seed']}. Excerpt is membrane crossings (lif.hold early vs
lif.cell 19-22.8 ms), disjoint from spike_events timestamps.

### Injections (all four present and disjoint)
- Cycle-1 domain: **alkaline-stack-hydrogen-quay** — justified novel
  subdomain of industrial-process / hydrogen production, unused across
  live r01/r02/r21/r22/r41/r42/r61/r62/r63/r64. Distinct from historical
  PEM electrolysis and chlor-alkali membrane cells. mushroom-compost-tunnel
  and farm-ad-biogas left unused.
- Cycle-1 tail: cell 47 torn Zirfon separator + H2-in-O2 certificate.
  Cell-gallery visual PASSES (tear inside the cassette). Fitted-style
  base rate 0.33%/campaign (separator-tear MC; visual threshold designed,
  flagged). Naive = FALSE PERMISSION.
- Cycle-2 domain sub-variant: high-pressure / 90 C / 35 wt% KOH, 0.45x
  bubble-residence, 2.6x current-step gain; 7.4 s / -8% spec-alkaline
  pulse overshoots live intact stack to a 0.08 vol% false H2 dip; probe
  must move to 18 s / -2.5%.
- Cycle-2 tail: night-shift forged local-IR CSV at 2.0 C quantization vs
  plant 0.2 C (10 bins) plus live IR 94.2 C and local dP 1.4 kPa at the
  claimed cell-true. Human-intent class, disjoint from cycle 1's
  accidental tear. Base rate ~0.28% of Sunday-night campaigns,
  DESIGNED, flagged.

### Structural density moves
- Embedded SAME-GATE contrast (+3 d sister stack) with its own 188 us
  race (demand vs cell-clear) and ACCEPT of the raise-current the primary
  MODIFIED away.
- Learned-weight provenance on THREE edges with pair-rollback-fails.
- HITL cell-gallery ratify 9.6 min (gap 4 partial; sim_or_real stays
  designed — invented plant, not hil).
- Governance CR-A-0306 prices retire-vs-probe-vs-status-quo and mandates
  native 0.2 C CSV exports (the fraud fence).
- Flip-fragility extended to CELL-TRUE CERTIFICATE.
- Independent LIF sidecar (not a language-train remap).

## Self-critique of this round's batch

### Strengths
- Headline class is mechanistically tight: three locally-true mean loops
  live on string mean, lye conductivity, and mixed H2. Conjunction is not
  a cell-true separator certificate.
- Negative-result honesty: the gate does the right thing and the stack
  still fails for a reason the commissioned sensors could not see.
  Total -0.16.
- Triple-edge scar is load-bearing: rolling back any pair fails, with
  fire threshold 0.30 exhibited on each remaining edge.
- Contrast ACCEPT on a true intact cell-duty window prevents "never
  raise-current" as the lesson.
- Distinct from r02 cupola sluice, r63 canal-lock, r01 GI knife, r64 malt
  kiln: alkaline hydrogen-quay local IR vs string mean.
- Independent LIF excerpt is disjoint from spike_events times.

### Weaknesses (honest)
- Probe error bands, the 0.33%/campaign tear rate, the $2.14M / $4.2M
  figures, the 9.6 min climb latency, and the night-shift 0.28% base
  rate are DESIGNED constants and are flagged. Closed-loop offsets
  (string dilution from one torn cell, high-P bubble-residence) are
  derived from those inputs, not discovered by an unauthored process.
- H2-in-O2 mix model is a designed 11 min mapping; no full CFD of C-47
  shipped.
- Human-in-the-loop is ratification latency, not sim_or_real=hil. Gap 4
  remains open as a provenance cell (invented plants stay designed).
- Cross-record arc is a hook (CR-A-0306 +21 d), not a serial igniter
  into another round. mushroom-compost-tunnel and farm-ad-biogas remain
  unused.
- The densifying-loop *shape* (three correct agents / MODIFY / probe /
  triple-edge / night-shift CSV / sister ACCEPT / negative primary)
  rhymes with r22/r61/r64. Physics, plant, sensors, and failure class
  are new; the scaffold is not.

### Realism of noise / latencies
Ladder: 192 us race / 188 us contrast race / 0.8 ms refractory floor
(tightest exhibited same-channel gap {gap:.3f} ms on {gap_ch}) / 500 us race
window / 728 us gate latency / 20 ms bus epoch / 38 ms independent LIF
raster / 7.4 s probe / 9.6 min HITL / 8 min naive raise-current-ramp
counterfactual / 11 min pre-t0 tear / 3.2 h separator recovery / 4.6 h
O2 knock-out / +3 d contrast / +21 d governance. Adaptation decay on
cell.hot (0.53->0.50->0.43->0.30), cell.dP (0.77->0.79->0.44->0.40->0.28),
lye.ok (0.62->0.58->0.46->0.25), h2.ok (0.56->0.65->0.81).

### Value for SNN distillation
- SEPARATOR TEAR = THREE CORRECT LOOPS, WRONG VOLUME.
- CELL-TRUE IR CHANNEL that policy treated as busbar-nuisance-only as
  the tie-break.
- REVERSIBLE PROBE that recouples H2 purity iff the separator is intact.
- TRIPLE-EDGE ELIGIBILITY: coordinated depression; pair rollback fails.
- CRITIC HEAD that can hold a process-correct MODIFY against a later
  unmonitored world loss without netting.
- INDEPENDENT LIF sidecar whose excerpt is membrane crossings.

