def build_record():
    ticks, heads = cents_ticks(
        [4428, 6428, 7144, 8_600_000, 624_000_000, 11_160_000_000, 18_360_000_000],
        [
            (1, -2, -1, 2, 1),
            (2, -4, -1, 3, 1),
            (2, -6, -2, 3, 2),
            (1, -7, -2, 2, 1),
            (1, -5, -2, 2, 1),
            (1, -6, -2, 1, 1),
            (0, -6, -2, 1, 2),
        ],
    )
    assert abs(heads["total"] - (-0.17)) < 1e-9, heads