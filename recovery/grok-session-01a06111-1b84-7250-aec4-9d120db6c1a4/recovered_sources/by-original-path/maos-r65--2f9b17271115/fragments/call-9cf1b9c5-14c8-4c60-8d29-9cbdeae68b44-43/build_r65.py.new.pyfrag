def build_record():
    ticks, heads = cents_ticks(
        [4192, 6518, 7246, 7_800_000, 648_000_000, 10_800_000_000, 16_560_000_000],
        [
            (1, -2, -1, 2, 1),
            (1, -5, -2, 3, 2),
            (2, -7, -2, 3, 2),
            (1, -7, -2, 2, 2),
            (1, -6, -2, 2, 1),
            (1, -6, -2, 2, 1),
            (0, -5, -2, 1, 2),
        ],
    )
    assert abs(heads["total"] - (-0.18)) < 1e-9, heads