# ---------------------------------------------------------------------------
# a1 — background-oriented schlieren flare-header leak, designed, REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_a1():
    k_bos = 0.50
    dy_px = 24.00
    rho = k_bos * dy_px
    _exact(rho, 12.00)
    _exact(k_bos * 8.00, 4.00)
    _exact(k_bos * 16.00, 8.00)
    _exact(k_bos * 20.00, 10.00)
    _exact(k_bos * 18.00, 9.00)
    _exact(k_bos * 16.00, 8.00)
    area = 0.50
    vel = 2.00
    mdot = rho * area * vel
    _exact(mdot, 12.00)
    _exact(8.00 * area * vel, 8.00)
    _exact(9.00 * area * vel, 9.00)
    _exact(dy_px / k_bos, 48.00)
    _exact(5100.0 + 1080.0, 6180.0)

    raster = make_raster(
        neurons=24,
        mean_rate_hz=50.0,
        window_ms=40.0,
        seed=2026090421,
        source="bh8.bos.header_h5",
        target="brackenholt.damper_stop_core",
        table=[
            {"from": "bos_dy", "to": "density_estimator", "weight": 1.40},
            {"from": "bos_snr", "to": "bos_lock_core", "weight": 1.15},
            {"from": "bosveil_rho", "to": "vendor_hotwork_advocate", "weight": 0.45},
        ],
        third_factor={
            "modulator": "da.bos_speckle_conflict",
            "tau_e_s": 1.6,
            "tau_e_ms": 1600.0,
            "eligibility": (
                "pre-post coincidence on keep-hotwork synapses; the BOS modulator "
                "depresses keep-hotwork links when pixel-shift stays high inside "
                "tau_e of an SNR lock so a Bosveil last-good density comb cannot hide "
                "a 12.00 kg/m3 flare-header leak"
            ),
        },
        channel_prefix="bos.n",
        anchor=(
            "BH-8 BOS 40 ms frame at dy 24.00 px (t_s 3000) reconstructing "
            "12.00 kg/m3 above the 8.00 kg/m3 isolate floor"
        ),
    )
    w_s = 0.040
    events = events_from_rows(
        [
            (0.0, "bos.dy", 8.00, {"code": "DY_PX", "units": "px", "note": "plant-owned background-oriented schlieren on Brackenholt BH-8 flare header H-5; pixel-shift density of a leak plume, not lock-in thermography, not FID THC, not TDLAS, not UV-DOAS, not paramagnetic O2"}),
            (180.0, "bos.snr", 6.0, {"code": "BOS_SNR", "units": "1", "note": "early SNR under the 12.0 lock floor"}),
            (360.0, "recon.rho", 4.00, {"code": "RHO_KGM3", "units": "kg_m3", "note": "0.50*8.00=4.00 exact"}),
            (540.0, "pitot.ms", 2.05, {"code": "PITOT_MS", "units": "m_s", "note": "plant pitot on copper fieldbus; independent of Bosveil DAQ cloud"}),
            (720.0, "bosveil.rho", 0.40, {"code": "VENDOR_KGM3", "units": "kg_m3", "note": "Bosveil last-good density/DAQ; infra owner; not admissible SoT"}),
            (900.0, "bos.dy", 16.00, {"code": "DY_PX", "units": "px"}),
            (1080.0, "recon.rho", 8.00, {"code": "RHO_KGM3", "units": "kg_m3", "note": "0.50*16.00=8.00 exact; isolate floor"}),
            (1260.0, "cam.I", 80.0, {"code": "CAM_DN", "units": "DN", "note": "background-dot illumination; BOS lock needs >= 40 DN"}),
            (1440.0, "wind.ms", 2.00, {"code": "WIND_MS", "units": "m_s", "note": "header-exit anemometer; independent witness"}),
            (1620.0, "plc.A", 40.0, {"code": "FAN_A", "units": "A", "note": "knockout-fan PLC on copper; no vendor agent"}),
            (1800.0, "bos.dy", 20.00, {"code": "DY_PX", "units": "px"}),
            (1980.0, "recon.rho", 10.00, {"code": "RHO_KGM3", "units": "kg_m3", "note": "0.50*20.00=10.00"}),
            (2160.0, "bos.snr", 11.0, {"code": "BOS_SNR", "units": "1", "note": "still under 12.0 lock"}),
            (2340.0, "bosveil.rho", 0.42, {"code": "VENDOR_KGM3", "units": "kg_m3"}),
            (2520.0, "cam.I", 82.0, {"code": "CAM_DN", "units": "DN"}),
            (2700.0, "wind.ms", 2.10, {"code": "WIND_MS", "units": "m_s"}),
            (2880.0, "pitot.ms", 2.08, {"code": "PITOT_MS", "units": "m_s"}),
            (3000.0, "bos.dy", 24.00, {"code": "DY_PX", "units": "px", "note": "isolate-floor frame; raster sidecar"}),
            (3000.0014, "bos.snr", 16.0, {"code": "BOS_SNR", "units": "1", "note": "1.4 ms SNR after pixel-shift; 16.0 >= 12.0 lock floor"}),
            (3180.0, "recon.rho", 12.00, {"code": "RHO_KGM3", "units": "kg_m3", "note": "0.50*24.00=12.00 exact; 24.00/0.50=48.00 scale identity"}),
            (3360.0, "recon.mdot", 12.00, {"code": "MDOT_KGS", "units": "kg_s", "note": "12.00*0.50*2.00=12.00 exact; isolate 8.00"}),
            (3540.0, "cam.I", 84.0, {"code": "CAM_DN", "units": "DN"}),
            (3720.0, "wind.ms", 2.00, {"code": "WIND_MS", "units": "m_s"}),
            (3900.0, "bosveil.rho", 0.40, {"code": "VENDOR_KGM3", "units": "kg_m3"}),
            (4200.0, "ops.prop", 1.0, {"code": "KEEP_HOTWORK", "units": "bool", "note": "night operator Ryn Holt: Bosveil 0.40 kg/m3 plus PLC clean; keep the hot-work permit"}),
            (4500.0, "gate.stop", 1.0, {"code": "REJECT", "units": "decision", "note": "refuse keep-hotwork; 12.00 kg/m3 and SNR 16.0; Bosveil not SoT"}),
            (4800.0, "plc.A", 38.0, {"code": "FAN_A", "units": "A"}),
            (5100.0, "soak.start", 1.0, {"code": "SOAK_START", "units": "bool", "note": "bookend 1 of the 18.0 min damper-hold floor"}),
            (6180.0, "soak.floor", 1.0, {"code": "SOAK_FLOOR", "units": "bool", "note": "5100 s + 1080 s = 6180 s = 18.0 min"}),
            (6400.0, "ops.kill", 1.0, {"code": "PLANT_ESD", "units": "bool", "note": "Holt: ESD the whole BH-8 flare until day-shift"}),
            (6600.0, "gate.hold", 1.0, {"code": "MODIFY", "units": "decision", "note": "companion t2: isolate damper H-5; plant ESD refused"}),
            (6800.0, "damper.set", 1.0, {"code": "H5_ISOL", "units": "bool"}),
            (7000.0, "bos.dy", 18.00, {"code": "DY_PX", "units": "px"}),
            (7200.0, "recon.rho", 9.00, {"code": "RHO_KGM3", "units": "kg_m3", "note": "0.50*18.00=9.00; still at/above 8.00 so the hold stays on the damper"}),
            (7400.0, "recon.mdot", 9.00, {"code": "MDOT_KGS", "units": "kg_s", "note": "9.00*0.50*2.00=9.00"}),
            (7600.0, "pitot.ms", 2.04, {"code": "PITOT_MS", "units": "m_s"}),
            (7800.0, "bosveil.rho", 0.41, {"code": "VENDOR_KGM3", "units": "kg_m3"}),
            (8000.0, "room.esd", 0.0, {"code": "ESD_NOT_TAKEN", "units": "bool"}),
            (8200.0, "soak.held", 1.0, {"code": "SOAK_HELD", "units": "bool"}),
            (8400.0, "damper.held", 1.0, {"code": "H5_HELD", "units": "bool"}),
            (8600.0, "wind.ms", 1.90, {"code": "WIND_MS", "units": "m_s"}),
            (8800.0, "plc.A", 22.0, {"code": "FAN_A", "units": "A"}),
            (9000.0, "bos.snr", 14.0, {"code": "BOS_SNR", "units": "1"}),
            (9200.0, "cam.I", 81.0, {"code": "CAM_DN", "units": "DN"}),
            (9400.0, "fan.held", 1.0, {"code": "FAN_HELD_040", "units": "bool"}),
            (9600.0, "fid.ppm", 220.0, {"code": "FID_PPM", "units": "ppm", "note": "spot FID THC; independent of Bosveil, not a FID-as-SoT family"}),
            (9800.0, "bos.dy", 16.00, {"code": "DY_PX", "units": "px"}),
            (10000.0, "recon.rho", 8.00, {"code": "RHO_KGM3", "units": "kg_m3", "note": "0.50*16.00=8.00"}),
            (10200.0, "recon.mdot", 8.00, {"code": "MDOT_KGS", "units": "kg_s", "note": "8.00*0.50*2.00=8.00"}),
            (10400.0, "pitot.ms", 2.02, {"code": "PITOT_MS", "units": "m_s"}),
            (10600.0, "damper.pos", 0.40, {"code": "H5_POS", "units": "pu"}),
            (10800.0, "bos.snr", 13.0, {"code": "BOS_SNR", "units": "1"}),
        ]
    )
    assert_stream(events)

    traj = {
