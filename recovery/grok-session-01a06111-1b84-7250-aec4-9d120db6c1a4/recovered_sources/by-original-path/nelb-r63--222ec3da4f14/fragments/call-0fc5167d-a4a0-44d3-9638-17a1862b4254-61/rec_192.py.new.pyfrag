# ---------------------------------------------------------------------------
# Record 192 — cation conductivity remaining condensate of a steam hotwell, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_192():
    k_c = 4.00
    g_us = 8.00
    g_bg = 2.00
    kappa = k_c * (g_us - g_bg)
    _exact(kappa, 24.00)
    _exact(k_c * (4.00 - g_bg), 8.00)
    _exact(k_c * (7.00 - g_bg), 20.00)
    _exact(k_c * (8.00 - g_bg), 24.00)
    _exact(k_c * (7.00 - g_bg), 20.00)
    g_net = g_us - g_bg
    _exact(g_net, 6.00)
    _exact(g_net / g_bg, 3.00)
    na_ppb = 0.50 * kappa
    _exact(na_ppb, 12.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609192,
        source="sw8.cat.g",
        target="siltwharf.hotwell_accept_core",
        table=[
            {"from": "cat_G", "to": "kappa_estimator", "weight": 1.40},
            {"from": "cat_Gbg", "to": "bg_norm_core", "weight": 1.20},
            {"from": "catveil_k", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.hotwell_scope_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-hotwell synapses; the cation-conductivity modulator enables potentiation only while cell current and G_bg are co-active inside tau_e so a Catveil last-good cannot skip hotwells H-1..H-3 on a 24.00 uS/cm condensate load",
        },
        channel_prefix="cat.n",
        anchor="SW-8 CAT-SIM-3 36 ms frame at G 8.00 / G_bg 2.00 (t_s 3000) reconstructing 24.00 uS/cm on H-4 above the 20.00 isolate floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "cat.G", 4.00, code="G_US", units="uS", note="simulated cation-conductivity cell of SW-8 steam hotwell H-4; remaining-condensate family, not four-electrode brine conductivity, not LPR Stern-Geary, not EN CUI, not SPR cyanide, not amperometric free-chlorine, not Clark DO, not Stern-Volmer DO"),
        ev(300000.0, "cat.Gbg", 2.00, code="G_BG", units="uS", note="blank cell background; held at 2.00"),
        ev(600000.0, "recon.K", 8.00, code="KAPPA", units="uS_cm", note="4.00*(4.00-2.00)=8.00 exact"),
        ev(900000.0, "cat.snr", 14.0, code="CAT_SNR", units="1"),
        ev(1200000.0, "catveil.K", 4.80, code="VENDOR_US", units="uS_cm", note="Catveil last-good sodium-lab cloud; patched residual 6.00 uS/cm"),
        ev(1800000.0, "cat.G", 7.00, code="G_US", units="uS"),
        ev(2100000.0, "recon.K", 20.00, code="KAPPA", units="uS_cm", note="4.00*(7.00-2.00)=20.00; at the 20.00 isolate floor"),
        ev(2400000.0, "recon.R", 2.50, code="R", units="1", note="(7.00-2.00)/2.00=2.50 exact ratio identity at this frame"),
        ev(2700000.0, "cat.snr", 16.0, code="CAT_SNR", units="1"),
        ev(3000000.0, "cat.G", 8.00, code="G_US", units="uS", note="in-band frame; raster sidecar"),
        ev(3000001.5, "cat.Gbg", 2.00, code="G_BG", units="uS", note="1.5 ms G_bg-norm after cell conductance"),
        ev(3300000.0, "recon.K", 24.00, code="KAPPA", units="uS_cm", note="4.00*(8.00-2.00)=24.00 exact; isolate 20.00, dump-trip 80.00"),
        ev(3600000.0, "catveil.K", 4.80, code="VENDOR_US", units="uS_cm"),
        ev(3900000.0, "hw.id", 4.0, code="HOTWELL", units="id"),
        ev(4200000.0, "h13.present", 1.0, code="H13_PRESENT", units="bool", note="adjacent hotwells H-1..H-3 are the skip-isolate object, not this hotwell"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="water lead Mael Dorr: H-4 is green on Catveil 4.80; skip H-1..H-3 to save a morning survey"),
        ev(5400000.0, "gate.comp", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of H-4 isolate only; 24.00 uS/cm above 20.00 floor; H-1..H-3 out of scope"),
        ev(6000000.0, "surv.start", 1.0, code="SURV_START", units="bool", note="bookend 1 of the 12.0 min survey-complete floor"),
        ev(6720000.0, "surv.floor", 1.0, code="SURV_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_H13", units="bool", note="Dorr: Catveil 4.80, skip H-1..H-3"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-isolate of H-1..H-3 refused; H-4 hold stands"),
        ev(8400000.0, "h4.held", 1.0, code="H4_HELD", units="bool"),
        ev(9000000.0, "cat.G", 7.00, code="G_US", units="uS"),
        ev(9600000.0, "recon.K", 20.00, code="KAPPA", units="uS_cm", note="4.00*(7.00-2.00)=20.00; still at the 20.00 isolate floor"),
        ev(10200000.0, "catveil.K", 4.80, code="VENDOR_US", units="uS_cm"),
        ev(10800000.0, "h13.skip", 0.0, code="H13_NOT_SKIPPED", units="bool"),
        ev(11400000.0, "dump.trip", 0.0, code="DUMP_NOT_TRIPPED", units="bool"),
        ev(12000000.0, "cat.snr", 15.0, code="CAT_SNR", units="1"),
        ev(12600000.0, "recon.R", 3.00, code="R", units="1", note="(8.00-2.00)/2.00=3.00 identity on the in-band frame; post-accept G_net/G_bg=(7.00-2.00)/2.00=2.50"),
        ev(13200000.0, "hw.held", 1.0, code="HW_HELD", units="bool"),
        ev(13800000.0, "takt.late", 1.0, code="SURVEY_COST", units="bool"),
        ev(14400000.0, "h4.held", 1.0, code="H4_HELD", units="bool"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r63-192-t1",
        "state": {
            "sim_or_real": "simulated",
            "episode_id": "SW-CAT-2026-0819",
            "domain": "cation_conductivity_hotwell",
            "setting": "Siltwharf Steam SW-8 (invented), Kelpholt Steam Yard, hotwell H-4. Simulated cation-conductivity coupon in CAT-SIM-3 supplies the cell conductance and G_bg that time the in-band H-4 isolate. Plant-owned cation-conductivity reconstruction is the condensate SoT. Catveil vendor last-good sodium-lab cloud is a corridor witness, not the hotwell SoT. Invented plant; simulated campaign. Not four-electrode brine conductivity (r57), not LPR Stern-Geary (r45), not EN CUI (r23), not SPR cyanide (r26), not Clark polarographic DO (r64), not Stern-Volmer DO (r61).",
