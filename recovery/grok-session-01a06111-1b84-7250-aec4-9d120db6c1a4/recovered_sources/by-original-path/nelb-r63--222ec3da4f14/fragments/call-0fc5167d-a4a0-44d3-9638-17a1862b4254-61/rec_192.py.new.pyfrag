        "meta": meta_common(
            tags=["ACCEPT", "cation-conductivity", "serialized-reconstruction", "operational-companion"],
            distillation_note="Cation-conductivity gate: serialized k_c*(G-G_bg) plus ratio identity beats a green sodium-lab dashboard; companion t2 is the skip-hotwell refusal, not a second kappa vote",
