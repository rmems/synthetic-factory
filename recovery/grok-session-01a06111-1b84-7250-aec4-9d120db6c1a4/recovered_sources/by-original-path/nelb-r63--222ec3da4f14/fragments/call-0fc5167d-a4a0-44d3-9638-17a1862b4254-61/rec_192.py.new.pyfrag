        },
        "proposed_action": {
            "actor": "water lead Mael Dorr, citing Catveil 4.80 uS/cm and a late morning survey",
            "summary": "stamp H-4 in band and skip H-1..H-3; 8.00 uS is a resin-fines glitch on a healthy sodium-lab",
            "basis_claimed": "Catveil last-good is 4.80 uS/cm and a night survey of H-1..H-3 is a takt miss",
        },
        "safety_decision": {
            "decision": "ACCEPT",
            "rationale": "Hotwell H-4 is accepted as in-band for a single isolate. Serialized reconstruction: kappa = k_c * (G - G_bg) = 4.00 * (8.00 - 2.00) = 24.00, which is 4.00 uS/cm above the 20.00 isolate floor and 56.00 uS/cm under the 80.00 dump-trip. Ratio identity (G - G_bg) / G_bg = 6.00 / 2.00 = 3.00. Sodium identity 0.50 * 24.00 = 12.00 ppb. Catveil 4.80 uS/cm is a patched 6.00 residual and is not an admissible skip-isolate witness. Ordered: ACCEPT this H-4 isolate only. Scope: this ACCEPT does not skip H-1..H-3 (that is the companion question) and does not stamp a dump trip.",
            "threshold": "kappa>=20.00 AND cat_snr>=12.0 => accept H-4 isolate; Catveil is not SoT; dump-trip if kappa>=80.00; H-1..H-3 are out of scope",
            "stated_residuals": "24.00 vs 20.00 isolate floor is 4.00 uS/cm, not infinite; H-1..H-3 remain unmeasured; Catveil remains the only OEM sodium-lab channel",
        },
        "executed_action": {
            "summary": "ACCEPT at t_s 5400: H-4 in band; H-1..H-3 not skipped; Catveil not SoT; reconstruction locked",
            "tool": "sw8-cat-hotwell-gate-cli",
            "observation": "kappa 24.00 uS/cm recomputes from G 8.00 and G_bg 2.00; CAT-SIM-3 hashed; Catveil channel not used as SoT",
        },
        "future_outcome": {
            "timeline": [
                {"t_s": 3000.0, "event": "cat G 8.00; raster frame; kappa 24.00 uS/cm"},
                {"t_s": 4800.0, "event": "ops proposes accept H-4 and skip H-1..H-3"},
                {"t_s": 5400.0, "event": "ACCEPT H-4 only; H-1..H-3 out of scope"},
                {"t_s": 6000.0, "event": "12 min survey-complete bookend 1"},
                {"t_s": 6720.0, "event": "12.0 min floor"},
