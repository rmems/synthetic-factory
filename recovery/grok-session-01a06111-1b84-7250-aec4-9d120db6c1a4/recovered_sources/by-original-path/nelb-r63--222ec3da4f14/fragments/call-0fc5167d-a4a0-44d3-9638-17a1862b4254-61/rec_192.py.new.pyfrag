            "tool": "sw8-cat-surv-exec",
            "observation": "recon.K 20.00 uS/cm on CAT-SIM-3; Catveil still ignored; H-1..H-3 remain in the survey",
        },
        "future_outcome": {
            "timeline": [
                {"t_s": 6000.0, "event": "survey clock started after ACCEPT"},
                {"t_s": 6720.0, "event": "12.0 min floor"},
                {"t_s": 7200.0, "event": "H-1..H-3 skip re-proposed"},
                {"t_s": 7800.0, "event": "REJECT skip-isolate; H-4 hold stands"},
