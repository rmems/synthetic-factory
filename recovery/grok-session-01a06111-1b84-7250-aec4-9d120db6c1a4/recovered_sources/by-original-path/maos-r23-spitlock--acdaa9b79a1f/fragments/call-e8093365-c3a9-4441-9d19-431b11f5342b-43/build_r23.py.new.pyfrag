        {"channel": "tube.creep", "t_rel_ms": 17280000.0, "amplitude": 0.94},
    ]
    contrast_spikes = [
        {"channel": "stm.demand", "t_rel_ms": 0.000, "amplitude": 0.81},
        {"channel": "noz.clear", "t_rel_ms": 0.168, "amplitude": 0.75},
        {"channel": "stm.hot", "t_rel_ms": 0.412, "amplitude": 0.21},
        {"channel": "fw.ok", "t_rel_ms": 1.438, "amplitude": 0.37},
        {"channel": "noz.dP", "t_rel_ms": 4.846, "amplitude": 0.50},
        {"channel": "ctrl.gate", "t_rel_ms": 7.018, "amplitude": 0.89},
        {"channel": "spray.probe", "t_rel_ms": 3100.0, "amplitude": 0.32},
