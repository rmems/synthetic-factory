def write_create_only(path: Path, text: str) -> Path:
    text_path = str(path)
    if any(run in text_path for run in FORBIDDEN_RUNS):
        raise SystemExit(f"refuse forbidden run path {path}")
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    try:
        fd = os.open(path, flags, 0o644)
    except FileExistsError as exc:
        name = path.name
        if name == "batch-r02.jsonl":
            return write_create_only(path.with_name("batch-r02c.jsonl"), text)
        if name == "NOTES-r02.md":
            return write_create_only(path.with_name("NOTES-r02c.md"), text)
        raise SystemExit(f"refuse overwrite {path}") from exc
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
        fh.flush()
        os.fsync(fh.fileno())
    return path


def main() -> int:
    live_resolved = LIVE.resolve()
    if any(run in str(live_resolved) for run in FORBIDDEN_RUNS):
        raise SystemExit(f"refuse forbidden run {live_resolved}")
    if live_resolved.name != "agentic-coding-trajectory-factory":
        raise SystemExit(f"refuse unexpected factory dir {live_resolved}")
    plant_hits = prior_plant_hits()
    if plant_hits:
        raise SystemExit(f"plant collision {plant_hits}")
    recs = [ep1(), ep2()]
    taken = prior_ids()
    for rec in recs:
        if rec["id"] in taken:
            raise SystemExit(f"id collision {rec['id']}")
        if not rec["id"].startswith("act-r02-"):
            raise SystemExit(f"id prefix {rec['id']}")
        if rec["id"].startswith("actf-"):
            raise SystemExit(f"actf prefix {rec['id']}")
        if rec["meta"]["round"] != 2:
            raise SystemExit("meta.round")
        validate_record(rec)
    LIVE.mkdir(parents=True, exist_ok=True)
    batch_text = "".join(
        json.dumps(rec, ensure_ascii=True, separators=(",", ":")) + "\n" for rec in recs
    )
    notes_text = notes()
    batch = write_create_only(LIVE / "batch-r02.jsonl", batch_text)
    notes_path = write_create_only(LIVE / "NOTES-r02.md", notes_text)
    errors, warnings, kinds, n = check_jsonl(
        batch, "batch-r02.jsonl", staging=FactoryStaging(enabled=True)
    )
    if errors:
        raise SystemExit(f"check_jsonl errors {errors}")
    if warnings:
        raise SystemExit(f"check_jsonl warnings {warnings}")
    counts, findings, blocked = verify_batch_for_frontier(batch, strict=True)
    if blocked or counts.get("verified") != 2:
        raise SystemExit(f"frontier blocked={blocked} counts={counts} findings={findings}")
    print(f"wrote {batch} ({n} records, kinds={kinds})")
    print(f"wrote {notes_path}")
    print(f"verify_batch_for_frontier strict: {counts} blocked={blocked}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
