    "linear_issue": "RM-793",
    "training_ready": False,
}

PREFIXES = ("Plan: ", "Observation: ", "Reflection: ", "Tool call: ")


def db(text: str) -> str:
    if not text.startswith(PREFIXES):
        raise SystemExit(f"basis prefix: {text!r}")
    if OBSERVABLE_BASIS_RE.search(text) is None:
        raise SystemExit(f"basis observable: {text!r}")
    n = len(text)
    if not (80 <= n <= 240):
        raise SystemExit(f"basis len {n}: {text!r}")
    return text


def hid(slug: str) -> str:
    return hashlib.sha256(slug.encode()).hexdigest()[:6]


def step(
    n: int,
    basis: str,
    name: str,
    args: dict,
    observation: str,
    reflection: str,
    plan: str | None = None,
) -> dict:
    out = {
        "n": n,
        "decision_basis": db(basis),
        "tool_call": {"name": name, "args": args},
        "observation": observation,
        "reflection": reflection,
    }
    if plan is not None:
        out["plan"] = plan
        # keep plan after decision_basis like live r02
        ordered = {
            "n": n,
            "decision_basis": out["decision_basis"],
            "plan": plan,
            "tool_call": out["tool_call"],
            "observation": observation,
            "reflection": reflection,
        }
        return ordered
    return out


def walk_hidden(obj, path=""):
    hits = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            lk = k.lower()
            if lk in HIDDEN or lk.startswith("internal_reasoning"):
                hits.append(f"{path}{k}")
            hits.extend(walk_hidden(v, path + k + "."))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            hits.extend(walk_hidden(v, path + f"[{i}]."))
    return hits


def census_live_ids():
    ids = set()
    if not os.path.isdir(LIVE):
        raise SystemExit(f"missing live dir {LIVE}")
    for name in os.listdir(LIVE):
        if not name.startswith("batch-r") or not name.endswith(".jsonl"):
            continue
        with open(os.path.join(LIVE, name), encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                ids.add(json.loads(line)["id"])
    return ids


def validate(ep: dict) -> None:
    where = ep["id"]
    errs = check_episode(ep, where, require_goal=True, forbid_hidden_thought=True)
    if errs:
        raise SystemExit("check_episode: " + "; ".join(errs))
    status, reasons = verify_episode_steps(ep["steps"], where)
    if status != "verified":
        raise SystemExit(f"verify_episode_steps {status}: {reasons}")
    sparse = sparse_step_progress_errors(where, ep["steps"])
    if sparse:
        raise SystemExit("sparse: " + "; ".join(sparse))
    hidden = walk_hidden(ep)
    if hidden:
        raise SystemExit("hidden keys: " + ",".join(hidden))
    steps = ep["steps"]
    ns = [s["n"] for s in steps]
    if ns != list(range(1, len(steps) + 1)):
        raise SystemExit(f"step numbering {ns}")
    if not (12 <= len(steps) <= 17):
        raise SystemExit(f"step count {len(steps)}")
    tools = [(s["tool_call"]["name"]) for s in steps]
    bad = [t for t in tools if t not in KNOWN_TOOLS]
    if bad:
        raise SystemExit(f"unknown tools {bad}")
    obs = [s["observation"] for s in steps]
    n429 = sum(1 for o in obs if "429" in o)
    n502 = sum(1 for o in obs if "502" in o)
    if n429 != 1 or n502 != 1:
        raise SystemExit(f"noise counts 429={n429} 502={n502}")
    for s in steps:
        if "hypothesis" in s["observation"].lower():
            raise SystemExit(f"hypothesis in observation step {s['n']}")
        if not s["decision_basis"].startswith(PREFIXES):
            raise SystemExit(f"basis prefix step {s['n']}")
    # recovery observations must not repeat status codes
    for s in steps:
        dbasis = s["decision_basis"]
        if "429" in dbasis and "429" in s["observation"]:
            raise SystemExit(f"429 leaked into recovery obs step {s['n']}")
        if "502" in dbasis and "502" in s["observation"]:
            raise SystemExit(f"502 leaked into recovery obs step {s['n']}")
    plan_hits = [
        s["n"]
        for s in steps
        if "plan change:" in (s.get("reflection") or "").lower()
        or "pivoting:" in (s.get("reflection") or "").lower()
    ]
    if plan_hits != [8]:
        raise SystemExit(f"plan change steps {plan_hits}")
    if ep["meta"]["round"] != 4:
        raise SystemExit("meta.round")
    if ep["meta"]["factory"] != "agentic-coding-trajectory-factory":
        raise SystemExit("meta.factory")
    if ep["meta"]["sim_or_real"] != "designed":
        raise SystemExit("sim_or_real")


