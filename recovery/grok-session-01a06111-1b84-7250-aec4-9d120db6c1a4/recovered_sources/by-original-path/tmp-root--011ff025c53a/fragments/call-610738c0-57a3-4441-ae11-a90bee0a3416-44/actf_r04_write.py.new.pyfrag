            "avocetsv/split.py:7:    return [p.strip() for p in line.split(\",\")]\n"
            "avocetsv/split.py:11:        return [split_row(line.rstrip(\"\\n\")) for line in fh]\n"
            "tests/smoke.test.py:6:    split_row(\"harbor,ok\")\n"
            "5 matches",
            "Found split_row splitting dest lines on every comma. Next read the CLI helper.",
            plan="1) search split_row 2) read split.py 3) measure quoted comma 4) confirm want 2 fields 5) csv.reader 6) apply or hand off",
        ),
        step(
            2,
            "Observation: split.py:7 calls line.split(\",\") (step 1). Read the helper as evidence of any csv.reader path.",
            "read_file",
            {"path": "avocetsv/split.py", "offset": 1, "limit": 16},
            "1  import csv\n"
