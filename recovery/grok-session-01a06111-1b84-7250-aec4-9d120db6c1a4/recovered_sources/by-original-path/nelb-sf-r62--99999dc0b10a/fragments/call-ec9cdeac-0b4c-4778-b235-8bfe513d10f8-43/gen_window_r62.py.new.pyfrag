        ),
    )
    w_s = 0.036
    events = [
        ev(0.0, "rheo.dP", 8.00, code="DP_BAR", units="bar", note="simulated capillary-rheometer of TH-3 extruder E-2; remaining-melt-viscosity family, not Ubbelohde kinematic, not vibrating-wire viscometer, not Mooney ML, not Coriolis, not VW viscometer, not FBRM"),
