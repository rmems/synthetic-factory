            tags=["quartz-sf6-density", "MODIFY", "ACCEPT", "serialized-reconstruction", "operational-t2"],
        ),
    }


def rec_a3():
    k_eta = 2.00
    dp = 16.00
    q = 4.00
    eta = k_eta * dp / q
    _exact(eta, 8.00)
    ratio = dp / q
    _exact(ratio, 4.00)
    tau = eta * 50.00
    _exact(tau, 400.00)
    _exact(k_eta * 8.00 / 4.00, 4.00)
    _exact(k_eta * 12.00 / 4.00, 6.00)
    _exact(k_eta * 20.00 / 4.00, 10.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609623,
        source="th3.rheo.dP",
        target="tarholt.extruder_accept_core",
        table=[
            {"from": "rheo_dP", "to": "eta_estimator", "weight": 1.40},
            {"from": "rheo_snr", "to": "capillary_norm_core", "weight": 1.20},
            {"from": "meltveil_eta", "to": "vendor_skip_advocate", "weight": 0.50},
