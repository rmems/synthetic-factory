    STAGING_NOTES.write_text(notes, encoding="utf-8")
    print("wrote", STAGING_NOTES, "bytes", STAGING_NOTES.stat().st_size)
    _ = probe_out, dest_notes_name


def publish_create_only(dest_batch, dest_notes):
    if dest_batch.exists() or dest_notes.exists():
        raise RuntimeError(f"refuse overwrite {dest_batch} {dest_notes}")
    shutil.copyfile(STAGING_BATCH, dest_batch)
    shutil.copyfile(STAGING_NOTES, dest_notes)
    dest_batch.chmod(0o644)
    dest_notes.chmod(0o644)
    print("published create-only", dest_batch, dest_notes)


def main():
    occupancy_preflight()
    records = [rec_a1(), rec_a2(), rec_a3()]
    local_checks(records)
    STAGING.mkdir(parents=True, exist_ok=True)
    lines = [
        json.dumps(r, ensure_ascii=False, allow_nan=False, separators=(",", ":"))
        for r in records
    ]
    STAGING_BATCH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print("wrote", STAGING_BATCH, "bytes", STAGING_BATCH.stat().st_size, "lines", len(lines))
    for i, r in enumerate(records):
        print(
            r["id"],
            "events",
            len(r["spike_events"]),
            "excerpt",
            len(r["raster"]["excerpt"]),
            "spikes",
            r["raster"]["spikes"],
            "isi",
            r["raster"]["isi_count_identity"],
            "sim",
            r["language_view"]["trajectory"]["state"]["sim_or_real"],
            "dec",
            r["language_view"]["trajectory"]["safety_decision"]["decision"],
            "bytes",
            len(lines[i]),
        )
        json.loads(lines[i], parse_constant=lambda x: (_ for _ in ()).throw(ValueError(x)))
    dest_batch, dest_notes = dest_names()
    gate = repo_validate(records)
    write_notes(records, lines, dest_batch, dest_notes)
    publish_create_only(dest_batch, dest_notes)
    print("dest", dest_batch, dest_notes, "gate", gate["check_jsonl"])


if __name__ == "__main__":
    main()