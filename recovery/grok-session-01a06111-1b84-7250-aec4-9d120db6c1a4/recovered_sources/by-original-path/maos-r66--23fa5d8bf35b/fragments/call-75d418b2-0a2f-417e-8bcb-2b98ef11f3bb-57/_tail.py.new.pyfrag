def build_record():
    ticks, heads = cents_ticks(
        [4428, 6448, 7164, 7_800_000, 636_000_000, 11_520_000_000, 19_440_000_000],
        [
            (1, -2, -1, 2, 1),
            (2, -4, -1, 3, 1),
            (2, -6, -2, 3, 2),
            (1, -7, -2, 2, 1),
            (1, -5, -2, 2, 1),
            (1, -6, -2, 1, 1),
            (0, -6, -2, 1, 2),
        ],
    )
    assert abs(heads["total"] - (-0.17)) < 1e-9, heads

    trace = math.exp(-DELAY_S / TAU_E_S)
    eta1 = 0.25 / trace
    eta2 = 0.22 / trace
    eta3 = 0.21 / trace
    dw1 = eta1 * 1.0 * trace
    dw2 = eta2 * 1.0 * trace
    dw3 = eta3 * 1.0 * trace
    w1 = 0.50 - dw1
    w2 = 0.44 - dw2
    w3 = 0.41 - dw3
    assert abs(w1 - 0.25) < 5e-4, w1
    assert abs(w2 - 0.22) < 5e-4, w2
    assert abs(w3 - 0.20) < 5e-4, w3

    spike_events = [
        {"channel": "cav.hot", "t_rel_ms": 0.312, "amplitude": 0.51},
