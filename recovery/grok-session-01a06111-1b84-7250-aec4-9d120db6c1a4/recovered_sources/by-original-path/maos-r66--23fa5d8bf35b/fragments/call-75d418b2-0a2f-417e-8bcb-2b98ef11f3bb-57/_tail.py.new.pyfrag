        {"channel": "spit.tau", "t_rel_ms": 7888.4, "amplitude": 0.38},
        {"channel": "cav.in_band", "t_rel_ms": 7974.0, "amplitude": 0.33},
        {"channel": "human.ratify", "t_rel_ms": 636000.0, "amplitude": 0.78},
        {"channel": "oven.hold", "t_rel_ms": 636900.0, "amplitude": 0.72},
        {"channel": "spit.seize", "t_rel_ms": 637800.0, "amplitude": 0.84},
        {"channel": "cav.hot", "t_rel_ms": 11520000.0, "amplitude": 0.28},
        {"channel": "spit.tau", "t_rel_ms": 11520760.0, "amplitude": 0.26},
        {"channel": "rpm.ok", "t_rel_ms": 11521540.0, "amplitude": 0.23},
        {"channel": "grease.flash", "t_rel_ms": 19440000.0, "amplitude": 0.92},
    ]
    contrast_spikes = [
        {"channel": "cav.demand", "t_rel_ms": 0.000, "amplitude": 0.81},
        {"channel": "spit.clear", "t_rel_ms": 0.178, "amplitude": 0.75},
        {"channel": "cav.hot", "t_rel_ms": 0.422, "amplitude": 0.21},
        {"channel": "exh.ok", "t_rel_ms": 1.462, "amplitude": 0.37},
        {"channel": "spit.tau", "t_rel_ms": 4.872, "amplitude": 0.50},
        {"channel": "ctrl.gate", "t_rel_ms": 7.042, "amplitude": 0.89},
