Publishable JSONL line (the only JSONL line; also at batch-r61.jsonl):

```json
__FINAL_JSONL__
```

Validation receipt (final): checks passed / fixed as reported by
build_r61.py self-validate (check_jsonl, raster_status, verify_record_execution,
spike_probe --strict).
"""
    text = (
        text.replace("__C1_SPIKES__", str(len(c1_spikes)))
        .replace("__AUX_TRACE__", f"{math.exp(-DELAY_S / TAU_E_S):.5f}")
        .replace("__AUX_ETA1__", f"{0.25 / math.exp(-DELAY_S / TAU_E_S):.5f}")
        .replace("__AUX_ETA2__", f"{0.22 / math.exp(-DELAY_S / TAU_E_S):.5f}")
        .replace("__AUX_ETA3__", f"{0.21 / math.exp(-DELAY_S / TAU_E_S):.5f}")
        .replace("__FINAL_JSONL__", line)
    )
    return text


def create_only(path: Path) -> Path:
    if not path.exists():
        return path
    if path.name.startswith("batch-r61") and path.suffix == ".jsonl":
        alt = path.with_name("batch-r61c.jsonl")
        if not alt.exists():
            return alt
    raise FileExistsError(f"refuse: {path} already exists")


def emit_text(path: Path, text: str) -> Path:
    dest = create_only(path)
    dest.write_text(text)
    return dest


def main():
    rec, aux = build_record()
    errs = local_checks(rec, aux)

    OUT.mkdir(parents=True, exist_ok=True)
    OUT_WINDOW.mkdir(parents=True, exist_ok=True)
    line = json.dumps(rec, ensure_ascii=False, separators=(",", ":"))
    jsonl_stage = emit_text(OUT / "batch-r61.jsonl", line + "\n")
    jsonl_window = emit_text(OUT_WINDOW / "batch-r61.jsonl", line + "\n")

    from check_records import FactoryStaging, check_jsonl
    from curate_bridge import raster_status
    from verify_execution import verify_record_execution

    e, w, kinds, n = check_jsonl(
        jsonl_stage,
        jsonl_stage.name,
        staging=FactoryStaging(enabled=True),
    )
    print("check_jsonl errors", e)
    print("check_jsonl warnings", w)
    print("kinds", kinds, "n", n)
    errs.extend(e)

    st = raster_status(rec)
    print(
        "raster_status",
        {
            k: st[k]
            for k in (
                "raster_present",
                "raster_valid",
                "gate_snn_present",
                "gate_snn_valid",
                "reason_codes",
                "routing_table_entries",
                "third_factor_present",
                "spikes",
            )
            if k in st
        },
    )
    if st.get("reason_codes"):
        errs.append(f"raster {st['reason_codes']}")
    if not st.get("raster_valid"):
        errs.append("raster not valid")
    if not st.get("gate_snn_valid"):
        errs.append("gate_snn not valid")

    status, reason = verify_record_execution(rec, RECORD_ID)
    print("verify_record_execution", status, reason)
    if status != "verified":
        errs.append(f"verify {status} {reason}")

    probe = subprocess.run(
        [
            sys.executable,
            f"{ROOT}/pipelines/spike_probe.py",
            "--strict",
            str(jsonl_stage),
        ],
        capture_output=True,
        text=True,
    )
    print("spike_probe rc", probe.returncode)
    print(probe.stdout[-2000:] if probe.stdout else "")
    if probe.returncode != 0:
        errs.append(f"spike_probe {probe.returncode} {probe.stderr[-500:]}")

    pipeline_receipt = (
        f"check_jsonl errors={e} warnings={w} kinds={kinds} n={n}; "
        f"raster_status valid={st.get('raster_valid')} gate={st.get('gate_snn_valid')} "
        f"reasons={st.get('reason_codes')}; verify_record_execution={status} "
        f"({reason}); spike_probe --strict rc={probe.returncode}"
    )
    notes = write_notes(rec, aux, pipeline_receipt)
    transcript = write_transcript(rec, line)
    notes_stage = emit_text(OUT / "NOTES-r61.md", notes)
    notes_window = emit_text(OUT_WINDOW / "NOTES-r61.md", notes)
    tr_stage = emit_text(OUT / "swarm-transcript-r61.md", transcript)
    tr_window = emit_text(OUT_WINDOW / "swarm-transcript-r61.md", transcript)

    heading = subprocess.run(
        [sys.executable, "/tmp/maos_heading_check.py", str(tr_stage)],
        capture_output=True,
        text=True,
    )
    print(heading.stdout)
    if heading.returncode != 0:
        errs.append(f"heading check {heading.returncode} {heading.stdout}")

    raw_hits = subprocess.run(
        [
            "rg",
            "-l",
            "maos-r61-001|GRATEHOLT",
            str(Path(ROOT) / "outputs" / "raw"),
        ],
        capture_output=True,
        text=True,
    )
    if raw_hits.stdout.strip():
        errs.append(f"raw tree hit {raw_hits.stdout.strip()[:200]}")

    loads_ok = True
    for p in (jsonl_stage, jsonl_window):
        for i, raw in enumerate(p.read_text().splitlines(), 1):
            if not raw.strip():
                continue
            try:
                json.loads(raw)
            except json.JSONDecodeError as exc:
                errs.append(f"json.loads {p}:{i} {exc}")
                loads_ok = False
    print("json.loads", loads_ok)

    if errs:
        print("FAIL", errs)
        return 1
    print("OK maos-r61-001 staged under", OUT, "and", OUT_WINDOW)
    print("bytes jsonl", jsonl_window.stat().st_size)
    print("bytes notes", notes_window.stat().st_size)
    print("bytes transcript", tr_window.stat().st_size)
    print("paths", jsonl_window, notes_window, tr_window)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
