        },
        "safety_decision": {
            "decision": "ACCEPT",
            "rationale": "Restart the cell on a different lamp after the cooldown floor. The 24 min lamp-settle is complete and the trip tripwire (NTU >= 28.00) is still armed on the plant nephelometer head. ACCEPT the new-lamp restart. Do not refer Quinn. Do not trip the plant. 16.00 NTU post-isolate is still at the 16.00 isolate floor, so the isolated basin stays held; the new lamp may run.",
            "threshold": "new_lamp AND cool_floor_complete AND refer_not_taken AND plant_not_tripped AND isolated_basin_held",
        },
        "executed_action": {
