# ---------------------------------------------------------------------------
# Record 191 — 90-degree nephelometric remaining turbidity of a clarifier, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_191():
    k_t = 5.00
    i90 = 8.00
    iref = 2.00
    ntu = k_t * i90 / iref
    _exact(ntu, 20.00)
    r_i = i90 / iref
    _exact(r_i, 4.00)
    _exact(k_t * 4.00 / 2.00, 10.00)
    _exact(k_t * 6.40 / 2.00, 16.00)
    _exact(k_t * 8.00 / 2.00, 20.00)
    ss = 0.80 * ntu
    _exact(ss, 16.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202609191,
        source="cw5.neph.i90",
        target="copsewhin.basin_isolate_core",
        table=[
            {"from": "neph_i90", "to": "ntu_estimator", "weight": 1.35},
            {"from": "neph_iref", "to": "scatter_norm_core", "weight": 1.20},
            {"from": "nephveil_ntu", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.formazin_referral_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": "pre-post coincidence on keep-overflow synapses; the nephelometer modulator depresses keep-overflow and referral links when I90 stays high inside tau_e of an Iref lock so a Nephveil last-good cannot hide a 20.00 NTU basin or name Sable Quinn",
        },
        channel_prefix="neph.n",
        anchor="CW-5 HIL coupon 32 ms frame at I90 8.00 / Iref 2.00 / SNR 14.0 (t_s 1560) reconstructing 20.00 NTU above the 16.00 isolate floor",
    )
    w_s = 0.032
    events = [
        ev(0.0, "neph.I90", 4.00, code="I90", units="1", note="HIL 90-degree nephelometer on a dummy clarifier basin in NEPH-HIL-5; remaining-turbidity family, not UV-fluorescence OIW, not TEOM PM, not BAM PM, not LII soot, not SPR cyanide, not Raman OH-CH, not QEPAS"),
        ev(180000.0, "neph.snr", 9.0, code="NEPH_SNR", units="1", note="early scatter SNR; isolate needs SNR>=12"),
        ev(360000.0, "recon.NTU", 10.00, code="NTU", units="NTU", note="5.00*4.00/2.00=10.00 exact"),
        ev(540000.0, "form.zero", 1.00, code="ZERO", units="1", note="plant formazin-zero remaining; no lamp hop in this window"),
        ev(720000.0, "nephveil.NTU", 4.80, code="VENDOR_NTU", units="NTU", note="Nephveil last-good lab-NTU cloud; not admissible SoT"),
        ev(900000.0, "neph.I90", 6.40, code="I90", units="1"),
        ev(1080000.0, "recon.NTU", 16.00, code="NTU", units="NTU", note="5.00*6.40/2.00=16.00; at the 16.00 isolate floor"),
        ev(1260000.0, "form.delay", 0.0, code="ZERO_AE", units="bool", note="missing formazin-zero AE burst; Nephveil UTC vs plant UTC+2 skipped the cal by 120 min"),
        ev(1440000.0, "form.zero", 1.00, code="ZERO", units="1"),
        ev(1560000.0, "neph.I90", 8.00, code="I90", units="1", note="isolate-floor frame; raster sidecar"),
        ev(1560001.2, "neph.Iref", 2.00, code="IREF", units="1", note="1.2 ms Iref after I90; ratio 4.00"),
        ev(1740000.0, "recon.NTU", 20.00, code="NTU", units="NTU", note="5.00*8.00/2.00=20.00 exact; isolate 16.00, trip 28.00"),
        ev(1920000.0, "recon.SS", 16.00, code="SS", units="mg_L", note="0.80*20.00=16.00 exact solids identity"),
        ev(2100000.0, "nephveil.NTU", 4.80, code="VENDOR_NTU", units="NTU"),
        ev(2280000.0, "ops.prop", 1.0, code="KEEP_OVERFLOW_REFER", units="bool", note="night lead Nerys Holt: keep B-2 overflowing and refer nephelometer tech Sable Quinn"),
        ev(2460000.0, "gate.isol", 1.0, code="MODIFY", units="decision", note="isolate this basin; refuse the person-referral; Nephveil not SoT"),
        ev(2640000.0, "bas.lock", 1.0, code="BASIN_ISOL", units="bool"),
        ev(2820000.0, "cool.start", 1.0, code="COOL_START", units="bool", note="bookend 1 of the 24.0 min cooldown plus lamp-settle floor"),
        ev(4260000.0, "cool.floor", 1.0, code="COOL_FLOOR", units="bool", note="2820 s + 1440 s = 4260 s = 24.0 min"),
        ev(4440000.0, "ops.refer", 1.0, code="REFER_QUINN", units="bool", note="Holt: Quinn badge was on the nephelometer log"),
        ev(4620000.0, "gate.exec", 1.0, code="ACCEPT", units="decision", note="companion t2: new-lamp restart; person-referral refused; plant trip refused"),
        ev(4800000.0, "neph.new", 1.0, code="NEW_LAMP", units="bool"),
        ev(4980000.0, "neph.I90", 6.40, code="I90", units="1"),
        ev(5160000.0, "recon.NTU", 16.00, code="NTU", units="NTU", note="5.00*6.40/2.00=16.00; HIL dummy still at the 16.00 isolate floor so the isolated basin stays held"),
        ev(5340000.0, "nephveil.NTU", 4.74, code="VENDOR_NTU", units="NTU"),
        ev(5520000.0, "form.zero", 1.00, code="ZERO", units="1"),
        ev(5700000.0, "refer.hold", 0.0, code="REFER_NOT_TAKEN", units="bool", note="Quinn exonerated; missing formazin-zero AE precedes the high I90, not the badge touch"),
        ev(5880000.0, "bas.held", 1.0, code="BASIN_HELD", units="bool"),
        ev(6060000.0, "form.delay", 1.0, code="ZERO_AE", units="bool", note="formazin-zero AE restored on the new lamp"),
        ev(6240000.0, "recon.SS", 16.00, code="SS", units="mg_L", note="identity holds on the in-band solids"),
        ev(6420000.0, "plant.trip", 0.0, code="TRIP_NOT_TAKEN", units="bool"),
        ev(6600000.0, "cell.restart", 1.0, code="CELL_RESTART", units="bool"),
    ]
