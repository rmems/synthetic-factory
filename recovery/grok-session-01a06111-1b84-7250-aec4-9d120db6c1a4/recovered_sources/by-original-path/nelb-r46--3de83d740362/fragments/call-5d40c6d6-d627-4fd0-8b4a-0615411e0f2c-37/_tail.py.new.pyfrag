# ---------------------------------------------------------------------------
# Record 140 — ultrasonic TOFD remaining ligament of a hydrocracker weld, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_140():
    t_nom = 20.00
    c_mmus = 5.00
    dt_us = 4.00
    d_rem = t_nom - c_mmus * dt_us / 2.0
    _exact(d_rem, 10.00)
    _exact(t_nom - c_mmus * 2.00 / 2.0, 15.00)
    _exact(t_nom - c_mmus * 3.20 / 2.0, 12.00)
    _exact(t_nom - c_mmus * 3.60 / 2.0, 11.00)
    c_id = 2.0 * (t_nom - d_rem) / dt_us
    _exact(c_id, 5.00)
    _exact(2.0 * (20.00 - 10.00) / 4.00, 5.00)
    fd = 2.00 * d_rem
    _exact(fd, 20.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202609140,
        source="bx5.tofd.tippair",
        target="bitternex.weld_isolate_core",
        table=[
            {"from": "tofd_dt", "to": "ligament_estimator", "weight": 1.35},
            {"from": "tofd_snr", "to": "tip_norm_core", "weight": 1.20},
            {"from": "difveil_d", "to": "vendor_continue_advocate", "weight": 0.40},
