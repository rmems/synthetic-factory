        },
        channel_prefix="tofd.n",
        anchor="BX-5 HIL coupon 32 ms frame at dt 4.00 us / SNR 14.0 (t_s 1560) reconstructing 10.00 mm remaining ligament below the 14.00 mm isolate floor",
    )
    w_s = 0.032
    events = [
        ev(0.0, "tofd.dt", 2.00, code="DT_US", units="us", note="HIL TOFD crack-tip pair on a dummy coupon in TOFD-HIL-6; hydrocracker weld ligament, not PAUT TFM girth, not Lamb-wave LUT, not DCPD, not MsS T(0,1), not ECA FSW"),
