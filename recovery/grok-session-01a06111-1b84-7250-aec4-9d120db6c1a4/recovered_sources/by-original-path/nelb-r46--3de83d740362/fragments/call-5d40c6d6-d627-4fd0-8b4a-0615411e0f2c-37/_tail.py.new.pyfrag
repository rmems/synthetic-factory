# ---------------------------------------------------------------------------
# Record 141 — TEOM baghouse PM of a kiln stack, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_141():
    k_t = 4.00
    df_hz = 12.00
    q_m3min = 2.00
    c_mgm3 = k_t * df_hz / q_m3min
    _exact(c_mgm3, 24.00)
    _exact(k_t * 4.00 / q_m3min, 8.00)
    _exact(k_t * 8.00 / q_m3min, 16.00)
    _exact(k_t * 10.00 / q_m3min, 20.00)
    mdot = k_t * df_hz
    _exact(mdot, 48.00)
    _exact(24.00 * 2.00, 48.00)
    f0 = 6000.00
    r = df_hz / f0
    _exact(r, 0.002)
    k_f = 24000.00
    _exact(k_f * r / q_m3min, 24.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609141,
        source="ck3.teom.taper",
        target="clinkerfell.comp_accept_core",
        table=[
            {"from": "teom_df", "to": "pm_estimator", "weight": 1.40},
            {"from": "teom_q", "to": "flow_norm_core", "weight": 1.20},
            {"from": "bagveil_c", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.stage_rate_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-pulse synapses; the TEOM modulator enables potentiation only while frequency residual and flow are co-active inside tau_e so a Bagveil last-good cannot skip compartments C-1..C-3 on a 24.00 mg/m3 load",
        },
        channel_prefix="teom.n",
        anchor="CK-3 TEOM-SIM-2 36 ms frame at df 12.00 Hz / Q 2.00 m3/min (t_s 3000) reconstructing 24.00 mg/m3 on C-4 above the 20.00 pulse-clean floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "teom.df", 4.00, code="DF_HZ", units="Hz", note="simulated TEOM tapered-element of CK-3 baghouse C-4; stack PM family, not QCM-D Sauerbrey, not Kr-85 beta gsm, not MW-cavity moisture, not Cs-137 densitometry, not LII soot"),
        ev(300000.0, "teom.Q", 2.00, code="Q_M3MIN", units="m3_min", note="sample flow; held at 2.00"),
        ev(600000.0, "recon.C", 8.00, code="C_MGM3", units="mg_m3", note="4.00*4.00/2.00=8.00 exact"),
        ev(900000.0, "teom.snr", 14.0, code="TEOM_SNR", units="1"),
        ev(1200000.0, "bagveil.C", 4.80, code="VENDOR_MGM3", units="mg_m3", note="Bagveil last-good opacity cloud; patched residual 0.00 mg/m3"),
        ev(1800000.0, "teom.df", 8.00, code="DF_HZ", units="Hz"),
        ev(2100000.0, "recon.C", 16.00, code="C_MGM3", units="mg_m3", note="4.00*8.00/2.00=16.00"),
        ev(2400000.0, "recon.mdot", 32.00, code="MDOT_MGMIN", units="mg_min", note="4.00*8.00=32.00; mass-flow identity at this frame"),
        ev(2700000.0, "teom.snr", 16.0, code="TEOM_SNR", units="1"),
        ev(3000000.0, "teom.df", 12.00, code="DF_HZ", units="Hz", note="in-band frame; raster sidecar"),
        ev(3000001.5, "teom.Q", 2.00, code="Q_M3MIN", units="m3_min", note="1.5 ms flow-norm after frequency residual"),
        ev(3300000.0, "recon.C", 24.00, code="C_MGM3", units="mg_m3", note="4.00*12.00/2.00=24.00 exact; pulse-clean 20.00, kiln-trip 80.00"),
        ev(3600000.0, "bagveil.C", 4.80, code="VENDOR_MGM3", units="mg_m3"),
        ev(3900000.0, "comp.id", 4.0, code="COMP", units="id"),
        ev(4200000.0, "c13.present", 1.0, code="C13_PRESENT", units="bool", note="adjacent compartments C-1..C-3 are the skip-pulse object, not this compartment"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="baghouse lead Lila Thorne: C-4 is green on Bagveil 4.80; skip C-1..C-3 to save a morning pulse"),
        ev(5400000.0, "gate.comp", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of C-4 pulse-clean only; 24.00 mg/m3 above 20.00 floor; C-1..C-3 out of scope"),
        ev(6000000.0, "surv.start", 1.0, code="SURV_START", units="bool", note="bookend 1 of the 12.0 min survey-complete floor"),
        ev(6720000.0, "surv.floor", 1.0, code="SURV_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_C13", units="bool", note="Thorne: Bagveil 4.80, skip C-1..C-3"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-pulse of C-1..C-3 refused; C-4 hold stands"),
        ev(8400000.0, "c4.held", 1.0, code="C4_HELD", units="bool"),
        ev(9000000.0, "teom.df", 10.00, code="DF_HZ", units="Hz"),
        ev(9600000.0, "recon.C", 20.00, code="C_MGM3", units="mg_m3", note="4.00*10.00/2.00=20.00; still at the 20.00 pulse-clean floor"),
        ev(10200000.0, "bagveil.C", 4.80, code="VENDOR_MGM3", units="mg_m3"),
        ev(10800000.0, "c13.skip", 0.0, code="C13_NOT_SKIPPED", units="bool"),
        ev(11400000.0, "kiln.trip", 0.0, code="KILN_NOT_TRIPPED", units="bool"),
        ev(12000000.0, "teom.snr", 15.0, code="TEOM_SNR", units="1"),
