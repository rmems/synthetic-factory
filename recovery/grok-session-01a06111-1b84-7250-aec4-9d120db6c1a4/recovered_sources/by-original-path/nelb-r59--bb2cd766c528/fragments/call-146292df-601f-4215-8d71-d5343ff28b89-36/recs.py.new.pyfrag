# ---------------------------------------------------------------------------
# Record 178 — UV-DOAS remaining SO2 of an SRU tail, designed, REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_178():
    k_d = 5.00
    i0 = 16.00
    i_iso = 4.00
    od = math.log2(i0 / i_iso)
    _exact(od, 2.00)
    t_k = 320.0
    t0_k = 320.0
    t_ratio = t_k / t0_k
    _exact(t_ratio, 1.000)
    p_ratio = 1.000
    c_ppm = k_d * od * t_ratio * p_ratio
    _exact(c_ppm, 10.00)
    _exact(k_d * math.log2(i0 / 8.00), 5.00)
    _exact(k_d * math.log2(i0 / 16.00), 0.00)
    _exact(k_d * math.log2(i0 / 2.00), 15.00)
    l_m = 1.00
    od_per_m = od / l_m
    _exact(od_per_m, 2.00)
    c_id = k_d * od_per_m * l_m
    _exact(c_id, 10.00)
    _exact(6000.0 + 1080.0, 7080.0)

    raster = make_raster(
        neurons=20,
        mean_rate_hz=50.0,
