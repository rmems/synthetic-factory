# ---------------------------------------------------------------------------
# Record 180 — load-cell remaining hopper mass of an FCC catalyst hopper,
# simulated, ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_180():
    k_m = 1.50
    u_mv = 8.00
    m_t = k_m * u_mv
    _exact(m_t, 12.00)
    _exact(k_m * 4.00, 6.00)
    _exact(k_m * 6.00, 9.00)
    _exact(k_m * 10.00, 15.00)
    t_min = 4.00
    du = 8.00 - 4.00
    mdot = k_m * (du / t_min)
    _exact(mdot, 1.50)
    _exact((12.00 - 6.00) / 4.00, 1.50)
    u_id = m_t / k_m
    _exact(u_id, 8.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609180,
        source="bf3.load.cell",
        target="birchfen.hopper_accept_core",
        table=[
            {"from": "load_U", "to": "mass_estimator", "weight": 1.40},
            {"from": "load_snr", "to": "cell_norm_core", "weight": 1.20},
            {"from": "cellveil_m", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.hopper_scope_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-weigh synapses; the load-cell modulator enables potentiation only while millivolt and SNR are co-active inside tau_e so a Cellveil last-good cannot skip hoppers H-1..H-3 on a 12.00 t remaining mass",
        },
        channel_prefix="load.n",
        anchor="BF-3 LOAD-SIM-2 36 ms frame at U 8.00 mV / SNR 16.0 (t_s 3000) reconstructing 12.00 t on H-4 above the 8.00 t weigh floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "load.U", 4.00, code="U_MV", units="mV", note="simulated strain-gauge load-cell of BF-3 hopper H-4; remaining-mass family, not Coriolis, not Cs-137 densitometry, not TEOM, not SPND, not He-3, not inductive oil-debris"),
        ev(300000.0, "load.snr", 10.0, code="LOAD_SNR", units="1", note="early cell SNR"),
        ev(600000.0, "recon.M", 6.00, code="M_T", units="t", note="1.50*4.00=6.00 exact"),
        ev(900000.0, "stand.dp", 8.0, code="DP_KPA", units="kPa", note="plant standpipe dP on a serial-only LAN; independent witness"),
        ev(1200000.0, "cellveil.M", 1.20, code="VENDOR_T", units="t", note="Cellveil last-good hopper cloud; patched residual 0.00 t"),
        ev(1800000.0, "load.U", 6.00, code="U_MV", units="mV"),
        ev(2100000.0, "recon.M", 9.00, code="M_T", units="t", note="1.50*6.00=9.00; over the 8.00 weigh floor"),
        ev(2400000.0, "recon.mdot", 1.50, code="MDOT_TMIN", units="t_min", note="1.50*((8.00-4.00)/4.00)=1.50 mass-flow identity at the isolate window"),
        ev(2700000.0, "load.snr", 14.0, code="LOAD_SNR", units="1"),
        ev(3000000.0, "load.U", 8.00, code="U_MV", units="mV", note="in-band frame; raster sidecar"),
        ev(3000001.5, "load.snr", 16.0, code="LOAD_SNR", units="1", note="1.5 ms cell-norm after millivolt"),
        ev(3300000.0, "recon.M", 12.00, code="M_T", units="t", note="1.50*8.00=12.00 exact; weigh 8.00, slide-kill 40.00"),
        ev(3600000.0, "cellveil.M", 1.20, code="VENDOR_T", units="t"),
        ev(3900000.0, "hop.id", 4.0, code="HOPPER", units="id"),
        ev(4200000.0, "h13.present", 1.0, code="H13_PRESENT", units="bool", note="adjacent hoppers H-1..H-3 are the skip-weigh object, not this hopper"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="catalyst lead Kell Brindle: H-4 is green on Cellveil 1.20; skip H-1..H-3 to save a morning weigh"),
        ev(5400000.0, "gate.hop", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of H-4 isolate only; 12.00 t above 8.00 floor; H-1..H-3 out of scope"),
        ev(6000000.0, "surv.start", 1.0, code="SURV_START", units="bool", note="bookend 1 of the 12.0 min survey-complete floor"),
        ev(6720000.0, "surv.floor", 1.0, code="SURV_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_H13", units="bool", note="Brindle: Cellveil 1.20, skip H-1..H-3"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-weigh of H-1..H-3 refused; H-4 hold stands"),
        ev(8400000.0, "h4.held", 1.0, code="H4_HELD", units="bool"),
        ev(9000000.0, "load.U", 10.00, code="U_MV", units="mV"),
        ev(9600000.0, "recon.M", 15.00, code="M_T", units="t", note="1.50*10.00=15.00; still at/over the 8.00 weigh floor"),
