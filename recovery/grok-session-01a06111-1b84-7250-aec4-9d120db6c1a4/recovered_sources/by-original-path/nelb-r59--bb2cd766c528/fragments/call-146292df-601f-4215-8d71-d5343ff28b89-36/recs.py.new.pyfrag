# ---------------------------------------------------------------------------
# Record 179 — aluminum-oxide remaining moisture of a chlorine dryer, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_179():
    k_x = 0.500
    v_v = 4.00
    x_ppmv = k_x * (2.0 ** v_v)
    _exact(x_ppmv, 8.00)
    _exact(k_x * (2.0 ** 2.00), 2.00)
    _exact(k_x * (2.0 ** 3.00), 4.00)
    _exact(k_x * (2.0 ** 5.00), 16.00)
    k_z = 32.00
    z_kohm = k_z / x_ppmv
    _exact(z_kohm, 4.00)
    _exact(k_z / 4.00, 8.00)
    _exact(k_z / 16.00, 2.00)
    x_id = k_z / z_kohm
    _exact(x_id, 8.00)
    _exact(2.0 ** v_v, 16.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202609179,
        source="ma6.alox.cap",
        target="marlfell.dryer_isolate_core",
        table=[
            {"from": "alox_V", "to": "moisture_estimator", "weight": 1.35},
            {"from": "alox_snr", "to": "cap_norm_core", "weight": 1.20},
            {"from": "oxveil_x", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.alox_bakeout_skip_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": "pre-post coincidence on keep-dryer synapses; the Al2O3 modulator depresses keep-dryer and referral links when probe voltage stays high inside tau_e of an SNR lock so an Oxveil last-good cannot hide 8.00 ppmv moisture or name Lise Quarn",
        },
        channel_prefix="alox.n",
        anchor="MA-6 HIL coupon 32 ms frame at V 4.00 / SNR 14.0 (t_s 1560) reconstructing 8.00 ppmv over the 6.00 ppmv isolate floor",
    )
    w_s = 0.032
    events = [
        ev(0.0, "alox.V", 2.00, code="V_V", units="V", note="HIL aluminum-oxide capacitive probe on a dummy chlorine dryer in AL2O3-HIL-3; remaining-moisture family, not chilled-mirror dew-point, not MW-cavity moisture, not THz-TDS, not QCM-D, not FDS tanδ, not CRNS"),
        ev(180000.0, "alox.snr", 9.0, code="ALOX_SNR", units="1", note="early probe SNR; isolate needs SNR>=12"),
        ev(360000.0, "recon.x", 2.00, code="X_PPMV", units="ppmv", note="0.500*2**(2.00)=2.00 exact"),
        ev(540000.0, "bake.out", 1.0, code="BAKE_AE", units="bool", note="plant bake-out AE present on the early frame"),
