        ev(1200000.0, "doasveil.C", 1.80, code="VENDOR_PPM", units="ppm", note="Doasveil vendor DOAS-cloud; infra owner; patched intensity timestamps"),
        ev(1800000.0, "doas.I", 8.00, code="I_AU", units="1"),
        ev(2100000.0, "recon.C", 5.00, code="C_PPM", units="ppm", note="5.00*log2(16.00/8.00)=5.00; still under the 6.00 isolate floor"),
        ev(2400000.0, "permit.slide", 40.00, code="PERM_S", units="s", note="permit clerk slid SRU-tail clock 40.00 s; collusion party"),
        ev(2700000.0, "path.T", 320.0, code="PATH_K", units="K", note="T/T0=1.000; no thermal hop in this window"),
        ev(3000000.0, "doas.I", 4.00, code="I_AU", units="1", note="isolate-floor frame; raster sidecar"),
        ev(3000001.4, "doas.snr", 12.0, code="DOAS_SNR", units="1", note="1.4 ms SNR lock after I; 12.0 >= 8.0"),
        ev(3300000.0, "recon.C", 10.00, code="C_PPM", units="ppm", note="5.00*log2(16.00/4.00)=10.00 exact; isolate 6.00, unit-kill 24.00"),
        ev(3600000.0, "recon.od", 2.00, code="OD", units="1", note="log2(16.00/4.00)=2.00 exact optical-depth identity"),
