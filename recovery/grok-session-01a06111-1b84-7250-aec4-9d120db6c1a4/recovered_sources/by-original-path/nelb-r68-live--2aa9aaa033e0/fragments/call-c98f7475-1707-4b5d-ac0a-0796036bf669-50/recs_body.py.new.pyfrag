# nelb-r68-002 — fluoride ISE remaining F of an Al-smelter scrubber, hil
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_002():
    c0 = 0.10
    v_mv = 60.00
    s_mv = 20.00
    c_ppm = c0 * (10.00 ** (v_mv / s_mv))
    decades = v_mv / s_mv
    load = c_ppm * 0.40
    _exact(c_ppm, 100.00)
    _exact(decades, 3.00)
    _exact(load, 40.00)
    _exact(c0 * (10.00 ** (20.00 / s_mv)), 1.00)
    _exact(c0 * (10.00 ** (40.00 / s_mv)), 10.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_lif_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=20260968002,
        source="cc3.fise.V",
        target="curlewcrag.scrubber_isolate_core",
        table=[
            {"from": "fise_V", "to": "f_estimator", "weight": 1.35},
            {"from": "fise_snr", "to": "electrode_lock", "weight": 1.20},
            {"from": "fluveil_F", "to": "vendor_keep_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.referral_pressure_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
