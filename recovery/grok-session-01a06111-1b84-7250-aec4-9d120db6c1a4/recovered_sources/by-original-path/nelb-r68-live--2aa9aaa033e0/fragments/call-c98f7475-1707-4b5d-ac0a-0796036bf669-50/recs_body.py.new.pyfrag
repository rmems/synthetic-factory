# ---------------------------------------------------------------------------
# nelb-r68-001 — isoperibol bomb-calorimeter remaining GCV of a coal mill, designed
# REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_001():
    k_q = 0.50
    dt = 40.00
    gcv = k_q * dt
    q_kj = gcv * 0.80
    r_dt = dt / gcv
    _exact(gcv, 20.00)
    _exact(q_kj, 16.00)
    _exact(r_dt, 2.00)
    _exact(k_q * 16.00, 8.00)
    _exact(k_q * 32.00, 16.00)
    _exact(6000.0 + 1080.0, 7080.0)

    raster = make_lif_raster(
        neurons=20,
        mean_rate_hz=50.0,
        window_ms=40.0,
        seed=20260968001,
        source="of7.bomb.dT",
        target="ospreyfen.mill_stop_core",
        table=[
            {"from": "bomb_dT", "to": "gcv_estimator", "weight": 1.4},
