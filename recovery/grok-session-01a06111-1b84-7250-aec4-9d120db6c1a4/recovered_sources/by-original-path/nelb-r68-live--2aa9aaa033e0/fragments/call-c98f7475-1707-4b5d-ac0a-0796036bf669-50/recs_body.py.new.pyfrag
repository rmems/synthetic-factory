def rec_003():
    k_i = 0.40
    n_fr = 30.00
    d_um = k_i * n_fr
    r_nd = n_fr / d_um
    u_mms = d_um / 4.00
    _exact(d_um, 12.00)
    _exact(r_nd, 2.50)
    _exact(u_mms, 3.00)
    _exact(k_i * 20.00, 8.00)
    _exact(k_i * 24.00, 9.60)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_lif_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=20260968003,
        source="bh8.int.N",
        target="bitternshaw.runner_accept_core",
        table=[
            {"from": "int_N", "to": "piston_estimator", "weight": 1.30},
            {"from": "int_snr", "to": "heterodyne_norm", "weight": 1.10},
            {"from": "pistveil_d", "to": "vendor_skip_advocate", "weight": 0.42},
        ],
        third_factor={
            "modulator": "na.stage_rate_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": (
                "pre-post coincidence on skip-survey synapses; the heterodyne modulator depresses skip "
                "links when fringe count stays in-band inside tau_e of an SNR lock so a Pistveil last-good "
                "cannot hide a 12.00 um R-4 remaining piston or release R-1..R-3"
            ),
        },
        channel_prefix="int.n",
        anchor=(
            "BH-8 heterodyne 36 ms frame at N 30.00 fringes / SNR 12.0 "
            "(t_s 3000) reconstructing 12.00 um inside the 8.00-24.00 band"
        ),
        kernel_ms=[0.0, 1.5, 9.0, 21.0],
    )
    w_s = 0.036
    events = [
        ev(100.0, "int.N", 20.00, code="N_FR", units="fringe", note="simulated heterodyne laser-interferometer remaining piston of BH-8 hydro runner R-4 in INT-SIM-7; remaining-piston family, not Kaplan LDV, not LDA, not PIV, not ESPI, not DIC, not LVDT, not OFDR"),
        ev(300000.0, "int.snr", 7.0, code="INT_SNR", units="1"),
        ev(600000.0, "recon.d", 8.00, code="D_UM", units="um", note="0.40*20.00=8.00; at the 8.00 band floor"),
        ev(900000.0, "run.T", 18.0, code="T_C", units="C", note="plant runner RTD; independent witness; unread by Pistveil"),
        ev(1200000.0, "pistveil.d", 1.20, code="VENDOR_UM", units="um", note="Pistveil vendor HZ-3 last-good cloud; infra owner; under-read skip advocate"),
        ev(1500000.0, "int.u", 2.00, code="U_MMS", units="mm_s", note="8.00/4.00=2.00 early velocity identity"),
        ev(1800000.0, "int.N", 24.00, code="N_FR", units="fringe"),
        ev(2100000.0, "recon.d", 9.60, code="D_UM", units="um", note="0.40*24.00=9.60; in band"),
