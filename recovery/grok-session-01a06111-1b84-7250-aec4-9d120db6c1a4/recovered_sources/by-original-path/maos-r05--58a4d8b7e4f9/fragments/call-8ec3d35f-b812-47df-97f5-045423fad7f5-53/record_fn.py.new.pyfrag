    trace = math.exp(-DELAY_S / TAU_E_S)
    dws = (0.24, 0.21, 0.20)
    etas = tuple(abs(dw) / trace for dw in dws)
    w1, w2, w3 = 0.50 - dws[0], 0.44 - dws[1], 0.41 - dws[2]

