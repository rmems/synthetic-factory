        for e in spike_events
        if e["t_rel_ms"] * 1000.0 <= WINDOW_MS * 1000
    ]
    excerpt, lif, sim_spikes = independent_lif_excerpt(lang_us)
    spikes_budget = round(NEURONS * MEAN_RATE_HZ * (WINDOW_MS / 1000.0))
