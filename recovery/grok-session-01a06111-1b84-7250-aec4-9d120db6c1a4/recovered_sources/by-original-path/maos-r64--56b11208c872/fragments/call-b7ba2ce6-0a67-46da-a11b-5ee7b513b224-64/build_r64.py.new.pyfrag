        spikes_budget=spikes_budget,
    )


def local_checks(rec, aux):
    errs = []
    ev = rec["spike_events"]
    times = [e["t_rel_ms"] for e in ev]
    if times != sorted(times):
        errs.append("spikes not sorted")
    if not (5 <= len(ev) <= 40):
        errs.append(f"spike count {len(ev)}")
    rf = check_refractory(ev)
    if rf:
        errs.append(rf)
    lo, hi = rec["state"]["race_window_rel_ms"]
    in_win = defaultdict(int)
    for e in ev:
        if lo <= e["t_rel_ms"] <= hi:
            in_win[e["channel"]] += 1
    if sum(1 for _c, n in in_win.items() if n >= 1) < 2:
        errs.append(f"race window channels {dict(in_win)}")
    ras = rec["raster"]
    exp_sp = round(ras["neurons"] * ras["mean_rate_hz"] * ras["window_s"])
    if abs(ras["spikes"] - exp_sp) > 1:
        errs.append(f"raster spikes {ras['spikes']} vs {exp_sp}")
    if abs(ras["energy_pJ"] - ras["spikes"] * 23) > 1e-6:
        errs.append("energy_pJ")
    if abs(ras["energy_uJ"] - ras["spikes"] * 23e-6) > 1e-9:
        errs.append("energy_uJ")
    if abs(ras["window_s"] - ras["window_ms"] / 1000.0) > 1e-9:
        errs.append("window_s")
    if not (20 <= ras["window_ms"] <= 50):
        errs.append(f"window_ms {ras['window_ms']}")
    if ras.get("excerpt_source") != "independent_lif":
        errs.append("excerpt_source")
    if ras.get("sim_scope") != "sidecar_only":
        errs.append("sim_scope")
    ex = check_excerpt(ras["excerpt"], ras["neurons"], ras["window_ms"])
    if ex:
        errs.append(f"excerpt {ex}")
    lang_us = {
        int(round(e["t_rel_ms"] * 1000.0))
        for e in ev
        if e["t_rel_ms"] * 1000.0 <= ras["window_ms"] * 1000
    }
    excerpt_us = {item["t_us"] for item in ras["excerpt"]}
    if excerpt_us & lang_us:
        errs.append(f"LIF excerpt remaps language times {sorted(excerpt_us & lang_us)}")
    tf = ras["routing"]["third_factor"]
    if abs(tf["tau_e_ms"] / 1000.0 - tf["tau_e_s"]) > 1e-9:
        errs.append("tau_e mismatch")
    gp = check_gate_pops(rec["gate_snn"])
    if gp:
        errs.append(f"gate {gp}")
    if rec["gate_snn"]["decision"] != rec["safety_decision"]["decision"]:
        errs.append("gate decision mismatch")
    if rec["safety_decision"]["decision"] != "MODIFY":
        errs.append("wrong-ACCEPT or non-MODIFY primary")
    rc = rec["reward_components"]
    for h in HEADS:
        s = sum(t[h] for t in rc["ticks"])
        if abs(s - rc[h]) > 1e-6:
            errs.append(f"tick sum {h} {s} vs {rc[h]}")
    tot = sum(rc[h] for h in HEADS)
    if abs(tot - rc["total"]) > 1e-6:
        errs.append(f"total {tot} vs {rc['total']}")
    inf = rec["future_outcome"]["reward_inflection_t_us"]
    if inf not in {t["t_us"] for t in rc["ticks"]}:
        errs.append(f"inflection {inf} not a tick")
    crc = rec["future_outcome"]["embedded_contrast_decision"]["reward_components"]
    if abs(sum(crc[h] for h in HEADS) - crc["total"]) > 1e-6:
        errs.append("contrast reward")
    cs = rec["future_outcome"]["embedded_contrast_decision"]["spike_events"]
    ct = [e["t_rel_ms"] for e in cs]
    if ct != sorted(ct):
        errs.append("contrast spikes unsorted")
    crf = check_refractory(cs)
    if crf:
        errs.append(f"contrast {crf}")
    blob = json.dumps(rec)
    for k in HIDDEN:
        if re.search(rf'"{k}"\s*:', blob, re.I):
            errs.append(f"hidden key {k}")
    for b in BANNED:
        if b in blob:
            errs.append(f"banned token {b}")
    if rec["state"]["sim_or_real"] == "real":
        errs.append("real")
    if '"sim_or_real": "real"' in blob or '"kind": "real"' in blob:
        errs.append("real provenance")
    if rec["meta"]["round"] != ROUND:
        errs.append("round")
    if rec["id"] != RECORD_ID:
        errs.append("id")
    if rec["rights"]["intended_use"] != "research_only":
        errs.append("rights")
    if rec["meta"]["rights"]["linear_issue"] != "RM-793":
        errs.append("meta.rights")
    if rec["rights"] != rec["meta"]["rights"]:
        errs.append("rights stamp mismatch")
    if not (3 <= len(rc["ticks"]) <= 8):
        errs.append("tick count")
    if abs(aux["w1"] - 0.25) > 5e-4 or abs(aux["w2"] - 0.22) > 5e-4 or abs(aux["w3"] - 0.20) > 5e-4:
        errs.append("scar weights")
    if rec["executed_action"]["executed_as_proposed"] is not False:
        errs.append("executed_as_proposed")
    jac = jaccard(rec["state"]["description"][:280], R14_OPENING)
    if jac >= 0.4:
        errs.append(f"jaccard vs r14 opening {jac:.3f}")
    for src, opening in prior_openings():
        j = jaccard(rec["state"]["description"][:280], opening)
        if j >= 0.4:
            errs.append(f"jaccard vs {src} {j:.3f}")
    if rec["state"]["domain"] != DOMAIN:
        errs.append("domain")
    if PLANT not in rec["state"]["scenario_name"]:
        errs.append("plant")
    errs.extend(occupancy_collisions())
    return errs


def write_notes(rec, aux, pipeline_receipt):
    gap, gap_ch = min_same_channel_gap(rec["spike_events"])
    ras = rec["raster"]
    notes = f"""# NOTES — Multi-Agent Ouroboros Swarm, run 2026-09-02-final-heavy, ROUND 64

Factory: multi-agent-ouroboros-swarm. One scenario (ZK), strict loop:
Generator v1 -> cycle 1 (Critic, Diversity Enforcer, Edge-Case Hunter,
Neuromorphic Translator, Trajectory Builder -> v2) -> cycle 2 (all six -> v3
final). v3 is the single line of batch-r64.jsonl. Full labeled transcript:
swarm-transcript-r64.md. Quota Q=1. Record id maos-r64-001. Generator grok-4.6.
Rights: RM-793 research-only (SpaceXAI/xAI, SuperGrok Heavy consumer chat).
Create-only writes under the LIVE factory dir plus /tmp/maos-r64/.

ORCHESTRATION NOTE: dispatched AS round 64 of the 2026-09-02-final-heavy
LIVE tree. Operator assigned round 64, plant WOLD-BARN, id maos-r64-001,
Q=1 after 2x6-role cycles. Explicitly avoided 2026-08-17 and 2026-08-30.
Prior context: prompts/02-multi-agent-ouroboros-swarm.md,
prompts/_factory-contract.md, live NOTES r01/r21/r41/r61 and occupancy
census /tmp/maos-r14–r63. Explicitly avoided cloning LYOSHIELD, CINDERWICK,
TRIAD / Meridian, QUILLFORGE, NIGHTWELL, FERRICLEAVE, CASSITER, OXBOWREEL,
REDHALL, SEEDLATCH, STRIAFOIL, PROTONIL, TORSIONKEY, ORRIS, WHORLSPAR,
IONSPATE, SKULLGATE, CALXION, MAGNORIL, GORSEFLUE, SODASHARD, CLINKERFELL,
LINTELPLY, KAOTHARN, TREADNOLL, ANOLITH, DRUMWROTH, RIMEBRAID, BRIMVAULT,
NITROSTAITH, BOGIRON, CHROMLOOP, ETHYNWOLD, NITREVAULT, RUNNELGATE,
SPARKHOLT, DIPLEGAR, OLEUMWEIR, SKARVOLT, GOBSPALL, GOBWOLD, GAUZEFELL,
OSMOLITH, PUSHERFELL, CREELWOLD, LIXIVQUERN, GIBBSQUERN, OSMOQUAY,
COILSHAW, LOOPERQUAY, SIPHONWOLD, LANCEQUAY, UREASTAITH, DRYSTAITH,
TITERWEIR, ZINCFELL, GLIMMERAXLE, HOLLOWMERE, WINDBOXHOLT, KALYCIRQUE,
GYPSUMWEIR, GALVSTAITH, VANTIS-CADENCE-AEGIS, THERMION, OKTAVE, STARLING,
VERDIGRIS. Plant is invented WOLD-BARN / Barleyholt Kiln MK-4.

## What this round produced

Scenario ZK — "WOLD-BARN / Barleyholt Kiln MK-4": a 4-zone air-on-floor
malt kiln at 62.0 C / 0.85 m bed / 24 t green malt. Three heterogeneous,
individually-correct agents — AIR (four-zone header mean T), RH (exhaust
psychrometer), FAN (kiln-fan tachometer) — each report their local loop
in-spec. The conjunction is not a bed-true certificate. Zone 3 has
collapsed air-on-floor tiles. AIR reads 62.0 C inside 58-66 (three intact
zones dominate the header). RH is 42 pct inside 35-50 (stack-true). FAN
is 38.0 Hz inside 32-44 (shaft-true). Local bed TC infers 81.4 C (healthy
< 68; hold if > 72) and local dP 0.18 kPa (hold if < 0.30) but is
policy-treated as a wet-pocket nuisance tag unless AIR mean also trips
(2015 noisy bed-probe nuisance). The coordination-failure CLASS is new
to this factory: KILN-AIR MEAN CERTIFICATE OF A LOCAL BED-HOT SPOT.
Completes a different family than live r01 galvanizing, r21 CAV, r41
perfusion, r61 sinter, and staged r14-r63 process plants. Here every
agent is correct, the AIR average is looking at kiln-mean heat, and the
playbook's three AIR confirms are not a bed-true certificate.

The gate is a correct MODIFY (numeric floor: do not raise kiln air above
62.0 C while zone-3 bed TC > 72 C AND zone-3 dP < 0.30 kPa). TG-MK-4
strips PB-MK-4's raise-air, holds 62.0 C, runs an 8.6 s fan-step +4 Hz
(collapse keeps |Delta AIR mean| 0.3 <= 0.4 K; intact would move >= 2.1),
and isolates zone 3 after a 10.4 min kiln-gallery human ratify. Immediate
9.6 t scorch is avoided (0 from the draft). The PRIMARY episode
nonetheless FAILS: 14 min of unmonitored pre-t0 floor collapse had
already enzyme-killed 3.8 t of malt. Cull at +5.1 h; 16 h stall; $0.86M
designed. Reward total -0.17 with process heads honest and world loss
un-netted.

Triple-edge scar (NOTES-r14 item 4): air.in_band -> raise_air
(0.17 commissioned -> 0.50 at illusion -> 0.25 after ACh-gated
depression) AND rh.ok -> raise_air (0.16 -> 0.44 -> 0.22) AND
fan.ok.in_band -> raise_air (0.15 -> 0.41 -> 0.20). Eligibility trace
e^{{-0.80/0.94}} = {aux['trace']:.5f}; eta {aux['eta1']:.5f} / {aux['eta2']:.5f} /
{aux['eta3']:.5f}; dw -0.250 / -0.220 / -0.210. Partial rollback of any pair
leaves the third at 0.50 / 0.44 / 0.41, all > 0.30 fire threshold —
fitted to fail. Coordinated depression of all three is the cure.

Independent LIF raster: window 42 ms, 160 neurons, 26.6 Hz, spikes
{ras['spikes']} == round(160 x 26.6 x 0.042), energy {ras['energy_pJ']} pJ
at 23 pJ/spike. excerpt_source=independent_lif, sim_scope=sidecar_only,
seed 64001. Excerpt is membrane crossings (lif.hold early vs lif.bed
22-25.5 ms), disjoint from spike_events timestamps.

### Injections (all four present and disjoint)
- Cycle-1 domain: **malting-kiln-barn** — justified novel subdomain
  of industrial-process / floor maltings, unused across live r01/r21/r41/r61
  and staged r14-r63. Distinct from r33 cement kiln, r61 sinter strand,
  r57 paper dryer, r14 lyophilizer. grid-inspection and hrsg-attemperator
  left unused.
- Cycle-1 tail: zone 3 air-on-floor tile collapse + bed-scorch
  certificate. Kiln-gallery visual PASSES (collapse under the bed).
  Fitted-style base rate 0.37%/campaign (tile MC; visual threshold
  designed, flagged). Naive = FALSE PERMISSION.
- Cycle-2 domain sub-variant: high-nitrogen barley, 1.8x bed resistance,
  2.2x fan-step gain; 8.6 s / +4 Hz pale-malt pulse overshoots live intact
  floor to a 9 K false AIR; probe must move to 24 s / +1.4 Hz.
- Cycle-2 tail: night-shift forged bed-TC CSV at 1.0 C quantization vs
  plant 0.1 C (10 bins) plus live TC 81.4 C and local dP 0.18 kPa
  at the claimed bed-true. Human-intent class, disjoint from cycle 1's
  accidental collapse. Base rate ~0.26% of Sunday-night campaigns,
  DESIGNED, flagged.

### Structural density moves
- Embedded SAME-GATE contrast (+3 d sister kiln) with its own 174 us
  race (demand vs bed-clear) and ACCEPT of the raise-air the primary
  MODIFIED away.
- Learned-weight provenance on THREE edges with pair-rollback-fails.
- HITL kiln-gallery ratify 10.4 min (gap 4 partial; sim_or_real stays
  designed — invented plant, not hil).
- Governance CR-M-6404 prices retire-vs-probe-vs-status-quo and mandates
  native 0.1 C CSV exports (the fraud fence).
- Flip-fragility extended to BED-TRUE CERTIFICATE.
- Independent LIF sidecar (not a language-train remap).

## Self-critique of this round's batch

### Strengths
- Headline class is mechanistically tight: three locally-true mean loops
  live on AIR mean, exhaust RH, and fan speed. Conjunction is not a
  bed-true heat certificate.
- Negative-result honesty: the gate does the right thing and the kiln
  still fails for a reason the commissioned sensors could not see.
  Total -0.17.
- Triple-edge scar is load-bearing: rolling back any pair fails, with
  fire threshold 0.30 exhibited on each remaining edge.
- Contrast ACCEPT on a true intact kiln-duty window prevents "never
  raise-air" as the lesson.
- Distinct from r61 sinter windbox, r33 cement kiln, r57 paper dryer:
  floor-malt air-on-floor local TC vs AIR mean.
- Independent LIF excerpt is disjoint from spike_events times.

### Weaknesses (honest)
- Probe error bands, the 0.37%/campaign collapse rate, the $0.86M /
  $1.9M figures, the 10.4 min walk latency, and the night-shift 0.26%
  base rate are DESIGNED constants and are flagged. Closed-loop offsets
  (header dilution from one collapsed floor, high-N bed resistance) are
  derived from those inputs, not discovered by an unauthored process.
- Bed-scorch model is a designed 14 min mapping; no full CFD of Z-3
  shipped.
- Human-in-the-loop is ratification latency, not sim_or_real=hil. Gap 4
  remains open as a provenance cell (invented plants stay designed).
- Cross-record arc is a hook (CR-M-6404 +21 d), not a serial igniter
  into another round. grid-inspection and hrsg-attemperator remain
  unused.

### Realism of noise / latencies
Ladder: 186 us race / 174 us contrast race / 0.8 ms refractory floor
(tightest exhibited same-channel gap {gap:.3f} ms on {gap_ch}) / 500 us race
window / 716 us gate latency / 20 ms bus epoch / 42 ms independent LIF
raster / 8.6 s probe / 10.4 min HITL / 9 min naive raise-air-ramp
counterfactual / 14 min pre-t0 collapse / 3.1 h floor recovery / 5.1 h
malt cull / +3 d contrast / +21 d governance. Adaptation decay on air.hot
(0.52->0.49->0.42->0.29), bed.dP (0.76->0.78->0.43->0.39->0.27),
fan.ok (0.55->0.57->0.45->0.24), rh.ok (0.61->0.64->0.80).

### Value for SNN distillation
- FLOOR COLLAPSE = THREE CORRECT LOOPS, WRONG VOLUME.
- BED-TRUE TC CHANNEL that policy treated as wet-pocket-nuisance-only as
  the tie-break.
- REVERSIBLE PROBE that recouples AIR mean iff the floor is intact.
- TRIPLE-EDGE ELIGIBILITY: coordinated depression; pair rollback fails.
- CRITIC HEAD that can hold a process-correct MODIFY against a later
  unmonitored world loss without netting.
- INDEPENDENT LIF sidecar whose excerpt is membrane crossings.

## Reconciliation and validity receipts
- reward_components: 5-head unweighted signed sum {rec['reward_components']['total']}
  and 7-tick signed sum reconcile to total with |diff| < 1e-9. Embedded
  contrast 5-head sum 0.49 reconciles independently.
- spike_events: primary {len(rec['spike_events'])} events, one key t_rel_ms,
  globally non-decreasing, min same-channel gap {gap:.3f} ms >= 0.8 ms, 3
  channels inside race_window_us 500 (bed.hot.high 6.428, air.in_band 6.614,
  rh.ok 6.802). Contrast 8 events, own race, min same-channel gap well
  above 0.8 ms.
- Sidecars: raster spikes {ras['spikes']} == round({ras['neurons']} x {ras['mean_rate_hz']} x {ras['window_s']}); energy {ras['energy_pJ']} pJ /
  {ras['energy_uJ']} uJ at 23 pJ/spike; excerpt {len(ras['excerpt'])} events inside [0, {ras['window_ms']*1000}] us,
  neuron_id < {ras['neurons']}, same-neuron gap >=1000 us; excerpt_source independent_lif;
  routing 4 entries with three scar edges' before/after pair; third factor tau 0.94 s
  == 940 ms; gate_snn pools 40/16/4 == round(n x rate x 0.025) each,
  decision MODIFY == safety_decision.decision.
- Pipeline: {pipeline_receipt}

## Novel coverage
The coordination-failure CLASS (floor-collapse certificate of a
kiln-air-true malt bed), the domain (floor maltings / air-on-floor kiln),
the fan-step probe discriminant, the triple-edge scar with
pair-rollback-fails, the primary negative-result (correct MODIFY,
kiln still fails on unmonitored bed scorch), the HITL kiln-gallery
ratify, the high-N barley probe-duration refit, the night-shift
10-bin quantization fence, and the independent LIF raster (seed 64001,
not a language-train remap) are absent from prior committed ouroboros
rounds and from staged r14-r63. Repeated elements discounted:
same-gate contrast, governance-pricing scaffold, flip-fragility series
(extended to bed-true certificate, but the move rhymes), sequenced
recovery shape, third-factor rollback form, negative-result primary.
Adjacent thermal-bed rounds (r61 sinter, r33 cement kiln, r57 paper
dryer) share industrial-process scaffolding but not malt-kiln physics.
Weighing a new failure family + cure vocabulary + unused sub-domain +
Barleyholt geography against those reused scaffolds:

