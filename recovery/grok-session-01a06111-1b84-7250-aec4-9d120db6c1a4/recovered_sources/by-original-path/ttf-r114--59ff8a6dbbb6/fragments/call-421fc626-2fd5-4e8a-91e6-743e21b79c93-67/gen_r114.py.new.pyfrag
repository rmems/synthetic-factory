    for path in sorted(Path("/tmp").glob("ttf-r*/NOTES-r*.md")):
        rnd = path_round(path)
        if rnd == THIS_ROUND:
            continue
        try:
            txt = path.read_text(encoding="utf-8")
        except OSError:
            continue
        match = re.search(r"Domains this batch:\s*(.*)", txt)
        if match:
            domains.update(re.findall(r"`([^`]+)`", match.group(1)))
        # Later-round occupancy essays list in-flight r114 plants; only
        # earlier NOTES are a plant SoT.
        if rnd is not None and rnd < THIS_ROUND:
            plants.update(PLANT_RE.findall(txt))