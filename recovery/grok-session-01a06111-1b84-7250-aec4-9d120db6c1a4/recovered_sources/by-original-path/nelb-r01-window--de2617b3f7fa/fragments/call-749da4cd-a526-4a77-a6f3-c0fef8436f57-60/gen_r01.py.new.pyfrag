    _exact(math.sqrt(0.0 + 8.00 * 8.00 + 6.00 * 6.00), 10.00)
    _exact(math.sqrt(5.00 * 5.00 + 12.00 * 12.00 + 0.0), 13.00)
    _exact(math.sqrt(0.0 + 0.0 + 12.00 * 12.00), 12.00)
    _exact(4.00 * 4.00, 16.00)
