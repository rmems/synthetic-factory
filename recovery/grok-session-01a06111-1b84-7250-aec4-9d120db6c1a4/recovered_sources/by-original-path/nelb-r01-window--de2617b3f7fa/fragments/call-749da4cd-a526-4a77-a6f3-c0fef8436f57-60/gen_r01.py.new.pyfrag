            distillation_note="Leeb gate: serialized k_L*vr/vi plus SNR lock beats a vendor last-good patch; companion t2 is the skip-survey refusal, not a hardness re-vote",
        ),
    }
    traj2 = {
        "id": "nelb-r01-a3-t2",
        "state": {
            "sim_or_real": "simulated",
