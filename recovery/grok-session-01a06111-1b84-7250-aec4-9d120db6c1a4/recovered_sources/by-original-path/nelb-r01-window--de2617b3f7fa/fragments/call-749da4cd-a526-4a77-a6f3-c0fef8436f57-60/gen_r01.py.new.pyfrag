        ev(3480000.0, "recon.k", 4.00, code="K_ID", units="ppmv", note="24.00*2.00/12.00=4.00 exact k_k identity"),
        ev(3600000.0, "dryer.T", 12.0, code="DRYER_C", units="C", note="cooldown ramp; plant thermocouple tracks isolate, not Dryveil"),
        ev(3900000.0, "keidel.I", 10.00, code="I_UA", units="uA"),
        ev(4080000.0, "recon.ppm", 20.00, code="PPM_V", units="ppmv", note="4.00*10.00/2.00=20.00 exact; still over the 16.00 isolate floor"),
        ev(4260000.0, "cool.floor", 1.0, code="COOL_FLOOR", units="bool", note="2820 s + 1440 s = 4260 s = 24.0 min"),
        ev(4440000.0, "ops.refer", 1.0, code="REFER_PIKE", units="bool", note="Voss: Pike badge was on the Keidel log"),
        ev(4620000.0, "gate.exec", 1.0, code="ACCEPT", units="decision", note="companion t2: new-cell restart; person-referral refused; shop trip refused"),
        ev(4800000.0, "keidel.new", 1.0, code="NEW_CELL", units="bool"),
        ev(4980000.0, "keidel.I", 8.00, code="I_UA", units="uA"),
        ev(5040000.0, "keidel.snr", 13.0, code="KEI_SNR", units="1"),
        ev(5160000.0, "recon.ppm", 16.00, code="PPM_V", units="ppmv", note="4.00*8.00/2.00=16.00; HIL dummy still at the 16.00 isolate floor so the hold stands"),
        ev(5340000.0, "dryveil.ppm", 3.12, code="VENDOR_PPM", units="ppmv"),
        ev(5400000.0, "dryer.T", 8.0, code="DRYER_C", units="C"),
        ev(5520000.0, "cell.zero", 0.0, code="ZERO_UA", units="uA"),
        ev(5700000.0, "refer.hold", 0.0, code="REFER_NOT_TAKEN", units="bool", note="Pike exonerated; missing cell-zero AE precedes the high ppmv, not the badge"),
        ev(5880000.0, "dryer.held", 1.0, code="DRYER_HELD", units="bool"),
        ev(6060000.0, "cell.delay", 1.0, code="ZERO_AE", units="bool", note="cell-zero AE restored on the new Keidel cell"),
        ev(6180000.0, "dryveil.ppm", 3.08, code="VENDOR_PPM", units="ppmv"),
        ev(6240000.0, "recon.IQ", 6.00, code="I_OVER_Q", units="uA_slpm", note="identity holds on the in-band ratio; post-isolate I/Q=4.00"),
        ev(6360000.0, "recon.IQ", 4.00, code="I_OVER_Q", units="uA_slpm", note="8.00/2.00=4.00 on the post-isolate HIL dummy; 4.00*8.00/2.00=16.00"),
        ev(6420000.0, "shop.trip", 0.0, code="TRIP_NOT_TAKEN", units="bool"),
        ev(6600000.0, "cell.restart", 1.0, code="CELL_RESTART", units="bool"),
        ev(6720000.0, "dryer.dp", 0.80, code="DP_KPA", units="kPa", note="plant dryer dP transmitter tracks isolate, not Dryveil 3.08"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r01-a2-t1",
        "state": {
            "sim_or_real": "hil",
            "episode_id": "LF-KEIDEL-2026-0902",
            "domain": "keidel_p2o5_instrument_air",
            "setting": "Larkfen Instrument Air LF-8 (invented), dryer D-2 dummy cell in KEIDEL-HIL-4. Hardware-in-the-loop P2O5 Keidel cell supplies the remaining-ppmv that times the in-service keep-dryer stop. Plant-owned dryer thermocouple and dP transmitter. Dryveil vendor last-good dryer-cloud is the only OEM moisture SoT. Invented plant; HIL campaign. Not Al2O3 (r59), not chilled-mirror (r51), not coulometric KF (window r41), not WGM water (window r21), not MW-cavity (r26), not dielectric water-cut (r60).",
            "observables_at_decision": {
