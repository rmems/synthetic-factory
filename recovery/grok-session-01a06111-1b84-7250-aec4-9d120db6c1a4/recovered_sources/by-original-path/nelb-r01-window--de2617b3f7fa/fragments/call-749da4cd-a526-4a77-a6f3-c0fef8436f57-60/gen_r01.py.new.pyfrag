# ---------------------------------------------------------------------------
# Record a2 — P2O5 Keidel electrolytic remaining moisture of instrument air,
# hil, MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_a2():
    k_k = 4.00
    i_ua = 12.00
    q_slpm = 2.00
    ppmv = k_k * i_ua / q_slpm
    _exact(ppmv, 24.00)
    _exact(i_ua / q_slpm, 6.00)
    _exact(k_k * 4.00 / q_slpm, 8.00)
    _exact(k_k * 6.00 / q_slpm, 12.00)
    _exact(k_k * 8.00 / q_slpm, 16.00)
    _exact(k_k * 10.00 / q_slpm, 20.00)
    _exact(ppmv * q_slpm / i_ua, 4.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=20,
        mean_rate_hz=62.5,
        window_ms=32.0,
        seed=202609012,
        source="lf8.keidel.I",
        target="larkfen.dryer_isol_core",
        table=[
            {"from": "keidel_I", "to": "ppm_estimator", "weight": 1.40},
            {"from": "keidel_snr", "to": "cell_lock_core", "weight": 1.15},
            {"from": "dryveil_ppm", "to": "vendor_continue_advocate", "weight": 0.45},
        ],
        third_factor={
            "modulator": "ach.keidel_cellzero_skip_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": (
                "pre-post coincidence on keep-dryer synapses; the plant Keidel "
                "modulator depresses keep-running links when cell current stays "
                "high inside tau_e of an SNR lock so a Dryveil last-good cannot "
                "hide a 24.00 ppmv remaining-moisture slip"
            ),
        },
        channel_prefix="kei.n",
        anchor=(
            "LF-8 Keidel P2O5 32 ms frame at I 12.00 uA / Q 2.00 slpm / SNR 14.0 "
            "(t_s 1560) reconstructing 24.00 ppmv over the 16.00 isolate floor"
        ),
    )
    w_s = 0.032
    events = [
        ev(0.0, "keidel.I", 4.00, code="I_UA", units="uA", note="HIL P2O5 Keidel electrolytic moisture on a dummy instrument-air dryer in KEIDEL-HIL-4; remaining-ppmv family, not Al2O3, not chilled-mirror, not KF, not WGM, not MW-cavity, not dielectric water-cut"),
        ev(90000.0, "keidel.Q", 2.00, code="Q_SLPM", units="slpm", note="sample flow tracks the plant Keidel cell, not Dryveil 3.20"),
        ev(180000.0, "keidel.snr", 9.0, code="KEI_SNR", units="1", note="early cell SNR; isolate needs SNR>=12"),
        ev(360000.0, "recon.ppm", 8.00, code="PPM_V", units="ppmv", note="4.00*4.00/2.00=8.00 exact"),
        ev(450000.0, "keidel.I", 6.00, code="I_UA", units="uA", note="4.00*6.00/2.00=12.00 exact; still under the 16.00 isolate floor"),
        ev(450001.2, "keidel.snr", 10.0, code="KEI_SNR", units="1", note="1.2 ms SNR after I 6.00; isolate still needs SNR>=12"),
        ev(468000.0, "recon.ppm", 12.00, code="PPM_V", units="ppmv", note="4.00*6.00/2.00=12.00 exact"),
        ev(540000.0, "cell.zero", 0.0, code="ZERO_UA", units="uA", note="plant cell-zero remaining; no Keidel-scale hop in this window"),
        ev(720000.0, "dryveil.ppm", 3.20, code="VENDOR_PPM", units="ppmv", note="Dryveil last-good dryer-cloud; not admissible SoT"),
        ev(900000.0, "keidel.I", 8.00, code="I_UA", units="uA"),
        ev(1080000.0, "recon.ppm", 16.00, code="PPM_V", units="ppmv", note="4.00*8.00/2.00=16.00; at the 16.00 isolate floor"),
        ev(1170000.0, "recon.IQ", 4.00, code="I_OVER_Q", units="uA_slpm", note="8.00/2.00=4.00 exact I/Q identity at the floor frame"),
        ev(1260000.0, "cell.delay", 0.0, code="ZERO_AE", units="bool", note="missing cell-zero AE burst; Dryveil UTC vs plant UTC+2 skipped the canteen-clock zero"),
        ev(1440000.0, "cell.zero", 0.0, code="ZERO_UA", units="uA"),
        ev(1560000.0, "keidel.I", 12.00, code="I_UA", units="uA", note="isolate-floor frame; raster sidecar"),
        ev(1560001.2, "keidel.Q", 2.00, code="Q_SLPM", units="slpm", note="1.2 ms Q after I; I/Q 6.00"),
        ev(1560002.5, "keidel.snr", 14.0, code="KEI_SNR", units="1", note="1.3 ms after Q; isolate-frame SNR 14.0 >= 12.0"),
        ev(1620000.0, "dryer.T", 18.0, code="DRYER_C", units="C", note="plant dryer thermocouple on copper DCS; independent witness; unread by Dryveil"),
        ev(1740000.0, "recon.ppm", 24.00, code="PPM_V", units="ppmv", note="4.00*12.00/2.00=24.00 exact; isolate 16.00, trip 48.00"),
        ev(1860000.0, "dryveil.ppm", 3.20, code="VENDOR_PPM", units="ppmv"),
        ev(1920000.0, "recon.IQ", 6.00, code="I_OVER_Q", units="uA_slpm", note="12.00/2.00=6.00 exact; bridge-ratio identity"),
        ev(2100000.0, "dryveil.ppm", 3.20, code="VENDOR_PPM", units="ppmv"),
        ev(2160000.0, "cell.zero", 0.0, code="ZERO_UA", units="uA"),
