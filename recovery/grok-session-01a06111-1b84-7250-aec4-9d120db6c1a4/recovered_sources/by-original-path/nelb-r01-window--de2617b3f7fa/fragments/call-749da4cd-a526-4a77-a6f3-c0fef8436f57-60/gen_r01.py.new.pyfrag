            "tool": "gs2-leeb-roll-gate-cli",
            "observation": "HL 500.00 recomputes from vr 2.00 and vi 4.00; plant Leeb hashed; Leapveil channel not used as SoT; R-6 only",
        },
        "future_outcome": {
            "timeline": [
                {"t_s": 3000.0, "event": "Leeb vr 2.00 vi 4.00; raster frame; HL 500.00"},
                {"t_s": 4800.0, "event": "ops proposes ACCEPT-and-skip R-1..R-5"},
                {"t_s": 5400.0, "event": "bounded ACCEPT of R-6 isolate only"},
                {"t_s": 6000.0, "event": "12 min survey bookend 1"},
