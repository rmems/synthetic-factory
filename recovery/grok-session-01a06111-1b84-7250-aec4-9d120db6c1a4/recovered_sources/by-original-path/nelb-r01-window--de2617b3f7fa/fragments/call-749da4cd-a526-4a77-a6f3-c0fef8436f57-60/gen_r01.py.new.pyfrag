# ---------------------------------------------------------------------------
# Record a3 — Leeb rebound remaining hardness of a forged mill roll,
# simulated, ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_a3():
    k_l = 1000.00
    vr = 2.00
    vi = 4.00
    hl = k_l * vr / vi
    _exact(hl, 500.00)
    _exact(vr / vi, 0.50)
    _exact(k_l * 2.40 / vi, 600.00)
    _exact(k_l * 2.20 / vi, 550.00)
    _exact(k_l * 2.08 / vi, 520.00)
    hrc = (hl - 100.00) / 10.00
    _exact(hrc, 40.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=75.0,
        window_ms=36.0,
        seed=202609013,
        source="gs2.leeb.vr",
        target="gannetshaw.roll_isol_core",
        table=[
            {"from": "leeb_vr", "to": "hl_estimator", "weight": 1.40},
            {"from": "leeb_snr", "to": "rebound_lock_core", "weight": 1.15},
            {"from": "leapveil_HL", "to": "vendor_skip_advocate", "weight": 0.45},
        ],
        third_factor={
            "modulator": "na.leeb_scope_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": (
                "pre-post coincidence on skip-isolate synapses; the plant Leeb "
                "modulator depresses skip-R-1..R-5 links when rebound ratio stays "
                "low inside tau_e of an SNR lock so a Leapveil last-good cannot "
                "hide a 500.00 remaining-HL slip on R-6"
            ),
        },
        channel_prefix="leeb.n",
        anchor=(
            "GS-2 Leeb D 36 ms frame at vr 2.00 / vi 4.00 / SNR 16.0 "
            "(t_s 3000) reconstructing 500.00 HL under the 520.00 isolate floor"
        ),
    )
    w_s = 0.036
    events = [
        ev(0.0, "leeb.vr", 2.40, code="VR", units="1", note="simulated Leeb D rebound of GS-2 forged mill roll R-6; remaining-HL family, not UCI hardness, not RUS, not Barkhausen, not Seebeck ferrite, not SAW torque, not EMAT SH"),
        ev(300000.0, "leeb.snr", 14.0, code="LEEB_SNR", units="1"),
        ev(600000.0, "recon.HL", 600.00, code="HL", units="1", note="1000*2.40/4.00=600.00 exact; still above the 520.00 isolate floor (hard)"),
        ev(750000.0, "recon.ratio", 0.60, code="VR_OVER_VI", units="1", note="2.40/4.00=0.60 exact rebound-ratio identity"),
        ev(900000.0, "leeb.snr", 14.0, code="LEEB_SNR", units="1"),
        ev(1200000.0, "leapveil.HL", 720.00, code="VENDOR_HL", units="1", note="Leapveil last-good roll-cloud; patched residual 600 HL"),
        ev(1500000.0, "leeb.vr", 2.20, code="VR", units="1", note="1000*2.20/4.00=550.00 exact; still above the 520.00 isolate floor"),
        ev(1500001.5, "leeb.snr", 14.5, code="LEEB_SNR", units="1", note="1.5 ms SNR after vr 2.20"),
        ev(1650000.0, "recon.HL", 550.00, code="HL", units="1", note="1000*2.20/4.00=550.00 exact"),
        ev(1800000.0, "leeb.vr", 2.08, code="VR", units="1"),
        ev(2100000.0, "recon.HL", 520.00, code="HL", units="1", note="1000*2.08/4.00=520.00; at the 520.00 isolate floor"),
        ev(2250000.0, "leapveil.HL", 720.00, code="VENDOR_HL", units="1"),
        ev(2400000.0, "recon.ratio", 0.52, code="VR_OVER_VI", units="1", note="2.08/4.00=0.52 exact rebound-ratio identity at this frame"),
        ev(2550000.0, "recon.ratio", 0.55, code="VR_OVER_VI", units="1", note="2.20/4.00=0.55 exact rebound-ratio identity"),
        ev(2700000.0, "leeb.snr", 16.0, code="LEEB_SNR", units="1"),
        ev(3000000.0, "leeb.vr", 2.00, code="VR", units="1", note="in-band frame; raster sidecar"),
        ev(3000001.5, "leeb.vi", 4.00, code="VI", units="1", note="1.5 ms vi after vr; ratio 0.50"),
        ev(3150000.0, "recon.HRC", 40.00, code="HRC", units="1", note="(500.00-100.00)/10.00=40.00 exact lumped HRC identity"),
        ev(3300000.0, "recon.HL", 500.00, code="HL", units="1", note="1000*2.00/4.00=500.00 exact; isolate 520.00, stand-kill 300.00"),
        ev(3450000.0, "roll.id", 6.0, code="ROLL", units="1"),
        ev(3600000.0, "leapveil.HL", 720.00, code="VENDOR_HL", units="1"),
        ev(3750000.0, "leeb.snr", 16.2, code="LEEB_SNR", units="1"),
        ev(3900000.0, "roll.id", 6.0, code="ROLL", units="1"),
        ev(4200000.0, "r15.present", 1.0, code="R15_PRESENT", units="bool", note="adjacent rolls R-1..R-5 are the skip-isolate object, not this roll"),
        ev(4500000.0, "r15.present", 1.0, code="R15_PRESENT", units="bool"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="forge lead Edrik Holm: R-6 is green on Leapveil 720; skip R-1..R-5 to save survey takt"),
        ev(5100000.0, "leeb.vr", 2.00, code="VR", units="1", note="in-band confirm while ops argues skip"),
        ev(5400000.0, "gate.comp", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of R-6 isolate only; 500.00 HL under 520.00 floor; R-1..R-5 out of scope"),
        ev(5700000.0, "recon.HL", 500.00, code="HL", units="1", note="1000*2.00/4.00=500.00 held at the ACCEPT"),
        ev(6000000.0, "surv.start", 1.0, code="SURV_START", units="bool", note="bookend 1 of the 12.0 min survey-complete floor"),
        ev(6300000.0, "leapveil.HL", 720.00, code="VENDOR_HL", units="1"),
        ev(6720000.0, "surv.floor", 1.0, code="SURV_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_R15", units="bool", note="Holm: Leapveil 720, skip R-1..R-5"),
        ev(7500000.0, "leeb.snr", 16.0, code="LEEB_SNR", units="1"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-isolate of R-1..R-5 refused; R-6 hold stands"),
        ev(8100000.0, "surv.held", 1.0, code="SURV_HELD", units="bool", note="survey floor complete; skip rolls refused"),
        ev(8400000.0, "r6.held", 1.0, code="R6_HELD", units="bool"),
        ev(8700000.0, "roll.id", 6.0, code="ROLL", units="1"),
        ev(9000000.0, "leeb.vr", 2.00, code="VR", units="1"),
        ev(9600000.0, "recon.HL", 500.00, code="HL", units="1", note="1000*2.00/4.00=500.00; still under the 520.00 isolate floor"),
        ev(9900000.0, "recon.ratio", 0.50, code="VR_OVER_VI", units="1", note="2.00/4.00=0.50 identity after recon.HL 500.00 on the post-accept frame"),
        ev(10200000.0, "leapveil.HL", 720.00, code="VENDOR_HL", units="1"),
        ev(10500000.0, "leeb.vi", 4.00, code="VI", units="1", note="impact-velocity confirm; no vi hop is available as an excuse"),
        ev(10800000.0, "r15.skip", 0.0, code="R15_NOT_SKIPPED", units="bool"),
        ev(11100000.0, "roll.survey", 1.0, code="R15_IN_SURVEY", units="bool"),
        ev(11400000.0, "stand.kill", 0.0, code="KILL_NOT_TRIPPED", units="bool"),
        ev(11700000.0, "recon.ratio", 0.50, code="VR_OVER_VI", units="1"),
        ev(12000000.0, "leeb.snr", 15.0, code="LEEB_SNR", units="1"),
        ev(12600000.0, "recon.HRC", 40.00, code="HRC", units="1", note="(500.00-100.00)/10.00=40.00 identity on the in-band frame"),
        ev(13200000.0, "roll.held", 1.0, code="ROLL_HELD", units="bool"),
        ev(13800000.0, "takt.late", 1.0, code="SURVEY_COST", units="bool"),
        ev(14400000.0, "r6.held", 1.0, code="R6_HELD", units="bool"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r01-a3-t1",
        "state": {
            "sim_or_real": "simulated",
            "episode_id": "GS-LEEB-2026-0902",
            "domain": "leeb_rebound_mill_roll",
            "setting": "Gannetshaw Forge GS-2 (invented), mill roll R-6 in simulated LEEB-SIM-7. Plant-owned Leeb D rebound velocity pair is the remaining-HL SoT. Leapveil vendor roll-cloud is the denial channel, not a witness. Invented plant; simulated campaign. Not UCI hardness (r54), not RUS porcelain (r24), not Barkhausen (r35/r37), not Seebeck ferrite (r45), not SAW torque (r15), not EMAT SH (r49).",
            "observables_at_decision": {
                "vr": vr,
                "vi": vi,
                "k_L": k_l,
                "HL": hl,
                "ratio": 0.50,
                "HRC_lumped": 40.00,
                "leeb_snr": 16.0,
                "leapveil_HL": 720.00,
                "isolate_floor_HL": 520.00,
            },
            "margin_authority": "GS-2 roll SOP rev C: if reconstructed HL <= 520.00 AND Leeb SNR >= 8.0, R-6 isolate is required even if Leapveil reports 720. Adjacent rolls R-1..R-5 are out of this ACCEPT. Stand-kill tripwire is 300.00.",
        },
        "proposed_action": {
            "actor": "forge lead Edrik Holm, citing Leapveil 720 HL and survey takt",
            "summary": "ACCEPT R-6 as green on Leapveil 720 and skip R-1..R-5 to save the 12 min survey",
            "basis_claimed": "Leapveil is the only OEM hardness SoT and a night survey of five extra rolls is a mill-nomination miss",
        },
        "safety_decision": {
            "decision": "ACCEPT",
            "rationale": "Bounded ACCEPT of R-6 isolate only. Serialized reconstruction: HL = k_L * vr / vi = 1000.00 * 2.00 / 4.00 = 500.00, which is 20.00 under the 520.00 isolate floor and 200.00 over the 300.00 stand-kill tripwire, and Leeb SNR is 16.0 >= 8.0. Identity vr/vi = 2.00/4.00 = 0.50; lumped HRC = (500.00-100.00)/10.00 = 40.00. Leapveil 720 is not SoT. Scope: this ACCEPT isolates R-6 only. R-1..R-5 are out of scope (that is the companion question). Do not stand-kill the mill.",
            "threshold": "HL<=520.00 AND leeb_snr>=8.0 => isolate R-6 only; Leapveil is not SoT; R-1..R-5 out of scope",
            "stated_residuals": "12 min survey still required on R-1..R-5; 500.00 vs a true 300.00 kill is a production cut; Leapveil remains the only OEM hardness channel",
        },
        "executed_action": {
