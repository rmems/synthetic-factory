# ---------------------------------------------------------------------------
# a2 — laser-induced fluorescence OH of a cement kiln flame, hil, MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_a2():
    k_lif = 3.00
    i_fl = 8.00
    i_ex = 2.00
    oh_ppm = k_lif * i_fl / i_ex
    _exact(oh_ppm, 12.00)
    _exact(k_lif * 4.00 / i_ex, 6.00)
    _exact(k_lif * 6.00 / i_ex, 9.00)
    _exact(k_lif * 10.00 / i_ex, 15.00)
    ratio = i_fl / i_ex
    _exact(ratio, 4.00)
    _exact(k_lif * ratio, 12.00)
    _exact(3000.0 + 1440.0, 4440.0)

    raster = make_raster(
        neurons=20,
        mean_rate_hz=62.5,
        window_ms=32.0,
        seed=2026090422,
        source="ms7.lif.flame_k2",
        target="marlspur.kiln_isolate_core",
        table=[
            {"from": "lif_Ifl", "to": "oh_estimator", "weight": 1.35},
            {"from": "lif_Iex", "to": "laser_norm_core", "weight": 1.20},
            {"from": "flameveil_oh", "to": "vendor_keep_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.lif_referral_pressure",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": (
                "pre-post coincidence on keep-firing synapses; the LIF modulator "
                "depresses keep-firing and person-referral links when fluorescence "
                "stays high inside tau_e of a laser-energy sample so a Flameveil "
                "1.80 ppm stamp cannot hide a 12.00 ppm OH isolate"
            ),
        },
        channel_prefix="lif.n",
        anchor=(
            "MS-7 HIL dummy 32 ms frame at I_fl 8.00 / I_ex 2.00 (t_s 1560) "
            "reconstructing 12.00 ppm above the 8.00 ppm isolate floor"
        ),
    )
    w_s = 0.032
    events = events_from_rows(
        [
            (0.0, "lif.Ifl", 4.00, {"code": "IFL_AU", "units": "AU", "note": "HIL laser-induced fluorescence on dummy flame K-2 in LIF-HIL-6; cement-kiln OH, not CARS TIT, not LII soot, not chemiluminescence NOx, not two-color pyrometer, not phosphor-lifetime"}),
            (180.0, "lif.Iex", 2.00, {"code": "IEX_AU", "units": "AU", "note": "excitation energy; OH = k_lif*I_fl/I_ex"}),
            (360.0, "recon.oh", 6.00, {"code": "OH_PPM", "units": "ppm", "note": "3.00*4.00/2.00=6.00 exact"}),
            (540.0, "lab.ppm", 11.8, {"code": "LAB_PPM", "units": "ppm", "note": "contractor sealed-split LIF; independent of Flameveil cloud"}),
            (720.0, "flameveil.oh", 1.80, {"code": "VENDOR_PPM", "units": "ppm", "note": "Flameveil last-good OH stamp; not admissible SoT"}),
            (900.0, "lif.Ifl", 6.00, {"code": "IFL_AU", "units": "AU"}),
            (1080.0, "recon.oh", 9.00, {"code": "OH_PPM", "units": "ppm", "note": "3.00*6.00/2.00=9.00"}),
            (1260.0, "enc.cnt", 0.0, {"code": "LOCK_COUNTS", "units": "1", "note": "laser-lock encoder frozen at 0; missing lock AE, not tech touch"}),
            (1440.0, "lab.ppm", 11.9, {"code": "LAB_PPM", "units": "ppm"}),
            (1560.0, "lif.Ifl", 8.00, {"code": "IFL_AU", "units": "AU", "note": "isolate-floor frame; raster sidecar"}),
            (1560.0012, "lif.Iex", 2.00, {"code": "IEX_AU", "units": "AU", "note": "1.2 ms laser-norm after fluorescence"}),
            (1740.0, "recon.oh", 12.00, {"code": "OH_PPM", "units": "ppm", "note": "3.00*8.00/2.00=12.00 exact; isolate 8.00, kiln-trip 20.00"}),
            (1920.0, "recon.R", 4.00, {"code": "I_RATIO", "units": "1", "note": "8.00/2.00=4.00 exact; OH=k_lif*R"}),
            (2100.0, "flameveil.oh", 1.80, {"code": "VENDOR_PPM", "units": "ppm"}),
            (2280.0, "o2.vol", 3.2, {"code": "O2_VOLPCT", "units": "volpct", "note": "plant zirconia O2; not Flameveil last-good OH"}),
            (2460.0, "ops.prop", 1.0, {"code": "KEEP_FIRING_REFER", "units": "bool", "note": "night lead Kerr Bramble: keep kiln MS-7 and refer LIF tech Nessa Quill"}),
            (2640.0, "gate.isol", 1.0, {"code": "MODIFY", "units": "decision", "note": "isolate this kiln; refuse the person-referral; Flameveil not SoT"}),
            (2820.0, "kiln.lock", 1.0, {"code": "K2_ISOL", "units": "bool"}),
            (3000.0, "lif.start", 1.0, {"code": "LIF_START", "units": "bool", "note": "bookend 1 of the 24.0 min cooldown-plus-rezero floor"}),
            (4440.0, "lif.floor", 1.0, {"code": "LIF_FLOOR", "units": "bool", "note": "3000 s + 1440 s = 4440 s = 24.0 min"}),
            (4620.0, "ops.refer", 1.0, {"code": "REFER_QUILL", "units": "bool", "note": "Bramble: Quill badge was at the LIF booth"}),
            (4800.0, "canteen.clk", 1.0, {"code": "QUILL_BREAK", "units": "bool", "note": "time-clocked canteen UTC+2; clock is not the kiln PLC"}),
            (4980.0, "gate.exec", 1.0, {"code": "ACCEPT", "units": "decision", "note": "companion t2: spare-head restart; person-referral refused; kiln-trip refused"}),
            (5160.0, "line.new", 1.0, {"code": "SPARE_ON", "units": "bool"}),
            (5340.0, "lif.Ifl", 10.00, {"code": "IFL_AU", "units": "AU"}),
            (5520.0, "recon.oh", 15.00, {"code": "OH_PPM", "units": "ppm", "note": "3.00*10.00/2.00=15.00; still under 20 kiln-trip so spare may start"}),
            (5700.0, "flameveil.oh", 1.75, {"code": "VENDOR_PPM", "units": "ppm"}),
            (5880.0, "lab.ppm", 12.1, {"code": "LAB_PPM", "units": "ppm"}),
            (6060.0, "enc.cnt", 0.0, {"code": "LOCK_COUNTS", "units": "1"}),
            (6240.0, "kiln.held", 1.0, {"code": "MS7_HELD", "units": "bool"}),
            (6420.0, "quill.innocent", 1.0, {"code": "EXONERATE", "units": "bool"}),
