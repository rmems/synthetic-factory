            (6960.0, "recon.R", 5.00, {"code": "I_RATIO", "units": "1", "note": "10.00/2.00=5.00; 3.00*5.00=15.00"}),
            (7140.0, "o2.vol", 3.1, {"code": "O2_VOLPCT", "units": "volpct"}),
            (7320.0, "shell.T", 312.0, {"code": "SHELL_C", "units": "C"}),
            (7500.0, "spare.I", 0.80, {"code": "SPARE_PU", "units": "pu"}),
            (7680.0, "lif.Ifl", 4.00, {"code": "IFL_AU", "units": "AU"}),
            (7860.0, "recon.oh", 6.00, {"code": "OH_PPM", "units": "ppm", "note": "3.00*4.00/2.00=6.00"}),
            (8040.0, "lab.ppm", 12.0, {"code": "LAB_PPM", "units": "ppm"}),
            (8220.0, "flameveil.oh", 1.70, {"code": "VENDOR_PPM", "units": "ppm"}),
            (8400.0, "lock.skip", 1.0, {"code": "LOCK_AE_MISSING", "units": "bool", "note": "field-service skipped laser-lock AE; generator recovered without hanging Quill"}),
            (8580.0, "lif.snr", 14.0, {"code": "LIF_SNR", "units": "1"}),
            (8760.0, "kiln.lock", 1.0, {"code": "K2_ISOL", "units": "bool"}),
            (8940.0, "canteen.clk", 1.0, {"code": "QUILL_BREAK", "units": "bool"}),
            (9120.0, "spare.I", 1.00, {"code": "SPARE_PU", "units": "pu"}),
            (9300.0, "recon.oh", 6.00, {"code": "OH_PPM", "units": "ppm"}),
            (9480.0, "o2.vol", 3.0, {"code": "O2_VOLPCT", "units": "volpct"}),
            (9660.0, "lif.floor", 1.0, {"code": "LIF_FLOOR_HELD", "units": "bool"}),
            (9840.0, "quill.innocent", 1.0, {"code": "EXONERATE", "units": "bool"}),
            (10020.0, "kiln.esd", 0.0, {"code": "KILN_NOT_KILLED", "units": "bool"}),
            (10200.0, "shell.T", 308.0, {"code": "SHELL_C", "units": "C"}),
        ]
    )
    assert_stream(events)

    traj = {
