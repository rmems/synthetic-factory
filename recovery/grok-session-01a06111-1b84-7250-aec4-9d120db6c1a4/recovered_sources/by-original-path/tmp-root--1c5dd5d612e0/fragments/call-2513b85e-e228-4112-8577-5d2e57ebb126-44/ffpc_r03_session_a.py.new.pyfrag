def dumps(obj: object) -> str:
    return json.dumps(obj, indent=2, ensure_ascii=True, allow_nan=False) + "\n"


def walk_forbidden(obj: object, path: str = "$") -> None:
    if isinstance(obj, dict):
        for key, value in obj.items():
            if key in FORBIDDEN_KEYS:
                raise SystemExit(f"forbidden key {key!r} at {path}")
            walk_forbidden(value, f"{path}.{key}")
    elif isinstance(obj, list):
        for index, value in enumerate(obj):
            walk_forbidden(value, f"{path}[{index}]")


def reward_ok(rc: dict) -> None:
    siblings = {
        key: float(value)
        for key, value in rc.items()
        if key not in REWARD_EXCLUDE and isinstance(value, (int, float)) and not isinstance(value, bool)
    }
    total = float(rc["total"])
    recomputed = math.fsum(siblings.values())
    if abs(recomputed - total) > 1e-6:
        raise SystemExit(f"reward mismatch {total} != {recomputed} from {siblings}")


def diagnosis_md(state: dict, proposed: dict, root: str, cascade: str, catch: str, repair: str, delta: dict) -> str:
    context = dumps({"state": state, "proposed_action": proposed}).rstrip("\n")
    delta_text = dumps(delta).rstrip("\n")
    return (
        "# Diagnosis\n\n"
        "## Shared context\n\n"
        f"```json\n{context}\n```\n\n"
        f"## Root cause\n\n{root}\n\n"
        f"## Cascade effects\n\n{cascade}\n\n"
        f"## Supervisor catch\n\n{catch}\n\n"
        f"## Repair sketch\n\n{repair}\n\n"
        "## Target reward delta\n\n"
        f"```json\n{delta_text}\n```\n"
    )


