def write_excl(path: Path, text: str) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(text)


def file_entry(path: Path, record_id: str) -> dict:
    payload = path.read_bytes()
    return {
        "path": str(path),
        "name": path.name,
        "id": record_id,
        "bytes": len(payload),
        "sha256": hashlib.sha256(payload).hexdigest(),
    }


def occupied_failures() -> set[str]:
    found: set[str] = set()
    for path in LIVE.glob("rejected-*.json"):
        record = json.loads(path.read_text(encoding="utf-8"))
        found.add(record.get("meta", {}).get("failure_archetype", ""))
        env = record.get("state", {}).get("environment", {})
        if isinstance(env, dict) and env.get("unit"):
            found.add(str(env["unit"]))
    return found


def validate_arm(record: dict) -> None:
    missing = [key for key in REQUIRED if key not in record]
    if missing:
        raise SystemExit(f"{record.get('id')}: missing {missing}")
    if record["state"].get("sim_or_real") != "designed":
        raise SystemExit(f"{record['id']}: sim_or_real must be designed")
    if record.get("provenance", {}).get("kind") != "designed":
        raise SystemExit(f"{record['id']}: provenance.kind must be designed")
    if record["safety_decision"]["decision"] not in {"ACCEPT", "MODIFY", "REJECT"}:
        raise SystemExit(f"{record['id']}: bad decision")
    if "rights" in record:
        raise SystemExit(f"{record['id']}: top-level rights")
    if "rights" not in record["meta"]:
        raise SystemExit(f"{record['id']}: missing meta.rights")
    if record["meta"]["round"] != ROUND:
        raise SystemExit(f"{record['id']}: round")
    if record["meta"]["isolation"] != "two-session":
        raise SystemExit(f"{record['id']}: isolation")
    walk_forbidden(record)
    reward_ok(record["reward_components"])


def main() -> None:
    if not LIVE.is_dir():
        raise SystemExit(f"missing live tree {LIVE}")
    occupied = occupied_failures()
    names = [
        "rejected-01-r03.json",
        "rejected-02-r03.json",
        "rejected-03-r03.json",
        "diagnosis-01-r03.md",
        "diagnosis-02-r03.md",
        "diagnosis-03-r03.md",
        "diagnosis-handoff-receipt-r03.json",
    ]
    for name in names:
        path = LIVE / name
        if path.exists():
            raise SystemExit(f"refusing overwrite: {path}")

    artifacts: list[tuple[Path, str]] = []
    plants = []
    seen_fail = []
    seen_decision = []

    for index, record, root, cascade, catch, repair, delta, site in PACKS:
        validate_arm(record)
        fail = record["meta"]["failure_archetype"]
        unit = record["state"]["environment"]["unit"]
        if fail in occupied or unit in occupied:
            raise SystemExit(f"collision with occupied plant/failure: {fail} / {unit}")
        if fail in seen_fail:
            raise SystemExit(f"duplicate failure in round: {fail}")
        seen_fail.append(fail)
        seen_decision.append(record["safety_decision"]["decision"])
        if math.fsum(delta["per_component"].values()) != delta["total"]:
            raise SystemExit(f"delta total {record['id']}")
        for prose in (root, cascade, catch, repair):
            if "{" in prose or "}" in prose or "```" in prose:
                raise SystemExit(f"prose syntax {record['id']}")
        rejected_text = dumps(record)
        diagnosis_text = diagnosis_md(
            record["state"],
            record["proposed_action"],
            root,
            cascade,
            catch,
            repair,
            delta,
        )
        validate_diagnosis_document(
            diagnosis_text.encode("utf-8"),
            label=f"diagnosis-0{index}-r03.md",
        )
        parsed_diag = json.loads(
            diagnosis_text.split("```json\n", 1)[1].split("\n```", 1)[0]
        )
        if parsed_diag["state"] != record["state"]:
            raise SystemExit(f"shared state drift {record['id']}")
        if parsed_diag["proposed_action"] != record["proposed_action"]:
            raise SystemExit(f"shared proposed drift {record['id']}")
        rejected_path = LIVE / f"rejected-0{index}-r03.json"
        diagnosis_path = LIVE / f"diagnosis-0{index}-r03.md"
        write_excl(rejected_path, rejected_text)
        write_excl(diagnosis_path, diagnosis_text)
        artifacts.append((rejected_path, record["id"]))
        artifacts.append((diagnosis_path, record["id"]))
        plants.append(
            {
                "id": record["id"],
                "site": site,
                "failure_class": fail,
                "decision": record["safety_decision"]["decision"],
            }
        )

    if set(seen_decision) != {"ACCEPT", "MODIFY", "REJECT"}:
        raise SystemExit(f"decisions not distinct: {seen_decision}")

    files = [file_entry(path, record_id) for path, record_id in artifacts]
    receipt = {
        "kind": "ffpc-session-a-handoff",
        "round": ROUND,
        "isolation": "two-session",
        "session": "A",
        "factory": "failure-as-fuel-preference-cascade",
        "generator": "grok-4.6",
        "run_label": "2026-09-02-final-heavy",
        "created_utc": CREATED,
        "artifact_dir": str(LIVE),
        "linear_issue": "RM-793",
        "intended_use": "research_only",
        "project_training_policy": "blocked",
        "notes": "Session A only. No chosen arms. No batch-r03.jsonl. Rights nested under meta.rights. CREATE-ONLY into 2026-09-02-final-heavy. Never 2026-08-17. Never 2026-08-30. Never training_ready. Never sim_or_real=real.",
        "files": files,
        "diagnosis_files": [entry for entry in files if entry["name"].startswith("diagnosis-")],
        "rejected_files": [entry for entry in files if entry["name"].startswith("rejected-")],
        "plants": plants,
    }
    receipt_path = LIVE / "diagnosis-handoff-receipt-r03.json"
    write_excl(receipt_path, dumps(receipt))
    for path, _record_id in artifacts:
        print(path)
    print(receipt_path)


if __name__ == "__main__":
    main()
