            "tool": "ag7-fmcw-reline-gate-cli",
            "observation": "d 300.0 mm recomputes from dt 4.00 ns and er 4.00; cool lance staged; BOF-2 remains live as the isolate interlock",
        },
        "future_outcome": {
            "timeline": [
                {"t_s": 3000.0, "event": "FMCW dt 4.00 ns; raster frame; d 300.0 mm"},
