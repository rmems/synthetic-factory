        ev(10800000.0, "recon.d", 315.0, code="D_MM", units="mm", note="post-lance sample 4.20 ns; 3.00e8*4.20e-9/(2*2.00)=0.315 m = 315.0 mm; still under 320"),
        ev(11400000.0, "steam.p", 15.6, code="STEAM_BAR", units="bar"),
        ev(12600000.0, "bof1.skip", 0.0, code="BOF1_NOT_THIS_GATE", units="bool", note="BOF-1 remains a different gate; skip of BOF-2 was refused, not executed"),
        ev(13200000.0, "isolate.hold", 0.0, code="SHELL_SCRAP", units="bool", note="300 vs 180 mm isolate floor; shell scrap not taken"),
    ]
