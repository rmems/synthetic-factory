def _exact(a, b, eps=1e-12):
    if abs(a - b) > eps:
        raise RuntimeError(f"arith {a} != {b}")


# ---------------------------------------------------------------------------
# Record 100 — digital shearography of a composite pressure-hull panel
# designed, MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_100():
    lam_m = 5.00e-7
    s_m = 5.00e-3
    n_fringe = 8.00
    gamma_urad = 1e6 * lam_m * n_fringe / (2.0 * s_m)
    _exact(gamma_urad, 400.0)
    _exact(1e6 * lam_m * 4.00 / (2.0 * s_m), 200.0)
    _exact(1e6 * lam_m * 6.00 / (2.0 * s_m), 300.0)
    _exact(1e6 * lam_m * 5.60 / (2.0 * s_m), 280.0)
    _exact(7200.0 + 1200.0, 8400.0)

    raster = make_raster(
        neurons=20,
        mean_rate_hz=50.0,
