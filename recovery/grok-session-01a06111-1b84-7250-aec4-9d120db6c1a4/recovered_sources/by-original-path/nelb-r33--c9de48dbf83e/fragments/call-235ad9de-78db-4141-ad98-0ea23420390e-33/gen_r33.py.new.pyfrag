# Record 102 — FMCW microwave remaining lining of a BOF, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_102():
    c_m_s = 3.00e8
    dt_s = 4.00e-9
    er = 4.00
    n_idx = math.sqrt(er)
    d_m = c_m_s * dt_s / (2.0 * n_idx)
    _exact(n_idx, 2.00)
    _exact(d_m, 0.300)
    _exact(c_m_s * 6.00e-9 / (2.0 * n_idx), 0.450)
    _exact(c_m_s * 5.00e-9 / (2.0 * n_idx), 0.375)
    _exact(c_m_s * 4.20e-9 / (2.0 * n_idx), 0.315)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=40.0,
        seed=20260935,
        source="ag7.fmcw.bof2",
        target="ashgait.reline_core",
        table=[
            {"from": "fmcw_dt", "to": "thickness_estimator", "weight": 1.40},
            {"from": "fmcw_er", "to": "index_norm_core", "weight": 1.20},
            {"from": "kilnveil_mm", "to": "vendor_continue_advocate", "weight": 0.35},
        ],
        third_factor={
            "modulator": "ach.lining_wear_conflict",
            "tau_e_s": 2.2,
            "tau_e_ms": 2200.0,
            "eligibility": "pre-post coincidence on reline synapses; the FMCW modulator enables potentiation only while dielectric index is co-active inside tau_e so a Kilnveil last-campaign corridor cannot hide a 300 mm lining",
        },
        channel_prefix="fmcw.n",
        anchor="AG-7 FMCW 40 ms frame at dt 4.00 ns / er 4.00 (t_s 3000) reconstructing 300.0 mm below the 320 mm reline floor",
    )
    w_s = 0.040
    events = [
        ev(0.0, "fmcw.dt", 6.00, code="DT_NS", units="ns", note="simulated sealed BOF-2 path; FMCW microwave remaining lining, not acoustic pyrometry, not N-16 gamma TOF"),
        ev(300000.0, "fmcw.er", 4.00, code="ER", units="1", note="lining dielectric; n = sqrt(er)"),
        ev(600000.0, "recon.d", 450.0, code="D_MM", units="mm", note="3.00e8*6.00e-9/(2*2.00)=0.450 m = 450.0 mm exact"),
        ev(900000.0, "tc.C", 890.0, code="TC_C", units="C", note="shell thermocouple corridor"),
        ev(1500000.0, "kilnveil.mm", 430.0, code="VENDOR_MM", units="mm", note="Kilnveil last-campaign cloud; not FMCW TOF"),
        ev(1800000.0, "fmcw.dt", 5.00, code="DT_NS", units="ns"),
        ev(2100000.0, "recon.d", 375.0, code="D_MM", units="mm", note="3.00e8*5.00e-9/(2*2.00)=0.375 m = 375.0 mm"),
        ev(2400000.0, "shell.T", 1180.0, code="SHELL_C", units="C"),
        ev(2700000.0, "taps.n", 12.0, code="TAPS", units="count"),
        ev(3000000.0, "fmcw.dt", 4.00, code="DT_NS", units="ns", note="reline-floor frame; raster sidecar"),
        ev(3000001.5, "fmcw.er", 4.00, code="ER", units="1", note="1.5 ms index-norm after dt"),
        ev(3600000.0, "recon.d", 300.0, code="D_MM", units="mm", note="3.00e8*4.00e-9/(2*2.00)=0.300 m = 300.0 mm exact; reline floor 320"),
        ev(3900000.0, "recon.n", 2.00, code="N_IDX", units="1", note="sqrt(4.00)=2.00 exact"),
        ev(4200000.0, "tc.C", 910.0, code="TC_C", units="C"),
        ev(4500000.0, "kilnveil.mm", 420.0, code="VENDOR_MM", units="mm"),
        ev(4800000.0, "taphole.on", 1.0, code="TAPHOLE_STAGED", units="bool", note="taphole sleeve staged; out of BOF-2 reline scope"),
        ev(5100000.0, "ops.prop", 1.0, code="RELINE_AND_TAPHOLE", units="bool", note="furnace captain Nia Brindle: reline BOF-2 and change the taphole; 4 ns is a wet-gun glitch"),
        ev(5400000.0, "gate.reline", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT: BOF-2 this campaign; taphole refused"),
        ev(6000000.0, "lance.start", 1.0, code="LANCE_START", units="bool", note="bookend 1 of the 12.0 min cool-lance floor"),
        ev(6300000.0, "steam.p", 16.0, code="STEAM_BAR", units="bar"),
        ev(6600000.0, "recon.lock", 300.0, code="LOCKED_MM", units="mm"),
        ev(6720000.0, "lance.floor", 1.0, code="LANCE_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_RELINE", units="bool", note="Brindle: Kilnveil 420 mm, skip BOF-2 reline to save takt"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-reline refused; Kilnveil is last-campaign"),
        ev(8400000.0, "bof2.held", 1.0, code="BOF2_RELINE", units="bool"),
        ev(9000000.0, "taphole.held", 1.0, code="TAPHOLE_HELD", units="bool"),
