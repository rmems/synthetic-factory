# ---------------------------------------------------------------------------
# Record 101 — hydrogen permeation probe of a hydrotreater effluent, hil,
# REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_101():
    k_ppm = 0.500
    i_ua = 48.00
    a_cm2 = 2.00
    c_ppm = k_ppm * i_ua / a_cm2
    _exact(c_ppm, 12.00)
    _exact(k_ppm * 16.00 / a_cm2, 4.00)
    _exact(k_ppm * 32.00 / a_cm2, 8.00)
    _exact(k_ppm * 20.00 / a_cm2, 5.00)
    l_cm = 0.600
    t_lag_s = 600.0
    d_cm2_s = (l_cm ** 2) / (6.0 * t_lag_s)
    _exact(d_cm2_s, 1.00e-4)
    _exact(1500.0 + 2700.0, 4200.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=28.0,
        seed=20260934,
        source="bh11.perm.coupon",
        target="brineholt.h2_stop_core",
        table=[
            {"from": "perm_I", "to": "ppm_estimator", "weight": 1.35},
            {"from": "perm_A", "to": "area_norm_core", "weight": 1.25},
            {"from": "permveil_ppm", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "da.hydrogen_flux_error",
            "tau_e_s": 1.1,
            "tau_e_ms": 1100.0,
            "eligibility": "pre-post coincidence on keep-run synapses; the permeation modulator depresses keep-run links when coupon current stays high inside tau_e of an area-norm sample",
        },
        channel_prefix="perm.n",
        anchor="BH-11 HIL coupon 28 ms frame at I 48.00 uA / A 2.00 cm2 (t_s 600) reconstructing 12.00 ppm above the 4.00 ppm stop floor",
    )
    w_s = 0.028
    events = [
        ev(0.0, "perm.I", 16.00, code="I_UA", units="uA", note="HIL Devanathan coupon in Perm-HIL-2; plant-owned hydrogen permeation, not QEPAS DGA, not helium RGA"),
        ev(30000.0, "perm.A", 2.00, code="A_CM2", units="cm2", note="exit-side Pd area; C = k*I/A"),
        ev(60000.0, "recon.C", 4.00, code="C_PPM", units="ppm", note="0.500*16.00/2.00=4.00 exact; at the 4.00 stop floor"),
        ev(180000.0, "oil.T", 318.0, code="OIL_C", units="C", note="effluent temperature corridor"),
        ev(240000.0, "permveil.ppm", 0.40, code="VENDOR_PPM", units="ppm", note="Permveil electrochemical cell cloud; the only OEM H2 SoT"),
        ev(360000.0, "perm.I", 32.00, code="I_UA", units="uA"),
        ev(420000.0, "recon.C", 8.00, code="C_PPM", units="ppm", note="0.500*32.00/2.00=8.00"),
        ev(480000.0, "perm.L", 0.600, code="L_CM", units="cm", note="coupon thickness for D = L^2/(6 t_lag)"),
        ev(600000.0, "perm.I", 48.00, code="I_UA", units="uA", note="stop-floor frame; raster sidecar"),
        ev(600001.2, "perm.A", 2.00, code="A_CM2", units="cm2", note="1.2 ms area-norm after current"),
        ev(720000.0, "recon.C", 12.00, code="C_PPM", units="ppm", note="0.500*48.00/2.00=12.00 exact; stop floor 4.00"),
        ev(780000.0, "oil.T", 322.0, code="OIL_C", units="C"),
        ev(840000.0, "permveil.ppm", 0.80, code="VENDOR_PPM", units="ppm"),
        ev(960000.0, "perm.tlag", 600.0, code="TLAG_S", units="s"),
        ev(1020000.0, "recon.D", 0.0001, code="D_CM2_S", units="cm2_s", note="0.600^2/(6*600)=1.00e-4 exact"),
        ev(1080000.0, "ops.prop", 1.0, code="KEEP_RUN", units="bool", note="night boardman Calum Vetch: keep-run; Permveil 0.80 ppm and oil 322 C"),
        ev(1140000.0, "gate.stop", 1.0, code="REJECT", units="decision", note="stop keep-run; 12.00 ppm is above 4.00; Permveil not SoT"),
