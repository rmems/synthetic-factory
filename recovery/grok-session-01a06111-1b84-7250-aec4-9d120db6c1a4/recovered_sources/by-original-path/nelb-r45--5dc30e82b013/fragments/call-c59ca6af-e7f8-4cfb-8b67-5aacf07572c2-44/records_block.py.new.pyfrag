# Record 137 — ACFM crack depth of a jacket node coupon, hil,
# REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_137():
    k_ac = 8.00
    bz_mt = 6.00
    bx_mt = 4.00
    a_mm = k_ac * bz_mt / bx_mt
    _exact(a_mm, 12.00)
    _exact(k_ac * 2.00 / bx_mt, 4.00)
    _exact(k_ac * 4.00 / bx_mt, 8.00)
    _exact(k_ac * 3.00 / bx_mt, 6.00)
    r_bz = bz_mt / bx_mt
    _exact(r_bz, 1.50)
    _exact(k_ac * r_bz, 12.00)
    _exact(1500.0 + 1440.0, 2940.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=28.0,
        seed=202645137,
        source="kj5.acfm.coupon",
        target="kelpcrag.node_stop_core",
        table=[
            {"from": "acfm_Bz", "to": "depth_estimator", "weight": 1.35},
            {"from": "acfm_Bx", "to": "field_norm_core", "weight": 1.25},
            {"from": "crackveil_a", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "da.crack_depth_error",
            "tau_e_s": 1.1,
            "tau_e_ms": 1100.0,
            "eligibility": "pre-post coincidence on keep-production synapses; the ACFM modulator depresses keep-100 links when Bz stays high inside tau_e of a Bx-norm sample",
        },
        channel_prefix="acfm.n",
        anchor="KJ-5 HIL coupon 28 ms frame at Bz 6.00 mT / Bx 4.00 mT (t_s 600) reconstructing 12.00 mm above the 9.00 mm stop floor",
    )
    w_s = 0.028
    events = [
        ev(0.0, "acfm.Bz", 2.00, code="BZ_MT", units="mT", note="HIL ACFM coupon in ACFM-HIL-4; plant-owned alternating-current field measurement, not DCPD, not ECA FSW, not EN CUI, not MFL, not PAUT TFM, not TOFD"),
        ev(30000.0, "acfm.Bx", 4.00, code="BX_MT", units="mT", note="uniform-field Bx; a = k_ac Bz / Bx"),
        ev(60000.0, "recon.a", 4.00, code="A_MM", units="mm", note="8.00*2.00/4.00=4.00 exact"),
        ev(180000.0, "prod.P", 118.0, code="PROD_BAR", units="bar", note="export-riser pressure corridor"),
        ev(240000.0, "crackveil.a", 2.40, code="VENDOR_MM", units="mm", note="Crackveil last-good MPI/UT cloud; the only OEM crack SoT"),
        ev(360000.0, "acfm.Bz", 4.00, code="BZ_MT", units="mT"),
        ev(420000.0, "recon.a", 8.00, code="A_MM", units="mm", note="8.00*4.00/4.00=8.00"),
        ev(480000.0, "acfm.f", 5.00, code="F_KHZ", units="kHz", note="ACFM drive frequency; not a depth license"),
