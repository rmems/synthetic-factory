        ev(600001.2, "acfm.Bx", 4.00, code="BX_MT", units="mT", note="1.2 ms Bx-norm after Bz"),
        ev(720000.0, "recon.a", 12.00, code="A_MM", units="mm", note="8.00*6.00/4.00=12.00 exact; stop floor 9.00"),
        ev(780000.0, "node.T", 8.0, code="NODE_C", units="C"),
        ev(840000.0, "crackveil.a", 3.20, code="VENDOR_MM", units="mm"),
        ev(960000.0, "acfm.R", 1.50, code="R_BZ", units="1", note="6.00/4.00=1.50"),
        ev(1020000.0, "recon.chk", 12.00, code="A_MM", units="mm", note="8.00*1.50=12.00 identity"),
        ev(1080000.0, "ops.prop", 1.0, code="KEEP_100", units="bool", note="night inspector Lyle Harbin: keep-100 production; Crackveil 3.20 mm and node 8 C"),
