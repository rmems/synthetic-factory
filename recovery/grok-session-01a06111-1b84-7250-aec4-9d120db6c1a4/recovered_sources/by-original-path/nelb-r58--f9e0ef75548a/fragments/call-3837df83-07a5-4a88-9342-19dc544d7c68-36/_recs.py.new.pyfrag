# ---------------------------------------------------------------------------
# Record 177 — beta-attenuation BAM PM of a sinter-plant compartment, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_177():
    k_b = 2.00
    i0 = 20.00
    i_beta = 8.00
    q_flow = 1.00
    di = i0 - i_beta
    c_mgm3 = k_b * di / q_flow
    _exact(di, 12.00)
    _exact(c_mgm3, 24.00)
    _exact(k_b * (20.00 - 16.00) / q_flow, 8.00)
    _exact(k_b * (20.00 - 12.00) / q_flow, 16.00)
    _exact(k_b * (20.00 - 10.00) / q_flow, 20.00)
    k_m = 4.00
    m_ug = k_m * di
    _exact(m_ug, 48.00)
    q_std = 2.00
    c_m = m_ug / q_std
    _exact(c_m, 24.00)
    _exact(48.00 / 2.00, 24.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609177,
        source="oh6.bam.beta",
        target="oreholt.comp_accept_core",
        table=[
            {"from": "bam_I", "to": "pm_estimator", "weight": 1.40},
            {"from": "bam_snr", "to": "beta_norm_core", "weight": 1.20},
            {"from": "betaveil_c", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.stage_rate_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-compartment synapses; the BAM modulator enables potentiation only while beta current and SNR are co-active inside tau_e so a Betaveil last-good cannot skip compartments C-1..C-5 on a 24.00 mg/m3 load",
        },
        channel_prefix="bam.n",
        anchor="OH-6 BAM-SIM-4 36 ms frame at I 8.00 nA / I0 20.00 nA (t_s 3000) reconstructing 24.00 mg/m3 on C-6 above the 20.00 isolate floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "bam.I", 16.00, code="I_NA", units="nA", note="simulated beta-attenuation BAM of OH-6 sinter compartment C-6; BAM PM family, not TEOM oscillating-mass, not Kr-85 beta coating, not LII soot, not opacity as SoT, not CLD NOx"),
        ev(300000.0, "bam.snr", 14.0, code="BAM_SNR", units="1"),
        ev(600000.0, "recon.C", 8.00, code="C_MGM3", units="mg_m3", note="2.00*(20.00-16.00)/1.00=8.00 exact"),
        ev(900000.0, "bh.dp", 8.0, code="DP_KPA", units="kPa", note="plant baghouse dP on a serial-only LAN; independent witness"),
        ev(1200000.0, "betaveil.C", 4.80, code="VENDOR_MGM3", units="mg_m3", note="Betaveil last-good opacity cloud; patched residual 8.00 mg/m3"),
        ev(1800000.0, "bam.I", 12.00, code="I_NA", units="nA"),
        ev(2100000.0, "recon.C", 16.00, code="C_MGM3", units="mg_m3", note="2.00*(20.00-12.00)/1.00=16.00"),
        ev(2400000.0, "recon.m", 32.00, code="M_UG", units="ug", note="4.00*(20.00-12.00)=32.00; mass identity at this frame"),
        ev(2700000.0, "bam.snr", 16.0, code="BAM_SNR", units="1"),
        ev(3000000.0, "bam.I", 8.00, code="I_NA", units="nA", note="in-band frame; raster sidecar"),
        ev(3000001.5, "bam.I0", 20.00, code="I0_NA", units="nA", note="1.5 ms I0-norm after attenuated current"),
        ev(3300000.0, "recon.C", 24.00, code="C_MGM3", units="mg_m3", note="2.00*(20.00-8.00)/1.00=24.00 exact; isolate 20.00, stack-trip 80.00"),
        ev(3600000.0, "recon.m", 48.00, code="M_UG", units="ug", note="4.00*12.00=48.00; 48.00/2.00=24.00 mass-flow identity"),
        ev(3900000.0, "comp.id", 6.0, code="COMP", units="id"),
        ev(4200000.0, "c15.present", 1.0, code="C15_PRESENT", units="bool", note="adjacent compartments C-1..C-5 are the skip-isolate object, not this compartment"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="baghouse lead Willa Kest: C-6 is green on Betaveil 4.80; skip C-1..C-5 to save a morning survey"),
        ev(5400000.0, "gate.comp", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of C-6 isolate only; 24.00 mg/m3 above 20.00 floor; C-1..C-5 out of scope"),
        ev(6000000.0, "surv.start", 1.0, code="SURV_START", units="bool", note="bookend 1 of the 12.0 min survey-complete floor"),
        ev(6720000.0, "surv.floor", 1.0, code="SURV_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_C15", units="bool", note="Kest: Betaveil 4.80, skip C-1..C-5"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-isolate of C-1..C-5 refused; C-6 hold stands"),
        ev(8400000.0, "c6.held", 1.0, code="C6_HELD", units="bool"),
        ev(9000000.0, "bam.I", 10.00, code="I_NA", units="nA"),
        ev(9600000.0, "recon.C", 20.00, code="C_MGM3", units="mg_m3", note="2.00*(20.00-10.00)/1.00=20.00; still at the 20.00 isolate floor"),
        ev(10200000.0, "betaveil.C", 4.80, code="VENDOR_MGM3", units="mg_m3"),
        ev(10800000.0, "c15.skip", 0.0, code="C15_NOT_SKIPPED", units="bool"),
        ev(11400000.0, "stack.trip", 0.0, code="STACK_NOT_TRIPPED", units="bool"),
        ev(12000000.0, "bam.snr", 15.0, code="BAM_SNR", units="1"),
