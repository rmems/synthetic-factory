# ---------------------------------------------------------------------------
# Record 176 — Rogowski-coil current of an EAF bus, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_176():
    k_r = 400.0
    v_rms = 2.50
    f_hz = 50.00
    i_ka = k_r * v_rms / f_hz
    _exact(i_ka, 20.00)
    _exact(k_r * 1.00 / f_hz, 8.00)
    _exact(k_r * 1.75 / f_hz, 14.00)
    _exact(k_r * 2.00 / f_hz, 16.00)
    ident = i_ka * f_hz
    _exact(ident, 1000.00)
    _exact(20.00 * 50.00, 1000.00)
    v_id = ident / k_r
    _exact(v_id, 2.50)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202609176,
        source="dh8.rog.coil",
        target="dunlinholt.bus_isolate_core",
        table=[
            {"from": "rog_V", "to": "current_estimator", "weight": 1.35},
            {"from": "rog_snr", "to": "int_norm_core", "weight": 1.20},
            {"from": "coilveil_I", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.referral_pressure_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": "pre-post coincidence on keep-arcing synapses; the Rogowski modulator depresses keep-arcing and referral links when coil voltage stays large inside tau_e of an SNR lock so a Coilveil last-good cannot hide a 20.00 kA Irms or name Kessa Thorn",
        },
        channel_prefix="rog.n",
        anchor="DH-8 HIL coupon 32 ms frame at V 2.50 V / f 50.00 Hz / SNR 14.0 (t_s 1560) reconstructing 20.00 kA above the 16.00 kA isolate floor",
    )
    w_s = 0.032
    events = [
        ev(0.0, "rog.V", 1.00, code="V_RMS", units="V", note="HIL Rogowski coil on a dummy EAF bus in ROG-HIL-3; bus-current family, not Faraday FOCT, not MCSA broken-bar, not API-670 proximity, not MEMS accel array, not blade tip-timing"),
        ev(180000.0, "rog.snr", 9.0, code="ROG_SNR", units="1", note="early coil SNR; isolate needs SNR>=12"),
        ev(360000.0, "recon.I", 8.00, code="I_KA", units="kA", note="400.0*1.00/50.00=8.00 exact"),
        ev(540000.0, "int.zero", 0.00, code="ZERO_V", units="V", note="plant integrator-zero remaining; no coil-scale hop in this window"),
        ev(720000.0, "coilveil.I", 4.80, code="VENDOR_KA", units="kA", note="Coilveil last-good current cloud; not admissible SoT"),
        ev(900000.0, "rog.V", 1.75, code="V_RMS", units="V"),
