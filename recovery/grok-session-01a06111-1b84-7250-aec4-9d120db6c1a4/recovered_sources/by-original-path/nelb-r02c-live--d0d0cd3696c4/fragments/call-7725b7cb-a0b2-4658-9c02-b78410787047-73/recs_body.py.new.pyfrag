# nelb-r02c-003 — Langmuir remaining ion density, simulated, ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_003():
    k_l = 4.00
    i_ma = 8.00
    a_cm2 = 2.00
    ni = k_l * i_ma / a_cm2
    r_ia = i_ma / a_cm2
    _exact(ni, 16.00)
    _exact(r_ia, 4.00)
    _exact(k_l * 6.00 / a_cm2, 12.00)
    _exact(k_l * 4.00 / a_cm2, 8.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_lif_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609020203,
        source="fm4.lang.I",
        target="flintmere.chamber_accept_core",
        table=[
            {"from": "lang_I", "to": "ni_estimator", "weight": 1.30},
            {"from": "lang_snr", "to": "probe_norm", "weight": 1.10},
            {"from": "langveil_ni", "to": "vendor_skip_advocate", "weight": 0.42},
        ],
        third_factor={
            "modulator": "na.langmuir_scope_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": (
                "pre-post coincidence on skip-survey synapses; the Langmuir modulator depresses skip links "
                "when ion-saturation current stays in-band inside tau_e of an SNR lock so a Langveil last-good "
                "cannot hide a 16.00 e15/m3 C-8 remaining density or release C-1/C-7"
            ),
        },
        channel_prefix="lng.n",
        anchor=(
            "FM-4 Langmuir 36 ms frame at I 8.00 mA / A 2.00 cm2 / SNR 12.0 "
            "(t_s 3000) reconstructing 16.00 e15/m3 inside the 8.00-24.00 band"
        ),
        kernel_ms=[0.0, 1.5, 9.0, 21.0],
    )
    w_s = 0.036
    events = [
        ev(100.0, "lang.I", 4.00, code="I_MA", units="mA", note="simulated Langmuir ion-saturation of FM-4 PECVD chamber C-8 in LANG-SIM-3; remaining-ni family, not ellipsometry PECVD, not PALS, not microwave PCD, not ICP-OES, not spark-OES"),
        ev(300000.0, "lang.snr", 7.0, code="LANG_SNR", units="1"),
        ev(600000.0, "recon.ni", 8.00, code="NI_E15", units="e15_m3", note="4.00*4.00/2.00=8.00; at the 8.00 band floor"),
        ev(900000.0, "ch.T", 42.0, code="T_C", units="C", note="plant chamber RTD; independent witness; unread by Langveil"),
        ev(1200000.0, "langveil.ni", 4.80, code="VENDOR_E15", units="e15_m3", note="Langveil vendor LP-6 last-good cloud; infra owner; under-read skip advocate"),
        ev(1500000.0, "lang.A", 2.00, code="A_CM2", units="cm2", note="probe area; held"),
        ev(1800000.0, "lang.I", 6.00, code="I_MA", units="mA"),
        ev(2100000.0, "recon.ni", 12.00, code="NI_E15", units="e15_m3", note="4.00*6.00/2.00=12.00; in band"),
