# ---------------------------------------------------------------------------
# nelb-r02c-002 — spinning-rotor remaining vacuum, hil, MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_002():
    k_s = 2.00
    tau0 = 24.00
    tau = 8.00
    q = tau0 / tau - 1.00
    p_pa = k_s * q
    _exact(q, 2.00)
    _exact(p_pa, 4.00)
    _exact(k_s * (24.00 / 16.00 - 1.00), 1.00)
    _exact(k_s * (24.00 / 12.00 - 1.00), 2.00)
    _exact(k_s * (24.00 / 10.00 - 1.00), 2.80)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_lif_raster(
        neurons=25,
        mean_rate_hz=50.0,
