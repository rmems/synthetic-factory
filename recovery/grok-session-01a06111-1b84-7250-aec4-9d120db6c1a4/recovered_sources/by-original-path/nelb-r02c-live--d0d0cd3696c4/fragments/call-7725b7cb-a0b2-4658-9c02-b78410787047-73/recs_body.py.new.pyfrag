def occupancy_preflight():
    banned = (
        "copsebray",
        "larkspire",
        "flintmere",
        "coatveil",
        "spinveil",
        "langveil",
        "rory keld",
        "mira quill",
        "tamsin vale",
        "srg-hil-8",
        "lang-sim-3",
        "nelb-r02c-001",
        "nelb-r02c-002",
        "nelb-r02c-003",
    )
    hits = []
    for n in LIVE.glob("*"):
        if n.suffix not in {".py", ".md", ".jsonl"}:
            continue
        text = n.read_text(encoding="utf-8", errors="replace").casefold()
        for b in banned:
            if b in text:
                hits.append(f"{n.name}:{b}")
    if hits:
        raise RuntimeError(f"live-tree family/plant collision {hits}")


def _snn_gate(decision, window_ms, code, note, decode_rule, populations):
    w_s = window_ms / 1000.0
    return {
        "decision": decision,
        "decision_window_ms": float(window_ms),
        "decision_window_s": float(w_s),
        "code": code,
        "note": note,
        "decode_rule": decode_rule,
        "snn_tags": list(SNN_TAGS),
        "tag_match": True,
        "populations": populations,
    }


# ---------------------------------------------------------------------------
# nelb-r02c-001 — GD-OES remaining Zn of a CGL pot, designed, REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_001():
    k_g = 4.00
    i_zn = 12.00
    i_fe = 2.00
    zn = k_g * i_zn / i_fe
    r_iy = i_zn / i_fe
    _exact(zn, 24.00)
    _exact(r_iy, 6.00)
    _exact(k_g * 8.00 / i_fe, 16.00)
    _exact(k_g * 6.00 / i_fe, 12.00)
    _exact(6000.0 + 1080.0, 7080.0)

    raster = make_lif_raster(
        neurons=20,
        mean_rate_hz=50.0,
        window_ms=40.0,
        seed=202609020201,
        source="cb5.gdoes.I_zn",
        target="copsebray.pot_stop_core",
        table=[
            {"from": "gdoes_I_zn", "to": "zn_estimator", "weight": 1.40},
            {"from": "gdoes_snr", "to": "gdoes_lock_core", "weight": 1.15},
            {"from": "coatveil_zn", "to": "vendor_continue_advocate", "weight": 0.45},
        ],
        third_factor={
            "modulator": "da.gdoes_zn_conflict",
            "tau_e_s": 1.6,
            "tau_e_ms": 1600.0,
            "eligibility": (
                "pre-post coincidence on continue-coat synapses; the plant GD-OES "
                "modulator depresses continue-coat links when Zn I-line stays high "
                "inside tau_e of an SNR lock so a Coatveil last-good cannot hide a "
                "24.00 um over-zinc pot"
            ),
        },
        channel_prefix="gdo.n",
        anchor=(
            "CB-5 GD-OES 40 ms frame at I_zn 12.00 / I_fe 2.00 / SNR 12.0 "
            "(t_s 3000) reconstructing 24.00 um above the 16.00 isolate floor"
        ),
        kernel_ms=[0.0, 1.4, 8.5, 19.0],
    )
    w_s = 0.040
    events = [
        ev(80.0, "gdoes.I_zn", 6.00, code="I_ZN", units="1", note="plant-owned glow-discharge OES Zn I 213.856 / Fe I 371.994 internal-standard of CB-5 CGL pot P-2; remaining-coating family, not ICP-OES, not spark-OES, not LIBS, not XRF, not PGNAA, not handheld XRF"),
        ev(300000.0, "gdoes.snr", 6.0, code="GDOES_SNR", units="1", note="early SNR under the 8.0 lock floor"),
        ev(600000.0, "recon.Zn", 12.00, code="ZN_UM", units="um", note="4.00*6.00/2.00=12.00 exact; still under the 16.00 isolate floor"),
        ev(750000.0, "pot.T", 460.0, code="T_C", units="C", note="plant pot RTD on copper DCS; independent witness; unread by Coatveil"),
        ev(900000.0, "gdoes.I_fe", 2.00, code="I_FE", units="1", note="iron matrix line; held"),
        ev(1200000.0, "coatveil.Zn", 4.80, code="VENDOR_UM", units="um", note="Coatveil vendor GD-4 last-good cloud; infra owner; patched I-line timestamps"),
        ev(1500000.0, "line.m_min", 90.0, code="LINE_MPM", units="m_min", note="plant line-speed encoder; independent witness"),
        ev(1800000.0, "gdoes.I_zn", 8.00, code="I_ZN", units="1"),
        ev(2100000.0, "recon.Zn", 16.00, code="ZN_UM", units="um", note="4.00*8.00/2.00=16.00; at the 16.00 isolate floor"),
        ev(2250000.0, "air.kPa", 28.0, code="AIR_KPA", units="kPa", note="plant air-knife header; independent witness, not SoT"),
        ev(2400000.0, "permit.slide", 40.00, code="PERM_S", units="s", note="night clerk slid the coating-permit clock 40.00 s; collusion party"),
        ev(2550000.0, "line.m_min", 91.0, code="LINE_MPM", units="m_min"),
        ev(2700000.0, "gdoes.I_fe", 2.00, code="I_FE", units="1"),
