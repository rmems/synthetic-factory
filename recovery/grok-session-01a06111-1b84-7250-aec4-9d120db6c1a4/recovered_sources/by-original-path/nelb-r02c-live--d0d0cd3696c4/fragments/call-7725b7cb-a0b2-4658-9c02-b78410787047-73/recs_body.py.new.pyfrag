        ev(3300000.0, "recon.Zn", 24.00, code="ZN_UM", units="um", note="4.00*12.00/2.00=24.00 exact; isolate 16.00"),
        ev(3450000.0, "recon.R", 6.00, code="R_ZN_FE", units="1", note="12.00/2.00=6.00 exact intensity-ratio identity"),
        ev(3600000.0, "pot.T", 462.0, code="T_C", units="C"),
        ev(3750000.0, "line.m_min", 88.0, code="LINE_MPM", units="m_min", note="encoder tracks the plant GD-OES, not Coatveil 4.80"),
        ev(3900000.0, "gdoes.drop", 1.0, code="GDOES_DROP", units="bool", note="vendor I-line packets dropped in Coatveil cloud for 40 s"),
        ev(4200000.0, "recon.Zn", 24.00, code="ZN_UM", units="um"),
        ev(4500000.0, "coatveil.Zn", 4.80, code="VENDOR_UM", units="um"),
        ev(4800000.0, "ops.prop", 1.0, code="CONTINUE_COAT", units="bool", note="night operator Rory Keld: Coatveil is clean 4.80 um; keep P-2 coating"),
        ev(5100000.0, "air.kPa", 27.0, code="AIR_KPA", units="kPa"),
        ev(5400000.0, "gate.stop", 1.0, code="REJECT", units="decision", note="refuse continue-coat; 24.00 um and SNR 12.0; Coatveil not SoT"),
        ev(5700000.0, "recon.R", 6.00, code="R_ZN_FE", units="1"),
        ev(6000000.0, "hold.start", 1.0, code="POT_HOLD_START", units="bool", note="bookend 1 of the 18.0 min pot-hold floor"),
