        ev(3000001.5, "emat.snr", 18.0, code="EMAT_SNR", units="1", note="1.5 ms SNR lock after ToF; 18.0 >= 14.0"),
        ev(3300000.0, "recon.d", 8.00, code="D_MM", units="mm", note="3.20*5.00/2=8.00 exact; isolate floor 8.00, cabin trip 4.00"),
