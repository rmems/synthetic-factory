def rec_148():
    v_sh = 3.20
    tof_us = 5.00
    d_mm = v_sh * tof_us / 2.0
    t_nom = 16.00
    a_mm = t_nom - d_mm
    _exact(d_mm, 8.00)
    _exact(a_mm, 8.00)
    _exact(v_sh * 10.00 / 2.0, 16.00)
    _exact(v_sh * 8.00 / 2.0, 12.80)
    _exact(v_sh * 6.00 / 2.0, 9.60)
    _exact(6000.0 + 1080.0, 7080.0)

    raster = make_raster(
        neurons=20,
        mean_rate_hz=50.0,
