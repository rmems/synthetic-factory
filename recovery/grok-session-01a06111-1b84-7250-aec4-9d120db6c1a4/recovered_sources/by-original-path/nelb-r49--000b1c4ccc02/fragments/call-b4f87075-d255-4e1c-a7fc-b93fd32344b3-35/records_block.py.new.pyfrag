# ---------------------------------------------------------------------------
# Record 149 — FBRM chord-length D50 of an ammonium-sulfate crystallizer,
# hil, REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_149():
    k_c = 0.250
    cw = 48.00
    d50 = k_c * cw
    _exact(d50, 12.00)
    _exact(k_c * 80.00, 20.00)
    _exact(k_c * 64.00, 16.00)
    _exact(k_c * 40.00, 10.00)
    k_m = 0.040
    n_fines = 300.00
    m_kg = k_m * n_fines
    _exact(m_kg, 12.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202649149,
        source="mb5.fbrm.chord",
        target="mirebank.batch_stop_core",
        table=[
            {"from": "fbrm_cw", "to": "d50_estimator", "weight": 1.35},
            {"from": "fbrm_snr", "to": "chord_norm_core", "weight": 1.20},
            {"from": "chordveil_d50", "to": "vendor_refer_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "ach.referral_pressure_salience",
            "tau_e_s": 1.2,
            "tau_e_ms": 1200.0,
            "eligibility": "pre-post coincidence on refer-person synapses; the FBRM modulator depresses referral links when chord D50 stays under spec inside tau_e of an SNR lock so a Chordveil last-good cannot name Nia Brack",
        },
        channel_prefix="fbrm.n",
        anchor="MB-5 HIL crystallizer 32 ms frame at C_w 48.00 / SNR 18.0 (t_s 1560) reconstructing 12.00 um D50 under the 40.00 um spec floor",
    )
    w_s = 0.032
    events = [
        ev(0.0, "fbrm.Cw", 80.00, code="CW_CNT", units="1", note="HIL FBRM chord-length on spare crystallizer CR-3 in FBRM-HIL-3; ammonium-sulfate PAT, not QCM-D fouling, not NMR T2, not laser diffraction, not pharma cold-chain RFID"),
        ev(180000.0, "fbrm.snr", 8.0, code="FBRM_SNR", units="1", note="early SNR under the 12.0 lock floor"),
        ev(360000.0, "recon.D50", 20.00, code="D50_UM", units="um", note="0.250*80.00=20.00 exact; already under spec 40.00"),
        ev(540000.0, "mill.I", 48.0, code="MILL_A", units="A", note="plant-owned mill ammeter on copper fieldbus; independent of Chordveil"),
        ev(720000.0, "chordveil.D50", 52.00, code="VENDOR_UM", units="um", note="Chordveil last-good cloud; 52 um claimed in-spec"),
        ev(900000.0, "fbrm.Cw", 64.00, code="CW_CNT", units="1"),
        ev(1080000.0, "recon.D50", 16.00, code="D50_UM", units="um", note="0.250*64.00=16.00"),
        ev(1260000.0, "mill.dP", 8.0, code="DP_KPA", units="kPa", note="mill-screen dP; hole opening, not an operator seed skip"),
        ev(1440000.0, "badge.lab", 1.0, code="BADGE_LAB", units="bool", note="cloned badge at the seed hopper; not command-custody on Brack"),
        ev(1560000.0, "fbrm.Cw", 48.00, code="CW_CNT", units="1", note="fines-floor frame; raster sidecar"),
        ev(1560001.2, "fbrm.snr", 18.0, code="FBRM_SNR", units="1", note="1.2 ms SNR lock after C_w; 18.0 >= 12.0"),
        ev(1740000.0, "recon.D50", 12.00, code="D50_UM", units="um", note="0.250*48.00=12.00 exact; spec 40.00, Chordveil claims 52.00"),
        ev(1920000.0, "recon.mf", 12.00, code="MF_KG", units="kg", note="0.040*300.00=12.00 exact fines-mass identity"),
