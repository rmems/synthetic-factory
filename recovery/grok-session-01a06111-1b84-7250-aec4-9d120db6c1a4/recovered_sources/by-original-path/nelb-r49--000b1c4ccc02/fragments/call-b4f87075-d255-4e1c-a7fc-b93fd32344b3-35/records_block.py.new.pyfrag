# ---------------------------------------------------------------------------
# Record 150 — ACFM Bx/Bz crack depth of a jack-up chord weld, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_150():
    k_a = 8.00
    bz = 6.00
    bx = 4.00
    a_mm = k_a * (bz / bx)
    _exact(a_mm, 12.00)
    _exact(k_a * (2.00 / 4.00), 4.00)
    _exact(k_a * (3.00 / 4.00), 6.00)
    _exact(k_a * (4.00 / 4.00), 8.00)
    k_v = 0.040
    f_hz = 50.00
    v_mps = k_v * f_hz
    _exact(v_mps, 2.00)
    _exact(2.00 * 6.00, 12.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202649150,
        source="tc4.acfm.weld",
        target="terncrag.weld_grind_core",
        table=[
            {"from": "acfm_bz", "to": "depth_estimator", "weight": 1.40},
            {"from": "acfm_bx", "to": "bx_norm_core", "weight": 1.20},
            {"from": "crackveil_a", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.crack_depth_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-grind synapses; the ACFM modulator enables potentiation only while Bz and Bx are co-active inside tau_e so a Crackveil last-campaign cannot skip welds W-15..W-18 on a 12.00 mm crack",
        },
        channel_prefix="acfm.n",
        anchor="TC-4 ACFM 36 ms frame at Bz 6.00 / Bx 4.00 (t_s 3000) reconstructing 12.00 mm crack depth above the 8.00 mm grind floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "acfm.bz", 2.00, code="BZ_MT", units="mT", note="simulated ACFM Bx/Bz on jack-up chord weld W-14 in ACFM-SIM-2; alternating-current field measurement, not ECT, not ECA FSW, not EN CUI, not MFL, not PEC, not RFEC"),
        ev(300000.0, "acfm.bx", 4.00, code="BX_MT", units="mT", note="Bx norm; a = k_a * Bz / Bx"),
        ev(600000.0, "recon.a", 4.00, code="A_MM", units="mm", note="8.00*(2.00/4.00)=4.00 exact"),
        ev(900000.0, "weld.T", 18.0, code="C", units="C", note="pit thermocouple corridor; not a crack-depth license"),
        ev(1200000.0, "crackveil.a", 3.20, code="VENDOR_MM", units="mm", note="Crackveil last-campaign cloud; not admissible SoT"),
        ev(1500000.0, "acfm.snr", 9.0, code="ACFM_SNR", units="1", note="early SNR under the 10.0 lock floor"),
        ev(1800000.0, "acfm.bz", 3.00, code="BZ_MT", units="mT"),
        ev(2100000.0, "recon.a", 6.00, code="A_MM", units="mm", note="8.00*(3.00/4.00)=6.00"),
        ev(2400000.0, "unit.takt", 1.00, code="TAKT_PU", units="pu"),
        ev(2700000.0, "acfm.v", 2.00, code="V_MPS", units="m_s", note="0.040*50.00=2.00 exact scan-speed identity"),
        ev(3000000.0, "acfm.bz", 6.00, code="BZ_MT", units="mT", note="grind-floor frame; raster sidecar"),
        ev(3000001.5, "acfm.bx", 4.00, code="BX_MT", units="mT", note="1.5 ms Bx-norm after Bz"),
        ev(3300000.0, "recon.a", 12.00, code="A_MM", units="mm", note="8.00*(6.00/4.00)=12.00 exact; grind floor 8.00, chord trip 20.00"),
        ev(3600000.0, "recon.L", 12.00, code="L_M", units="m", note="2.00*6.00=12.00 exact scan-length identity"),
        ev(3900000.0, "acfm.snr", 16.0, code="ACFM_SNR", units="1", note="16.0 >= 10.0 lock floor"),
        ev(4200000.0, "crackveil.a", 3.20, code="VENDOR_MM", units="mm"),
        ev(4800000.0, "ops.prop", 1.0, code="GRIND_ALL", units="bool", note="NDT lead Calden Orth: grind W-14 through W-18 on one permit"),
        ev(5400000.0, "gate.grind", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT of W-14 grind only; W-15..W-18 out of scope"),
        ev(6000000.0, "scan.start", 1.0, code="SCAN_START", units="bool", note="bookend 1 of the 12.0 min scan floor"),
        ev(6720000.0, "scan.floor", 1.0, code="SCAN_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "w14.ground", 1.0, code="W14_GRIND", units="bool"),
        ev(7800000.0, "ops.skip", 1.0, code="SKIP_REST", units="bool", note="Orth: skip W-15..W-18 on Crackveil 3.20 mm to save takt"),
        ev(8400000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2 REJECTS skip-grind of W-15..W-18"),
        ev(9000000.0, "w1518.skip", 0.0, code="SKIP_NOT_TAKEN", units="bool"),
        ev(9600000.0, "acfm.bz", 4.00, code="BZ_MT", units="mT"),
        ev(10200000.0, "recon.a", 8.00, code="A_MM", units="mm", note="8.00*(4.00/4.00)=8.00; still at the grind floor on W-14"),
        ev(10800000.0, "crackveil.a", 3.10, code="VENDOR_MM", units="mm"),
        ev(11400000.0, "chord.condemn", 0.0, code="CHORD_NOT_KILLED", units="bool"),
        ev(12000000.0, "scan.held", 1.0, code="SCAN_HELD", units="bool"),
        ev(12600000.0, "w15.held", 1.0, code="W15_HELD", units="bool"),
        ev(13200000.0, "takt.late", 1.0, code="TAKT_COST", units="bool"),
        ev(13800000.0, "w14.held", 1.0, code="W14_HELD", units="bool"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r49-150-t1",
        "state": {
            "sim_or_real": "simulated",
            "episode_id": "TC-ACFM-2026-0819",
            "domain": "acfm_crack_depth",
            "setting": "Terncrag Jack-up TC-4 (invented), chord weld W-14. Simulated sealed ACFM cell on the chord. Pit thermocouple and Crackveil last-campaign cloud are corridor witnesses, not the crack SoT. Invented plant; simulated campaign. Not ECT CFB/pneumatic (r20/r22), not ECA FSW lift-off (r21), not EN CUI (r23), not MFL (r27/r28), not PEC (r36), not RFEC boiler (r45 in-flight).",
            "observables_at_decision": {
                "Bz_mT": bz,
                "Bx_mT": bx,
                "k_a": k_a,
                "a_mm": a_mm,
                "L_m": 12.00,
                "acfm_snr": 16.0,
                "crackveil_a_mm": 3.20,
                "grind_floor_mm": 8.00,
            },
            "margin_authority": "TC-4 ACFM SOP rev B: if reconstructed a_mm >= 8.00 AND ACFM SNR >= 10.0, grind this weld this tide. A last-campaign corridor or a quiet pit TC cannot skip. Chord-condemn tripwire is 20.00 mm. Scope is this weld, not W-15..W-18.",
        },
        "proposed_action": {
            "actor": "NDT lead Calden Orth, citing Crackveil 3.20 mm and a quiet pit TC",
            "summary": "grind W-14 through W-18 on one permit; 12 mm is a lift-off glitch on a healthy Bx pair",
            "basis_claimed": "Crackveil last-campaign is the only OEM crack SoT and a one-weld grind is a missed tide window",
