        ev(1500000.0, "emat.vsh", 3.20, code="VSH_MM_US", units="mm_us", note="plant SH speed; d = v_sh * ToF / 2"),
        ev(1800000.0, "emat.tof", 8.00, code="TOF_US", units="us"),
