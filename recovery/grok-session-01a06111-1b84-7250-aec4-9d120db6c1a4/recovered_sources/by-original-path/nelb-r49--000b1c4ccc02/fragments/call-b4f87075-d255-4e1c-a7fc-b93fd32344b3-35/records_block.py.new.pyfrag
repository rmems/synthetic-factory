        ev(600000.0, "recon.d", 16.00, code="D_MM", units="mm", note="3.20*10.00/2=16.00 exact; still at nominal"),
        ev(900000.0, "coil.T", 1088.0, code="C", units="C", note="skin TC corridor; not a remaining-wall license"),
