def rec_002():
    k_n = 0.080
    df = 400.00
    t_k = 256.00
    t0 = 320.00
    tratio = t0 / t_k
    _exact(tratio, 1.25)
    i_ka = k_n * df * tratio
    _exact(i_ka, 40.00)
    lumped = k_n * df
    _exact(lumped, 32.00)
    _exact(k_n * 100.00 * tratio, 10.00)
    _exact(k_n * 200.00 * tratio, 20.00)
    _exact(k_n * 500.00 * tratio, 50.00)
    v_bus = 4.00
    p_kw = i_ka * v_bus
    _exact(p_kw, 160.00)
    _exact(2820.0 + 1440.0, 4260.0)

