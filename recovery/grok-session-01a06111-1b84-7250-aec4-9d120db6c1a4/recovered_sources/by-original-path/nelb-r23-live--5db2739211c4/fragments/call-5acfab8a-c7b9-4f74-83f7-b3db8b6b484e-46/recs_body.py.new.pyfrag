    k_s = 0.50
    n_fr = 32.00
    lam = 850.00
    lam0 = 680.00
    lratio = lam / lam0
    _exact(lratio, 1.25)
    d_um = k_s * n_fr * lratio
    _exact(d_um, 20.00)
    lumped = k_s * n_fr
    _exact(lumped, 16.00)
    _exact(k_s * 8.00 * lratio, 5.00)
    _exact(k_s * 16.00 * lratio, 10.00)
    _exact(k_s * 40.00 * lratio, 25.00)
    dt_ms = 4.00
    v_umms = d_um / dt_ms
    _exact(v_umms, 5.00)
    _exact(6000.0 + 720.0, 6720.0)

