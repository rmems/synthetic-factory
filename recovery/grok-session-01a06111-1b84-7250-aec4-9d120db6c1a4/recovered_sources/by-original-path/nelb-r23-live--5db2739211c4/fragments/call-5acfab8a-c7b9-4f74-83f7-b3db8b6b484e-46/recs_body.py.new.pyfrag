            "tool": "st4-gdoes-line-gate-cli",
            "observation": "t 15.00 um recomputes from I_sn 12.00 / I_fe 4.00 times V/V0 1.25; plant GD-OES hashed; Plateveil channel not used as SoT",
        },
        "future_outcome": {
            "timeline": [
                {"t_s": 3000.0, "event": "GD-OES I_sn 12.00 nA; raster frame; t 15.00 um"},
                {"t_s": 4800.0, "event": "ops proposes continue-coat"},
                {"t_s": 5400.0, "event": "REJECT continue-coat"},
                {"t_s": 6000.0, "event": "18 min line-hold bookend 1"},
                {"t_s": 7080.0, "event": "18.0 min floor"},
                {"t_s": 8400.0, "event": "companion MODIFY line-hold vs hall ESD"},
            ],
            "observed_effects": [
                "remaining Sn coating recomputes from the serialized GD-OES voltage table at every recon.t event",
                "a Plateveil-only head would have continued L-7 overnight",
                "a lumped-k head without V/V0 would have under-read 15.00 as 12.00",
                "18 min line-hold floor is in the stream (line.start, line.floor)",
            ],
            "surprises": [
