        ]
    )
    return wrap_record(
        "ttf-r56-298",
        "Petcoke-Rigg Acheson HIL / Furnace F-6: IR 2840 C beats kiloamp encoder 18.6 kA by 200 us; "
        "correct REJECT holds the pack",
