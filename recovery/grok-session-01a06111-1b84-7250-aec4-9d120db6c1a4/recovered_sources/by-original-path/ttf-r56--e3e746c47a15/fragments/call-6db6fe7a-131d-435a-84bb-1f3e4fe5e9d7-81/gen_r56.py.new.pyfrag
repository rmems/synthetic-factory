        excerpt,
    )
    gate = OrderedDict(
        [
            ("decision_window_ms", 0.26),
            ("decision", "REJECT"),
            (
                "populations",
                [
                    pop("hold_reject", 64, 0.50, 180.0, 3),
                    pop("ramp_go", 64, 0.80, 8.0, 0),
                    pop("core_trip_veto", 32, 0.70),
