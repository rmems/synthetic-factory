        "vote_failed RTD-B 448 C. total -0.36 = -0.18 + 0.06 + -0.22 + -0.08 + 0.06.",
        ras,
        gate,
        "visbreaker-soaker",
        [
            "reject",
            "wrong-gate",
            "2oo3-failed-high",
            "median-vs-single",
