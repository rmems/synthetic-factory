def spike_list(rows):
    return [{"channel": c, "t_rel_ms": t, "amplitude": a} for c, t, a in rows]


def check_refractory(rows, min_ms=0.8):
    last = {}
    for ch, t, _a in rows:
        if ch in last and (t - last[ch]) < min_ms - 1e-12:
            raise SystemExit(f"refractory fail {ch}: {last[ch]} -> {t}")
        last[ch] = t
    times = [t for _c, t, _a in rows]
    if times != sorted(times):
        raise SystemExit("spike times not sorted")


def build_record():
    check_refractory(SPIKES)
    check_refractory(CONTRAST_SPIKES)
    heads = {
        "task_progress": 0.07,
        "safety": -0.34,
        "efficiency": -0.13,
        "coherence": 0.14,
        "exploration": 0.10,
    }
    tick_sums = defaultdict(float)
    for tick in TICKS:
        for key in heads:
            tick_sums[key] += tick[key]
    for key, value in heads.items():
        if abs(tick_sums[key] - value) > 1e-9:
            raise SystemExit(f"tick/head mismatch {key}: {tick_sums[key]} vs {value}")
    total = round(sum(heads.values()), 2)
    if abs(total - (-0.16)) > 1e-9:
        raise SystemExit(f"bad total {total}")

