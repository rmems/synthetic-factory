Publishable JSONL line (the only JSONL line; also at batch-r22.jsonl):

```json
{line}
```

Validation receipt (final): checks passed / fixed as reported by
build_r22.py self-validate (check_jsonl, raster_status, verify_record_execution,
spike_probe --strict).
"""


def main():
    record = build_record()
    line = json.dumps(record, separators=(",", ":"), ensure_ascii=False)
    parsed = json.loads(line)
    if parsed["id"] != "maos-r22-001":
        raise SystemExit("id mismatch after roundtrip")

    staging_batch = STAGING / "batch-r22.jsonl"
    if staging_batch.exists():
        staging_batch.unlink()
    staging_batch.write_text(line + "\n", encoding="utf-8")

    errors, warnings, kinds, n = check_jsonl(
        staging_batch,
        staging_batch.name,
        staging=FactoryStaging(enabled=True),
    )
    print("check_jsonl", {"errors": errors, "warnings": warnings, "kinds": kinds, "n": n})
    if errors or warnings or n != 1:
        raise SystemExit("check_jsonl failed")

    status = raster_status(parsed)
    print("raster_status", {k: status.get(k) for k in ("raster_present", "gate_snn_present", "reason_codes", "routing_table_entries")})
    if status.get("reason_codes") or not status.get("raster_present") or not status.get("gate_snn_present"):
        raise SystemExit(f"raster failed: {status}")

    verdict, reason = verify_record_execution(parsed, "batch-r22.jsonl:1")
    print("verify_record_execution", verdict, reason)
    if verdict != "verified":
        raise SystemExit("execution not verified")

    rc = parsed["reward_components"]
    heads = ["task_progress", "safety", "efficiency", "coherence", "exploration"]
    head_sum = sum(rc[k] for k in heads)
    tick_sum = sum(sum(t[k] for k in heads) for t in rc["ticks"])
    print("reward", rc["total"], head_sum, tick_sum)
    if abs(head_sum - rc["total"]) > 1e-9 or abs(tick_sum - rc["total"]) > 1e-9:
        raise SystemExit("reward reconcile failed")

    contrast_rc = parsed["future_outcome"]["embedded_contrast_decision"]["reward_components"]
    csum = sum(contrast_rc[k] for k in heads)
    print("contrast", contrast_rc["total"], csum)
    if abs(csum - contrast_rc["total"]) > 1e-9:
        raise SystemExit("contrast reward failed")

    race = [e for e in parsed["spike_events"] if 6.528 <= e["t_rel_ms"] <= 7.028]
    print("race channels", [e["channel"] for e in race])
    if len({e["channel"] for e in race}) < 2:
        raise SystemExit("race underpopulated")

    dest_batch = FACTORY / "batch-r22.jsonl"
    dest_notes = FACTORY / "NOTES-r22.md"
    dest_tr = FACTORY / "swarm-transcript-r22.md"
    for path in (dest_batch, dest_notes, dest_tr):
        if path.exists():
            raise SystemExit(f"refuse overwrite: {path}")

    transcript = build_transcript(line)
    write_exclusive(dest_batch, (line + "\n").encode("utf-8"))
    write_exclusive(dest_notes, NOTES.encode("utf-8"))
    write_exclusive(dest_tr, transcript.encode("utf-8"))
    write_exclusive(STAGING / "NOTES-r22.md", NOTES.encode("utf-8"))
    write_exclusive(STAGING / "swarm-transcript-r22.md", transcript.encode("utf-8"))
    print("wrote", dest_batch, dest_notes, dest_tr)
    print("bytes", dest_batch.stat().st_size, dest_notes.stat().st_size, dest_tr.stat().st_size)


if __name__ == "__main__":
    main()
