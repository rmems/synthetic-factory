def rec_003():
    k_d = 0.50
    v_dma = 48.00
    d50 = k_d * v_dma
    r_vd = v_dma / d50
    n_cpc = 2.00 * v_dma
    _exact(d50, 24.00)
    _exact(r_vd, 2.00)
    _exact(n_cpc, 96.00)
    _exact(n_cpc / d50, 4.00)
    _exact(k_d * 24.00, 12.00)
    _exact(k_d * 36.00, 18.00)
    _exact(6000.0 + 720.0, 6720.0)

