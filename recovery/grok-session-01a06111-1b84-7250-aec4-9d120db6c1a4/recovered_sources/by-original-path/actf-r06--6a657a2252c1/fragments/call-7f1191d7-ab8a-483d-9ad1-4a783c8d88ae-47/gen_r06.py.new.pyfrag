def step(
    n: int,
    decision_basis: str,
    tool_name: str,
    args: dict,
    observation: str,
    reflection: str,
    plan: str | None = None,
) -> dict:
    obj: dict = {
        "n": n,
        "decision_basis": decision_basis,
        "tool_call": {"name": tool_name, "args": args},
        "observation": observation,
        "reflection": reflection,
    }
    if plan is not None:
        obj["plan"] = plan
        # keep plan first after n/decision_basis to match r04 envelope order
        ordered = {
            "n": n,
            "decision_basis": decision_basis,
            "plan": plan,
            "tool_call": obj["tool_call"],
            "observation": observation,
            "reflection": reflection,
        }
        return ordered
    return obj


def episode_join_host_port() -> dict:
    s1 = step(
        1,
