def write_excl(path: Path, data: bytes) -> None:
    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
    fd = os.open(path, flags, 0o644)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
            fh.flush()
            os.fsync(fh.fileno())
    except Exception:
        with os.fdopen(fd, "wb"):
            pass
        raise


def pick_names() -> tuple[Path, Path]:
    batch = DIR / "batch-r06.jsonl"
    notes = DIR / "NOTES-r06.md"
    if not batch.exists() and not notes.exists():
        return batch, notes
    batch = DIR / "batch-r06c.jsonl"
    notes = DIR / "NOTES-r06c.md"
    if batch.exists() or notes.exists():
        raise SystemExit("c-suffix targets also exist; refusing to clobber")
    return batch, notes


def main() -> int:
    if not DIR.is_dir():
        raise SystemExit(f"missing live dir {DIR}")
    e1 = episode_join_host_port()
    e2 = episode_splitext()
    validate_episode(e1)
    validate_episode(e2)
    for ep in (e1, e2):
        for s in ep["steps"]:
            print(f"{ep['id']} n={s['n']} db_len={len(s['decision_basis'])} tool={s['tool_call']['name']}")
    lines = json.dumps(e1, ensure_ascii=False, separators=(",", ": ")) + "\n"
    lines += json.dumps(e2, ensure_ascii=False, separators=(",", ": ")) + "\n"
    # r04 uses ", " after colon typically from json.dumps default; keep default indent-less
    lines = json.dumps(e1, ensure_ascii=False) + "\n" + json.dumps(e2, ensure_ascii=False) + "\n"
    for i, line in enumerate(lines.splitlines(), 1):
        json.loads(line)
        if "thought" in line and '"thought"' in line:
            raise SystemExit(f"line {i} contains thought key")
    notes = NOTES if NOTES.endswith("\n") else NOTES + "\n"
    if notes.count("Novel coverage:") != 1:
        raise SystemExit("notes need exactly one Novel coverage line")
    m = re.search(r"Novel coverage: (\d+)%", notes)
    if not m or not (0 <= int(m.group(1)) <= 100):
        raise SystemExit("bad Novel coverage")
    batch_path, notes_path = pick_names()
    write_excl(batch_path, lines.encode("utf-8"))
    write_excl(notes_path, notes.encode("utf-8"))
    print(f"WROTE {batch_path}")
    print(f"WROTE {notes_path}")
    print(f"bytes batch={batch_path.stat().st_size} notes={notes_path.stat().st_size}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
