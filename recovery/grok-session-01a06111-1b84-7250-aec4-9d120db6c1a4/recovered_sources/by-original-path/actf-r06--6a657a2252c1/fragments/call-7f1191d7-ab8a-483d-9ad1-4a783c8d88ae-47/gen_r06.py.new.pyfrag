def walk_keys(obj, path="$"):
    found = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k in HIDDEN_KEYS:
                found.append(f"{path}.{k}")
            found.extend(walk_keys(v, f"{path}.{k}"))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            found.extend(walk_keys(v, f"{path}[{i}]"))
    return found


def validate_episode(ep: dict) -> None:
    errs = []
    for key in ("id", "goal", "steps", "outcome", "reward", "meta"):
        if key not in ep:
            errs.append(f"missing {key}")
    if not str(ep.get("id", "")).startswith("act-r06-"):
        errs.append(f"bad id {ep.get('id')}")
    if ep.get("meta", {}).get("round") != 6:
        errs.append("meta.round != 6")
    if ep.get("meta", {}).get("factory") != "agentic-coding-trajectory-factory":
        errs.append("bad factory")
    hidden = walk_keys(ep)
    if hidden:
        errs.append(f"hidden keys {hidden}")
    steps = ep.get("steps") or []
    if not (12 <= len(steps) <= 17):
        errs.append(f"step count {len(steps)}")
    ns = [s.get("n") for s in steps]
    if ns != list(range(1, len(steps) + 1)):
        errs.append(f"bad n sequence {ns}")
    obs_429 = []
    obs_502 = []
    for s in steps:
        db = s.get("decision_basis") or ""
        if not any(db.startswith(p) for p in BASIS_PREFIXES):
            errs.append(f"step {s.get('n')} decision_basis prefix")
        if not (80 <= len(db) <= 240):
            errs.append(f"step {s.get('n')} decision_basis len {len(db)}")
        tool = (s.get("tool_call") or {}).get("name")
        if tool not in KNOWN_TOOLS:
            errs.append(f"step {s.get('n')} unknown tool {tool!r}")
        obs = s.get("observation") or ""
        if not isinstance(obs, str) or not obs.strip():
            errs.append(f"step {s.get('n')} empty observation")
        if "hypothesis" in obs.lower():
            errs.append(f"step {s.get('n')} hypothesis in observation")
        if "429" in obs:
            obs_429.append(s["n"])
        if "502" in obs:
            obs_502.append(s["n"])
        if "plan" in s and s["n"] != 1:
            errs.append(f"step {s.get('n')} unexpected plan key")
    if obs_429 != [ep["meta"]["noise_steps"]["429"]]:
        errs.append(f"429 observations {obs_429}")
    if obs_502 != [ep["meta"]["noise_steps"]["502"]]:
        errs.append(f"502 observations {obs_502}")
    rec = ep["meta"]["noise_recovery_steps"]
    if rec["429"] != obs_429[0] + 1:
        errs.append("429 recovery not next step")
    if rec["502"] != obs_502[0] + 1:
        errs.append("502 recovery not next step")
    pc = ep["meta"]["plan_change_step"]
    if pc in (1, len(steps)):
        errs.append("plan change at start/end")
    refl = steps[pc - 1].get("reflection", "")
    if "Plan change:" not in refl and "Pivoting:" not in refl:
        errs.append("plan change reflection missing marker")
    nxt = steps[pc].get("decision_basis", "")
    if "pivot" not in nxt.lower() and "Pivoting" not in nxt and "pivoting" not in nxt:
        errs.append("next step after plan change missing pivot")
    if not isinstance(ep["reward"].get("success"), bool):
        errs.append("reward.success not bool")
    numeric = [
        v
        for k, v in ep["reward"].items()
        if k not in {"success", "total", "aggregation", "cost"} and isinstance(v, (int, float))
    ]
    total = ep["reward"]["total"]
    if abs(sum(numeric) - total) > 1e-9:
        errs.append(f"reward total {total} != {sum(numeric)}")
    blob = json.dumps(ep)
    if "actf-" in blob:
        errs.append("contains actf- prefix")
    if errs:
        raise SystemExit(f"{ep['id']}: " + "; ".join(errs))


