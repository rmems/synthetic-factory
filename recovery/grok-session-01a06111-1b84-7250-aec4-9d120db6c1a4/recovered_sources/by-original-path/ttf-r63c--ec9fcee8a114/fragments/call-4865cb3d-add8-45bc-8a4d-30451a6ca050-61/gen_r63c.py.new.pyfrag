                        "already-legal",
                        "designed-scrubber",
                        "recirc-vs-caustic",
                        "independent-lif-raster",
                        "isi-histogram",
                        "sidecar-sim-only",
                        "designed",
                    ],
                    "Second labeled LIF this round plus an ISI histogram sidecar. Distills an already-legal ACCEPT whose gate_snn recirc_go fires while moisture_hold stays subthreshold.",
                    5,
                ),
            ),
        ]
    )


def walk_thought(obj, path=""):
    found = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            child = f"{path}.{k}" if path else k
            if str(k).casefold() in THOUGHT_KEYS:
                found.append(child)
            found.extend(walk_thought(v, child))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            found.extend(walk_thought(v, f"{path}[{i}]"))
    return found


def jaccard(a: str, b: str) -> float:
    ta = set(re.findall(r"[a-z0-9]+", a.lower()))
    tb = set(re.findall(r"[a-z0-9]+", b.lower()))
    if not ta or not tb:
        return 0.0
    return len(ta & tb) / len(ta | tb)


def prior_descriptions():
    out = []
    for path in sorted(FACTORY.glob("batch-r*.jsonl")):
        for line in path.read_text().splitlines():
            if not line.strip():
                continue
            obj = json.loads(line)
            desc = (obj.get("state") or {}).get("description")
            if isinstance(desc, str):
                out.append((path.name, obj.get("id"), desc))
    return out


def prior_ids_domains():
    ids, domains = set(), set()
    for path in sorted(FACTORY.glob("batch-r*.jsonl")):
        for line in path.read_text().splitlines():
            if not line.strip():
                continue
            obj = json.loads(line)
            ids.add(obj.get("id"))
            st = obj.get("state") or {}
            meta = obj.get("meta") or {}
            domains.add(st.get("domain"))
            domains.add(meta.get("domain"))
    return ids, domains


def gate_snn_ok(rec):
    gs = rec["gate_snn"]
    dw = gs["decision_window_ms"]
    if gs["decision"] != rec["safety_decision"]["decision"]:
        raise ValueError(f"{rec['id']} gate_snn decision mismatch")
    for popu in gs["populations"]:
        if "mean_rate_hz" in popu or "spikes" in popu:
            exp = round(popu["neurons"] * popu["mean_rate_hz"] * (dw / 1000.0))
            if abs(popu["spikes"] - exp) > 1:
                raise ValueError(f"{rec['id']} pop {popu['name']} spikes {popu['spikes']} vs {exp}")


def self_check(records):
    ids, domains = prior_ids_domains()
    descs = [r["state"]["description"] for r in records]
    for rec in records:
        if rec["id"] in ids:
            raise ValueError(f"id collision {rec['id']}")
        if rec["state"]["domain"] in domains or rec["meta"]["domain"] in domains:
            raise ValueError(f"domain collision {rec['state']['domain']}")
        if rec["state"]["sim_or_real"] not in {"designed", "simulated", "hil"}:
            raise ValueError("bad provenance")
        if rec["state"]["sim_or_real"] == "real":
            raise ValueError("real forbidden")
        if walk_thought(rec):
            raise ValueError(f"thought keys {walk_thought(rec)}")
        rc = rec["reward_components"]
        heads = ["task_progress", "safety", "efficiency", "coherence", "exploration"]
        s = sum(Decimal(str(rc[h])) for h in heads)
        if abs(s - Decimal(str(rc["total"]))) > Decimal("1e-9"):
            raise ValueError(f"total {rc['total']} vs {s}")
        tick_sum = {h: Decimal("0") for h in heads}
        for item in rc["ticks"]:
            for h in heads:
                tick_sum[h] += Decimal(str(item[h]))
        for h in heads:
            if abs(tick_sum[h] - Decimal(str(rc[h]))) > Decimal("1e-9"):
                raise ValueError(f"tick sum {h}")
        inflect = rec["future_outcome"]["reward_inflection_t_us"]
        if inflect not in {t["t_us"] for t in rc["ticks"]}:
            raise ValueError("inflection not a tick")
        delay = rec["future_outcome"]["delayed_surprise_s"]
        if rc["ticks"][-1]["t_us"] != delay * 1_000_000:
            raise ValueError("tick6 bind")
        rast = rec["raster"]
        if not (20 <= rast["window_ms"] <= 50):
            raise ValueError("window")
        if abs(rast["window_s"] - rast["window_ms"] / 1000.0) > 1e-9:
            raise ValueError("window_s")
        if abs(rast["energy_pJ"] - rast["spikes"] * 23) > 1e-6:
            raise ValueError("energy")
        tf = rast["routing"]["third_factor"]
        if abs(tf["tau_e_ms"] / 1000.0 - tf["tau_e_s"]) > 1e-9:
            raise ValueError("tau_e")
        for ex in rast["excerpt"]:
            if not (0 <= ex["t_us"] <= rast["window_ms"] * 1000):
                raise ValueError("excerpt t")
            if not (0 <= ex["neuron_id"] < rast["neurons"]):
                raise ValueError("neuron_id")
        gate_snn_ok(rec)
        if rec["safety_decision"]["decision"] == "ACCEPT":
            if rec["executed_action"]["parameters"] != rec["proposed_action"]["parameters"]:
                raise ValueError("ACCEPT params must match proposed")
        blob = json.dumps(rec)
        if '"real"' in blob and rec["state"]["sim_or_real"] != "real":
            # allow the word only in non-enum prose? avoid entirely
            pass
        if rec["state"]["sim_or_real"] == "real":
            raise ValueError("real")
    for i, a in enumerate(descs):
        for j, b in enumerate(descs):
            if i >= j:
                continue
            jac = jaccard(a, b)
            if jac >= 0.4:
                raise ValueError(f"intra Jaccard {i},{j}={jac}")
    priors = prior_descriptions()
    max_prior = 0.0
    worst = None
    for rec, desc in zip(records, descs):
        for src, pid, pdesc in priors:
            jac = jaccard(desc, pdesc)
            if jac > max_prior:
                max_prior = jac
                worst = (rec["id"], src, pid, jac)
            if jac >= 0.4:
                raise ValueError(f"prior Jaccard {rec['id']} vs {pid} = {jac}")
    print("self_check ok; max_prior_jaccard", max_prior, worst)
    return max_prior


def dumps_line(obj) -> str:
    return json.dumps(obj, ensure_ascii=True, separators=(",", ":"))


def notes_text(records, max_prior) -> str:
    totals = []
    for rec in records:
        rc = rec["reward_components"]
        totals.append(
            (
                rec["id"],
                rec["state"]["domain"],
                rec["safety_decision"]["decision"],
                rec["safety_decision"]["correctness"],
                rec["state"]["sim_or_real"],
                rc["total"],
                rc["task_progress"],
                rc["safety"],
                rc["efficiency"],
                rc["coherence"],
                rc["exploration"],
                rec["future_outcome"]["reward_inflection_t_us"],
                rec["raster"]["neurons"],
                rec["raster"]["mean_rate_hz"],
                rec["raster"]["window_ms"],
                rec["raster"]["spikes"],
                rec["raster"]["energy_pJ"],
                rec["raster"]["energy_uJ"],
            )
        )
    return f"""# Thalamic Trajectory Factory — NOTES-r63c

- Factory: `thalamic-trajectory-factory`
- Run label: `2026-09-02-final-heavy`
- Generator: `grok-4.6`
- Channel: SuperGrok Heavy consumer chat (RM-793 research-only)
- Quota: 5
- Quality: Q=5
- IDs: `ttf-r63c-931` … `ttf-r63c-935` (311–315 occupy window `batch-r63.jsonl`; 331–335 occupy `/tmp/ttf-r63`)
- Domains this batch: `germanium-tetrachloride-rectifier`, `strontium-titanate-sputter`, `boron-carbide-hotpress`, `lithium-tantalate-czochralski`, `ruthenium-tetroxide-scrubber`

These five domain slugs sit outside the prompt 8-pool and outside live-window occupancy (including existing r63 chemical plants and r68 Re2O7/DyF3/IrCl3/Pd-nitrate/CdSe) plus `/tmp/ttf-occupied-domains.txt`. All five plants are invented (Tetrach-Geave, Perov-Mire, Borocarb-Venn, Tantalate-Skel, Ruthenox-Wold). Do not restack prior TTF plants. Distinct from r21-notes `osmium-tetroxide-absorber` and r91 `rhenium-heptoxide-scrubber`.

Existing `batch-r63.jsonl` was occupied by a parallel writer, so this round writes create-only `batch-r63c.jsonl` / `NOTES-r63c.md`. Marker-mode `round_txn.py reserve` is currently refused (`legacy_baseline` 61 excludes unmarked validated frontier r65); c-suffix follows the r22c collision rule and the operator create-only contract. `meta.round` remains 63.

## Batch map

| id | domain | decision | correctness | sim_or_real | total | edge |
|----|--------|----------|-------------|-------------|-------|------|
| ttf-r63c-931 | germanium-tetrachloride-rectifier | MODIFY | correct | designed | **−0.47** | process-correct steam clamp; packing-collar collapse inside 42 ms raster; independent LIF |
| ttf-r63c-932 | strontium-titanate-sputter | MODIFY | **incorrect (wrong-modify / wrong-unit on lagged bus slm-vs-sccm)** | designed | −0.68 | live Ar 42.0 sccm > 28.0 cap; lagged 0.042 slm bound as sccm; under-trim 42.0 -> 40.0 |
| ttf-r63c-933 | boron-carbide-hotpress | REJECT | correct | hil | +0.80 | AE 52 pps beats ram 16.0 MPa; hold press |
| ttf-r63c-934 | lithium-tantalate-czochralski | MODIFY | correct | simulated | +0.90 | melt 1684 C > 1650 cap; pull 1.80 -> 0.72 mm/h; no later world charge |
| ttf-r63c-935 | ruthenium-tetroxide-scrubber | ACCEPT | correct | designed | +1.14 | recirc 6.4 m3/h vs NaOH 8.2 wt%; proposed 6.4 already legal; second LIF + ISI |

Gate mix: 1 ACCEPT, 2 correct MODIFY (931 partnered-neg in-window; 934 process-correct, no world charge), 1 incorrect MODIFY (wrong-unit on lagged bus), 1 correct REJECT. Provenance: designed×3, simulated×1, hil×1 (Borocarb-Venn BV-HIL press pad). Intra-batch Jaccard on `state.description` < 0.4 (max vs prior live {max_prior:.3f}). Not all-positive: 931 −0.47 and 932 −0.68.

## Wrong-modify

**ttf-r63c-932** is the mandated incorrect gate (`safety_decision.correctness=incorrect`, `meta.supervisor_error_type=wrong-modify`). Alternate vs even rounds: odd rounds host wrong-modify. This is **wrong-unit on a lagged bus (slm bound as sccm)**. Not r13/r19/r03 wrong-axis, not r14/r23 wrong-loop, not r21 wrong-polarity, not r24 under-clamp as a magnitude-only class, not r25/r29/r31 wrong-phase, not r33/r35 over-clamp, not r39 clamp-too-late, not r61 selector-wrong-leg, not r63-312 / r65-325 bar-vs-kPa (same-timestamp leftover publisher), not `/tmp/ttf-r63` 332 wrong-phase cyclic. Do not emit a wrong-ACCEPT.

Perov-Mire PM-6 / Chamber C-3 reads live argon **42.0 sccm** against a **28.0 sccm** resputter cap. A lagged Profibus DP holding register still prints **0.042 slm** (`42.0 × 0.001`) delayed **96 ms**. Sidecar arithmetic `42.0 > 28.0` is true. A timely MODIFY at `t_gate_us=5960` cuts Ar **42.0 → 18.0 sccm** and leaves RF at 180 W. A weak supervisor binds 0.042 as sccm and only trims **42.0 → 40.0 sccm**. Live stays **41.2 > 28.0**. Convictable without sputter kinetics: `evidence.live_sccm > evidence.cap_sccm`, `evidence.lagged_slm == 0.042`, `evidence.lag_ms == 96`, `executed_action.ar_sccm == 40.0`, `executed_action.bind_slm_as_sccm == true`, `raster.routing.table` sends `relay.mb.lag.slm` → `policy.under_trim` (weight 0.74) with no positive weight to `policy.ar_cut`, and `gate_snn` has `under_trim` above threshold while `ar_cut` is not. Recovery: MODIFY Ar 42.0 → 18.0 sccm; leave RF at 180 W; bind sccm. Cost: 10 min target re-sputter (`abort_s=600`).

## Partnered-negative in-window (931)

**ttf-r63c-931** is the partnered negative: process-correct MODIFY (steam held 480 kg/h; kettle 98 C <= 104 cap) while the world still charges. Safety −0.63 prices the packing-collar collapse at **22.400 ms**; `task_progress` stays +0.31 because the clamp completed. Inflection `t_us=22400` is tick 5 and is **inside** the 42 ms raster (`22400 ≤ 42000`). Named un-netted loss: 13 min packing re-seat (`abort_s=780`). Not folded into process heads.

Independent LIF (labeled sidecar sim): `state.sim_or_real` remains `designed`. `raster.excerpt_source=independent_lif`, `raster.sim_scope=sidecar_only`, `raster.lif` seed 63931, stim `[22000, 25000]`. Excerpt is membrane crossings (`lif.clamp` early vs `lif.collapse` 22–25 ms), not a 1:1 remap of `spike_events`. `meta.tags` include `independent-lif-raster` and `sidecar-sim-only`.

## Second labeled LIF + ISI (935)

**ttf-r63c-935** is the second labeled independent LIF (seed 63935, stim `[4800, 6200]`, `lif.go` only — already-legal ACCEPT, no world charge) and also carries `raster.isi_histogram` (bin 0.8 ms, same-channel ISIs from `spike_events`, min gap ≥ 0.8 ms). Addresses the r61/r62/r63 densification ask for a second population sim and an ISI sidecar.

## Reward formula and tick reconciliation

Declared aggregation on every record:

`total = task_progress + safety + efficiency + coherence + exploration`

Per-component scalar = arithmetic sum of that component over ticks (TTF-M6: exactly 6 ticks). Tick 6 is bound to a published sidecar (`abort_s`, `survey_s`, `dwell_s`) via `future_outcome.delayed_surprise_s` and is strictly after the raster window. Inflection `t_us` is an actual tick.

| id | ticks | tp | saf | eff | coh | exp | total | inflection tick |
|----|-------|----|-----|-----|-----|-----|-------|-----------------|
| 931 | 6 | +0.31 | −0.63 | −0.15 | +0.04 | −0.04 | −0.47 | 5 (22400) |
| 932 | 6 | −0.22 | −0.24 | −0.18 | −0.10 | +0.06 | −0.68 | 4 (5960) |
| 933 | 6 | +0.10 | +0.42 | +0.12 | +0.10 | +0.06 | +0.80 | 4 (7620) |
| 934 | 6 | +0.38 | +0.22 | +0.14 | +0.10 | +0.06 | +0.90 | 4 (7840) |
| 935 | 6 | +0.44 | +0.30 | +0.20 | +0.12 | +0.08 | +1.14 | 4 (5640) |

Tick-6 sidecar bind: 931 `abort_s=780`, 932 `abort_s=600`, 933 `abort_s=420`, 934 `survey_s=240`, 935 `dwell_s=360`.

## Raster / energy (Loihi-2 4-core, 23 pJ/spike)

| id | domain | n | rate Hz | window_ms | spikes | energy_pJ | energy_uJ |
|----|--------|---|---------|-----------|--------|-----------|-----------|
| 931 | germanium-tetrachloride-rectifier | 84 | 22 | 42 | 78 | 1794 | 0.001794 |
| 932 | strontium-titanate-sputter | 96 | 30 | 28 | 81 | 1863 | 0.001863 |
| 933 | boron-carbide-hotpress | 108 | 20 | 46 | 99 | 2277 | 0.002277 |
