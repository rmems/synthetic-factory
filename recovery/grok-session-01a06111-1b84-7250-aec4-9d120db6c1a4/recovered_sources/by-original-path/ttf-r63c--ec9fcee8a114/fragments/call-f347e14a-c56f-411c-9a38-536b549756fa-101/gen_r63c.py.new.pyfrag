    live_ids, live_domains = prior_ids_domains()
    for rec in records:
        if rec["id"] in live_ids:
            raise SystemExit(f"late id collision {rec['id']}")
        if rec["state"]["domain"] in live_domains or rec["meta"]["domain"] in live_domains:
            raise SystemExit(f"late domain collision {rec['state']['domain']}")
    live_batch = FACTORY / BATCH_NAME
    live_notes = FACTORY / NOTES_NAME
    write_exclusive(live_batch, batch_text)
    write_exclusive(live_notes, notes)
    print("wrote", live_batch, live_notes, "n", len(records))