def audit(rec: dict) -> None:
    hid = hidden_keys(rec)
    if hid:
        raise SystemExit(f"{rec['id']} hidden keys: {hid}")
    steps = rec["steps"]
    n = len(steps)
    if not (12 <= n <= 17):
        raise SystemExit(f"{rec['id']} steps {n}")
    for i, s in enumerate(steps, 1):
        if s["n"] != i:
            raise SystemExit(f"{rec['id']} step n {s['n']} != {i}")
        name = s["tool_call"]["name"]
        if name not in KNOWN_TOOLS:
            raise SystemExit(f"{rec['id']} unknown tool {name}")
        db(s["decision_basis"])
        blob = (s.get("reflection") or "") + " " + (s.get("observation") or "")
        if not any(p in blob.casefold() for p in PROGRESS):
            # allow 429/502 noise turns to use failed/found via reflection
            if not any(p in (s.get("reflection") or "").casefold() for p in PROGRESS):
                raise SystemExit(f"{rec['id']} step {i} missing progress term: {s.get('reflection')!r}")
        if "hypothesis" in (s.get("observation") or "").casefold():
            raise SystemExit(f"{rec['id']} step {i} hypothesis in observation")
    obs = [s["observation"] for s in steps]
    n429 = sum("429" in o for o in obs)
    n502 = sum("502" in o for o in obs)
    if n429 != 1 or n502 != 1:
        raise SystemExit(f"{rec['id']} noise counts 429={n429} 502={n502}")
    ns = rec["meta"]["noise_steps"]
    recov = rec["meta"]["noise_recovery_steps"]
    for code, idx in ns.items():
        if code not in steps[idx - 1]["observation"]:
            raise SystemExit(f"{rec['id']} noise {code} not in step {idx}")
        ridx = recov[code]
        if code in steps[ridx - 1]["observation"]:
            raise SystemExit(f"{rec['id']} recovery step {ridx} repeats {code}")
        if code not in steps[ridx - 1]["decision_basis"]:
            raise SystemExit(f"{rec['id']} recovery step {ridx} basis missing {code}")
    pc = rec["meta"]["plan_change_step"]
    if "Plan change:" not in steps[pc - 1]["reflection"]:
        raise SystemExit(f"{rec['id']} missing Plan change at {pc}")
    nxt = steps[pc]["decision_basis"]
    if "pivot" not in nxt.casefold() and "Pivoting" not in nxt and "pivoting" not in nxt:
        raise SystemExit(f"{rec['id']} next basis missing pivot: {nxt}")
    r = rec["reward"]
    comps = [v for k, v in r.items() if k not in {"success", "total", "aggregation", "cost"} and isinstance(v, (int, float))]
    if abs(sum(comps) - r["total"]) > 1e-9:
        raise SystemExit(f"{rec['id']} reward {sum(comps)} != {r['total']}")
    print(f"OK {rec['id']} steps={n} tools={sorted({s['tool_call']['name'] for s in steps])}")


NOTES = """# ACTF r66 — 2026-09-02-final-heavy (grok-4.6)

Quota Q=2 designed coding episodes (FACTORY_QUOTAS=2). IDs `act-r66-commonprefix-lib64-ploversplit-f6d18c`, `act-r66-s3-acl-enforced-tealcask-b9a427` (mill prefix `act`, unused in-repo). Envelope: id/goal/steps/outcome/reward/meta. Tools restricted to verify_execution KNOWN_TOOLS (`bash`/`read_file`/`edit_file`/`write_file`/`search`/`gh`/`kubectl`/`gate-cli`/`tofu`/`tflint`/`aws`/`jq`/`hcl2json`/`refuse`). meta.round=66 factory=agentic-coding-trajectory-factory generator=grok-4.6 run_label=2026-09-02-final-heavy sim_or_real=designed. meta.rights RM-793 research_only; training_ready false. Live-tree write is create-only (`batch-r66.jsonl`); never clobbered `batch-r01.jsonl` / `NOTES-r01.md` / r02 / r21 / r22 / r41 / r61 / r62 / r63 / r64. Distinct from window r01 (sanderling inclusive-after / whimbrel inflight Map), r02 (jacanasub re.sub count-vs-flags / tattlerbool argparse bool), r21 (duration-json-ns / executescript), r22 (sql-nullstring / samesite-morsel), r41 (unpack-be-le / pvc-rwo), r61 (tzdata-loadlocation / tofu-count-index), r62 (parsedate-minus0000 / dunlincut unsorted dedup), r63 (pem-decode-rest / tofu-moved-block), r64 (inet-aton-abbrev / wait-first-consumer), and mill r37 rstrip charset (this success is os.path.commonprefix vs commonpath, not rune-set rstrip). Addresses r64 NOTES gap by leaving mill lots and Kubernetes YAML; uses hcl2json on aws_s3_bucket_acl vs BucketOwnerEnforced rather than another WaitForFirstConsumer renderer. Invented repos `git.ploverfen.internal/pkg/ploversplit-libroot.git` and `git.tealfen.internal/iac/tealcask-object.git`. Linear RM-793 remains the rights tracker.

| id | codebase / harness | bug class | result | reward.total |
|----|--------------------|-----------|--------|--------------|
| act-r66-commonprefix-lib64-ploversplit-f6d18c | Python 3.12 harbor dest helper + lib-roots fixtures / pytest + aws s3api + jq | schema mismatch: `os.path.commonprefix` mapped lib+lib64 onto `/harbor/lib`; first fix `rstrip('/')` still returned `/harbor/lib` | success; 6/6; PR 661 | 0.58 |
| act-r66-s3-acl-enforced-tealcask-b9a427 | OpenTofu 1.8 aws_s3_bucket harbor stack / tofu test + tflint + hcl2json + gate-cli | schema mismatch: `aws_s3_bucket_acl` under BucketOwnerEnforced planned AccessControlListNotSupported; first fix `bucket-owner-full-control` still created the ACL | incomplete HIL/prod apply; TC-83; freeze TC-60 | 0.28 |

## Step counts, noise, plan change
- act-r66-commonprefix-lib64-ploversplit-f6d18c: 16 steps. 429 at step 4 (`gh api` cpython os.path.rst, retry-after 5) -> recovery step 5 (`sleep 6` + read `docs/commonprefix-lib64.md`). 502 at step 6 (`aws s3api get-object` ploverfen-specs lib-roots ELB) -> recovery step 7 (`jq` committed `fixtures/lib-roots.json` against stale `fixtures/lib-roots.stale.json`). Plan change at step 8: jq join shows want already `/harbor` and got is commonprefix `/harbor/lib` on a committed lib+lib64 pair; abandon truncated-object. Debug loop: 9 edit rstrip -> 10 write mixed-root pytest -> 11 FAIL got `/harbor/lib` -> 12 reviewer keep-rstrip rejected -> 13 re-read SharedDest -> 14 commonpath patch -> 15 6 passed.
- act-r66-s3-acl-enforced-tealcask-b9a427: 17 steps. 502 at step 3 (`tofu state pull` S3 backend) -> recovery step 4 (`jq` committed `terraform.tfstate` writes /tmp/tealcask-state.json). 429 at step 6 (`gh api` terraform-provider-aws s3_bucket_acl.html.markdown, retry-after 7) -> recovery step 7 (read vendored `docs/s3-acl-enforced.md`). Plan change at step 8: hcl2json shows ownership BucketOwnerEnforced while config still declares aws_s3_bucket_acl.harbor; abandon remounting remote state. Debug loop: 10 edit bucket-owner-full-control -> 11 write no_acl tofu test -> 12 FAIL got create=aws_s3_bucket_acl.harbor -> 13 re-read helper -> 14 drop ACL resource -> 15 5 passed. `refuse` at step 9 blocks `tofu destroy`. gate-cli REJECT at 16; TC-83 at 17.

## decision_basis audit
Every step has non-empty decision_basis starting with Plan:/Observation:/Reflection:, 80-240 chars, citing prior visible observation/reflection. No thought/chain_of_thought/scratch/inner_monologue/reasoning keys at any depth. Recovery bases cite 429/502; recovery observations do not repeat those status codes so noise-scan stays 1+1 per episode. Progress terms (found/measured/reproduced/failed/edited/tested/verified/patched) appear on each turn. Word "hypothesis" kept out of observations.

## Reward
Unweighted numeric sum; success is a label. Cost sits under reward.cost. commonprefix-lib64: 0.40+0.12+0.08-0.02=0.58. s3-acl-enforced: 0.24+0.10+0.08-0.12-0.02=0.28.

## Realism / weak recovery
Good: `os.path.commonprefix(['/harbor/lib/...','/harbor/lib64/...'])` returning `/harbor/lib` is a real stdlib footgun (`commonpath` yields `/harbor`); `rstrip('/')` is the equally tempting slash-shaped wrong fix and the mixed-root test names the contract (`lib` plus `lib64` stay `/harbor`, not overlay). `aws_s3_bucket_acl` beside `BucketOwnerEnforced` is the usual PutBucketAcl AccessControlListNotSupported trap; `acl=bucket-owner-full-control` still cannot satisfy a test that forbids creating `aws_s3_bucket_acl.harbor`. Stale 502 fallback now compares dest want `/harbor` against a second file still on `/harbor/lib` (r61 densification). Reviewer keep-rstrip is an explicit rejected keep-wrong-fix (r64 densification). hcl2json at the plan-change names ownership vs ACL as two resources rather than a single jq blob. gate-cli freeze plus refuse-destroy is an honest apply block, not a silent skip. Weak: lib64 overlay is a designed harbor crane convention rather than a second document whose dest still disagrees after commonpath; tofu state dump still omits a rewritten ACL instance after the drop. Next densification: a 502 whose local lib-roots fixture is rewritten after the commonpath patch and still lists `/harbor/lib`, or a reviewer asking to keep `aws_s3_bucket_acl` "so operators can grep canned ACL=private from runbooks".

Novel coverage: 43%
"""


def main() -> int:
    recs = [ep1(), ep2()]
    for rec in recs:
        audit(rec)
    out = Path("/tmp/actf-r66")
    batch = out / "batch-r66.jsonl"
    notes = out / "NOTES-r66.md"
    with batch.open("w", encoding="utf-8") as f:
        for rec in recs:
            f.write(json.dumps(rec, ensure_ascii=False, separators=(",", ":")) + "\n")
    notes.write_text(NOTES, encoding="utf-8")
    print("wrote", batch, batch.stat().st_size)
    print("wrote", notes, notes.stat().st_size)
    return 0


if __name__ == "__main__":
    sys.exit(main())
