def db(s: str) -> str:
    if not s.startswith(LABELS):
        raise SystemExit(f"bad label: {s[:40]!r}")
    n = len(s)
    if not (80 <= n <= 240):
        raise SystemExit(f"decision_basis len {n}: {s}")
    return s


def hidden_keys(obj, path=""):
    found = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            child = f"{path}.{k}" if path else k
            nk = re.sub(r"[^a-z0-9]+", "_", str(k)).casefold().strip("_")
            if nk in HIDDEN or str(k).casefold() in HIDDEN:
                found.append(child)
            found.extend(hidden_keys(v, child))
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            found.extend(hidden_keys(v, f"{path}[{i}]"))
    return found


