'''
if extra_banned_dom not in head:
    head = head.replace(
        '    "indium-phosphide-mbe",\n}',
        extra_banned_dom + "}",
    )
extra_plants = '''    "Phosphide-Cairn",
    "Ldpe-Grain",
    "Oxirane-Clough",
    "Tinbath-Howe",
    "Diene-Riggs",
    "Cobalt-Wyke",
    "Trifluor-Yett",
    "Tolylene-Swale",
    "Cryolith-Brae",
    "Ammperch-Stoup",
    "Alkylal-Voe",
    "Dithion-Hawse",
    "Mibk-Grain",
    "Lithcox-Beck",
    "Morphol-Gair",
    "Ppta-Slack",
    "Mibket-Holme",
    "Dehydro-Howden",
    "Sulfol-Dumble",
    "Pyrrol-Knowe",
    "Isophor-Taing",
