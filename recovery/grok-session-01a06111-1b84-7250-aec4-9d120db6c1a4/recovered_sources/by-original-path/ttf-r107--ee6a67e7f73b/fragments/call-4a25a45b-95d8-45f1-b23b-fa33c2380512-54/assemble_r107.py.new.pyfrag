'''
if extra_plants not in head:
    head = head.replace('    "Phosphide-Cairn",\n)', extra_plants + ")")
head = head.replace('("round", 97)', '("round", 107)')
head = head.replace(
    '"""Prior staged batches + in-flight gens are global occupancy. r97 must not reuse them."""',
    '"""Prior staged batches + in-flight gens are global occupancy. r107 must not reuse them."""',
)
head = head.replace('skip = {"ttf-r97"}', 'skip = {"ttf-r107"}')

# tail transforms
repls = [
    ("ttf-r97-501", "ttf-r107-551"),
    ("ttf-r97-502", "ttf-r107-552"),
    ("ttf-r97-503", "ttf-r107-553"),
    ("ttf-r97-504", "ttf-r107-554"),
    ("ttf-r97-505", "ttf-r107-555"),
    ("record_501()", "record_551()"),
