)""",
)
extra_banned_dom = '''    "indium-phosphide-mbe",
    "ldpe-autoclave",
    "ethylene-oxide-tubular",
    "float-glass-tin-bath",
    "polybutadiene-solution-kettle",
    "cobalt-electrowin-cell",
