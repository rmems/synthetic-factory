)
head = head.replace('OUT_DIR = Path("/tmp/ttf-r97")', 'OUT_DIR = Path("/tmp/ttf-r107")')
head = head.replace("batch-r97.jsonl", "batch-r107.jsonl")
head = head.replace("NOTES-r97.md", "NOTES-r107.md")
head = head.replace(
    """THIS_DOMAINS = {
    "nitrogen-trifluoride-cell",
