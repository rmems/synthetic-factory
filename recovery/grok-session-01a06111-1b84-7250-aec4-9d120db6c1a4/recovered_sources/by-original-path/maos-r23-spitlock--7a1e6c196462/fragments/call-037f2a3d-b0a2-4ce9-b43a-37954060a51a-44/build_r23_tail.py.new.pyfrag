def write_transcript(rec, line):
    text = f"""# Multi-Agent Ouroboros Swarm — Round 23 transcript

Factory: multi-agent-ouroboros-swarm
Run: 2026-09-02-final-heavy
Generator: grok-4.6
Record id: maos-r23-001
