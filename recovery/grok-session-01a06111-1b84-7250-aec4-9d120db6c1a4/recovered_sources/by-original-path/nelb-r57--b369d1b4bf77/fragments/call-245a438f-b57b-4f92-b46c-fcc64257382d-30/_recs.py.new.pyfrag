    )
    w_s = 0.040
    events = [
        ev(0.0, "zr.E", 0.00, code="E_MV", units="mV", note="plant-owned zirconia Nernst cell on YF-7 tank T-2 crown; in-situ electrochemical O2 family, not paramagnetic dumbbell, not CEMS FTIR k-script, not TDLAS NH3, not CRDS HF, not QEPAS, not CLD NOx, not TEOM PM"),
