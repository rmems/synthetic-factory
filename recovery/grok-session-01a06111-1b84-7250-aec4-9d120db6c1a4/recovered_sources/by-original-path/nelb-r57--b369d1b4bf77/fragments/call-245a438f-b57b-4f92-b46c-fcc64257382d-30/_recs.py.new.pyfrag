# Record 172 — zirconia Nernst in-situ O2 of a glass-furnace crown, designed,
# REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_172():
    k_e = 0.050
    t_k = 1000.0
    t0_k = 1000.0
    e_mv = 50.00
    e0_mv = 0.00
    p_ref = 20.00
    decade = e_mv / (k_e * t_k)
    p_o2 = p_ref / (10.0 ** decade)
    nernst_e = k_e * t_k * math.log10(p_ref / p_o2)
    lam = p_ref / p_o2
    _exact(t_k / t0_k, 1.000)
    _exact(decade, 1.00)
    _exact(p_o2, 2.00)
    _exact(nernst_e, 50.00)
    _exact(lam, 10.00)
    _exact(p_ref / (10.0 ** (0.00 / (k_e * t_k))), 20.00)
    _exact(p_ref / (10.0 ** (100.00 / (k_e * t_k))), 0.20)
    _exact(k_e * t_k * math.log10(20.00 / 2.00), 50.00)
    _exact(6000.0 + 1080.0, 7080.0)

    raster = make_raster(
        neurons=20,
        mean_rate_hz=50.0,
