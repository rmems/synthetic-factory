        ev(1800000.0, "zr.E", 100.00, code="E_MV", units="mV"),
        ev(2100000.0, "recon.P", 0.20, code="P_VOLPCT", units="volpct", note="20.00/10**(100.00/(0.050*1000))=0.20"),
