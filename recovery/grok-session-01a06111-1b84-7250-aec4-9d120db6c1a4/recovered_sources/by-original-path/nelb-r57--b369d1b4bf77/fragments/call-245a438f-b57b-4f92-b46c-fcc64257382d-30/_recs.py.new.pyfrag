# ---------------------------------------------------------------------------
# Record 173 — photoionization-detector VOC of a BTX stripper vent, hil,
# MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_173():
    k_i = 4.00
    i_na = 16.00
    i_dark = 3.50
    di = i_na - i_dark
    c_ppm = k_i * di
    i_lamp = 12.00
    i_lamp0 = 12.00
    s_lamp = i_lamp / i_lamp0
    c_corr = c_ppm / s_lamp
    _exact(di, 12.50)
    _exact(c_ppm, 50.00)
    _exact(s_lamp, 1.00)
    _exact(c_corr, 50.00)
    _exact(k_i * (6.00 - i_dark), 10.00)
    _exact(k_i * (11.00 - i_dark), 30.00)
    _exact(k_i * (13.50 - i_dark), 40.00)
    _exact(2820.0 + 1440.0, 4260.0)

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=32.0,
        seed=202609173,
        source="sw5.pid.ion",
        target="sorrelwick.strip_isolate_core",
        table=[
            {"from": "pid_I", "to": "voc_estimator", "weight": 1.35},
            {"from": "pid_snr", "to": "lamp_norm_core", "weight": 1.20},
