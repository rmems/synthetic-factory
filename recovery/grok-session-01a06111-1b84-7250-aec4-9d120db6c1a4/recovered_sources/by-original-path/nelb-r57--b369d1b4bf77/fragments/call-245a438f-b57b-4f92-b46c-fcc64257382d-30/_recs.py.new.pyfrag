# ---------------------------------------------------------------------------
# Record 174 — contact pulse-echo remaining wall of a fired-heater tube, simulated,
# ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_174():
    c_mm_us = 6.00
    tof_us = 4.00
    d_mm = c_mm_us * tof_us / 2.0
    t_nom = 20.00
    loss_mm = t_nom - d_mm
    rt_us = 2.0 * d_mm / c_mm_us
    _exact(d_mm, 12.00)
    _exact(loss_mm, 8.00)
    _exact(rt_us, 4.00)
    _exact(c_mm_us * 6.00 / 2.0, 18.00)
    _exact(c_mm_us * 5.00 / 2.0, 15.00)
    _exact(c_mm_us * 4.00 / 2.0, 12.00)
    _exact(20.00 - 18.00, 2.00)
    _exact(20.00 - 15.00, 5.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=36.0,
        seed=202609174,
        source="th8.pe.wall",
        target="tansyholt.tube_accept_core",
        table=[
            {"from": "pe_tof", "to": "wall_estimator", "weight": 1.40},
            {"from": "pe_c", "to": "vel_norm_core", "weight": 1.20},
            {"from": "pingveil_d", "to": "vendor_skip_advocate", "weight": 0.50},
        ],
        third_factor={
            "modulator": "na.tube_scope_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": "pre-post coincidence on skip-tube synapses; the pulse-echo modulator enables potentiation only while ToF and velocity are co-active inside tau_e so a Pingveil last-good cannot skip tubes T-5 and T-7 on a 12.00 mm remaining wall",
        },
        channel_prefix="pe.n",
        anchor="TH-8 PE-SIM-4 36 ms frame at ToF 4.00 us / c 6.00 mm/us (t_s 3000) reconstructing 12.00 mm remaining wall on T-6 below the 14.00 isolate floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "pe.t", 6.00, code="TOF_US", units="us", note="simulated contact pulse-echo of TH-8 fired-heater tube T-6; remaining-wall family, not TOFD ligament, not PAUT TFM, not EMAT SH, not Lamb-wave, not impact-echo, not FSM, not ER probe, not DCPD, not RFEC, not PEC"),
        ev(300000.0, "pe.c", 6.00, code="C_MM_US", units="mm_us", note="shear-longitudinal mix velocity; held at 6.00"),
        ev(600000.0, "recon.d", 18.00, code="D_MM", units="mm", note="6.00*6.00/2=18.00 exact"),
        ev(900000.0, "pe.snr", 14.0, code="PE_SNR", units="1"),
        ev(1200000.0, "pingveil.d", 18.40, code="VENDOR_MM", units="mm", note="Pingveil last-campaign remaining-wall cloud; patched residual 18.00 mm"),
        ev(1800000.0, "pe.t", 5.00, code="TOF_US", units="us"),
        ev(2100000.0, "recon.d", 15.00, code="D_MM", units="mm", note="6.00*5.00/2=15.00; still above the 14.00 isolate floor"),
        ev(2400000.0, "recon.loss", 5.00, code="LOSS_MM", units="mm", note="20.00-15.00=5.00; wall-loss identity at this frame"),
        ev(2700000.0, "pe.snr", 16.0, code="PE_SNR", units="1"),
        ev(3000000.0, "pe.t", 4.00, code="TOF_US", units="us", note="in-band frame; raster sidecar"),
        ev(3000001.5, "pe.c", 6.00, code="C_MM_US", units="mm_us", note="1.5 ms velocity-norm after ToF"),
        ev(3300000.0, "recon.d", 12.00, code="D_MM", units="mm", note="6.00*4.00/2=12.00 exact; isolate 14.00, heater-trip 8.00"),
        ev(3600000.0, "pingveil.d", 18.40, code="VENDOR_MM", units="mm"),
        ev(3900000.0, "tube.id", 6.0, code="TUBE", units="id"),
        ev(4200000.0, "t57.present", 1.0, code="T57_PRESENT", units="bool", note="adjacent tubes T-5 and T-7 are the skip-isolate object, not this tube"),
        ev(4800000.0, "ops.prop", 1.0, code="ACCEPT_AND_SKIP", units="bool", note="heater lead Oren Voss: T-6 is green on Pingveil 18.40; skip T-5 and T-7 to save a morning survey"),
