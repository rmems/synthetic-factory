def diagnosis_md(shared, root, cascade, catch, sketch, delta):
    body = json.dumps(shared, indent=2, ensure_ascii=True)
    target = json.dumps(delta, indent=2, ensure_ascii=True)
    return (
        "# Diagnosis\n\n"
        "## Shared context\n\n"
        f"```json\n{body}\n```\n\n"
        "## Root cause\n\n"
        f"{root}\n\n"
        "## Cascade effects\n\n"
        f"{cascade}\n\n"
        "## Supervisor catch\n\n"
        f"{catch}\n\n"
        "## Repair sketch\n\n"
        f"{sketch}\n\n"
        "## Target reward delta\n\n"
        f"```json\n{target}\n```\n"
    )


