            (9600.0, "soak.held", 1.0, {"code": "SOAK_HELD", "units": "bool"}),
            (9900.0, "skin.C", 310.0, {"code": "SKIN_C", "units": "C"}),
            (10200.0, "espi.snr", 15.0, {"code": "ESPI_SNR", "units": "1"}),
            (10500.0, "espi.L", 0.80, {"code": "L_M", "units": "m"}),
            (10800.0, "recon.Ninv", 2.50, {"code": "N_PER_UM", "units": "fringe_um"}),
            (11100.0, "laser.mW", 40.00, {"code": "LASER_MW", "units": "mW"}),
            (11400.0, "espi.N", 20.00, {"code": "N_FR", "units": "fringe"}),
            (11700.0, "recon.d", 8.00, {"code": "D_UM", "units": "um", "note": "0.40*20.00=8.00; still at isolate floor so S-4 hold stays"}),
            (12000.0, "speckleveil.d", 1.20, {"code": "VENDOR_UM", "units": "um"}),
            (12300.0, "s1.skip", 1.0, {"code": "S1_OUT_OF_SCOPE", "units": "bool"}),
            (12600.0, "s3.skip", 1.0, {"code": "S3_OUT_OF_SCOPE", "units": "bool"}),
            (12900.0, "feed.pu", 0.80, {"code": "FEED_PU", "units": "pu"}),
            (13200.0, "gate.held", 1.0, {"code": "S4_ONLY", "units": "bool"}),
        ]
    )
    assert_stream(events)

    traj = {
