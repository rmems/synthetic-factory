# ---------------------------------------------------------------------------
# a3 — electronic speckle-pattern interferometry of a hydrocracker skirt, simulated, ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_a3():
    k_e = 0.40
    n_fr = 30.00
    d_um = k_e * n_fr
    _exact(d_um, 12.00)
    _exact(k_e * 10.00, 4.00)
    _exact(k_e * 20.00, 8.00)
    _exact(k_e * 38.00, 15.20)
    l_m = 0.80
    eps_ue = d_um / l_m
    _exact(eps_ue, 15.00)
    _exact(8.00 / l_m, 10.00)
    _exact(6000.0 + 720.0, 6720.0)

    raster = make_raster(
        neurons=16,
        mean_rate_hz=75.0,
        window_ms=36.0,
        seed=2026090423,
        source="ts5.espi.skirt_s4",
        target="tarspire.isolate_accept_core",
        table=[
            {"from": "espi_N", "to": "disp_estimator", "weight": 1.40},
            {"from": "espi_L", "to": "gauge_norm_core", "weight": 1.10},
            {"from": "speckleveil_d", "to": "vendor_skip_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "na.espi_buckle_eligibility",
            "tau_e_s": 2.0,
            "tau_e_ms": 2000.0,
            "eligibility": (
                "pre-post coincidence on skip-isolate synapses; the ESPI modulator "
                "depresses skip-isolate links when fringe order stays high inside tau_e "
                "of a gauge-length sample so a Speckleveil 1.20 um stamp cannot hide a "
                "12.00 um skirt buckle"
            ),
        },
        channel_prefix="espi.n",
        anchor=(
            "TS-5 ESPI 36 ms frame at N 30.00 fringes (t_s 3000) reconstructing "
            "12.00 um above the 8.00 um isolate floor"
        ),
    )
    w_s = 0.036
    events = events_from_rows(
        [
            (0.0, "espi.N", 10.00, {"code": "N_FR", "units": "fringe", "note": "simulated electronic speckle-pattern interferometry on Tarspire TS-5 skirt S-4 in ESPI-SIM-3; out-of-plane displacement of a hydrocracker skirt, not digital shearography hull, not DIC hoop-strain, not acoustoelastic birefringence, not OCT TBC"}),
            (180.0, "espi.L", 0.80, {"code": "L_M", "units": "m", "note": "gauge length; epsilon_ue = d_um / L_m"}),
            (360.0, "recon.d", 4.00, {"code": "D_UM", "units": "um", "note": "0.40*10.00=4.00 exact"}),
            (540.0, "lvdt.um", 11.6, {"code": "LVDT_UM", "units": "um", "note": "plant LVDT on copper; independent of Speckleveil last-good"}),
            (720.0, "speckleveil.d", 1.20, {"code": "VENDOR_UM", "units": "um", "note": "Speckleveil last-good ESPI inversion; not admissible SoT"}),
            (900.0, "espi.N", 20.00, {"code": "N_FR", "units": "fringe"}),
            (1080.0, "recon.d", 8.00, {"code": "D_UM", "units": "um", "note": "0.40*20.00=8.00 exact; isolate floor"}),
            (1260.0, "espi.snr", 11.0, {"code": "ESPI_SNR", "units": "1", "note": "under 12.0 lock"}),
            (1440.0, "laser.mW", 40.00, {"code": "LASER_MW", "units": "mW"}),
            (1620.0, "recon.eps", 10.00, {"code": "EPS_UE", "units": "ue", "note": "8.00/0.80=10.00"}),
            (1800.0, "skin.C", 318.0, {"code": "SKIN_C", "units": "C"}),
            (1980.0, "speckleveil.d", 1.18, {"code": "VENDOR_UM", "units": "um"}),
            (2160.0, "lvdt.um", 11.8, {"code": "LVDT_UM", "units": "um"}),
            (2340.0, "espi.snr", 13.0, {"code": "ESPI_SNR", "units": "1"}),
            (2520.0, "espi.N", 20.00, {"code": "N_FR", "units": "fringe"}),
            (2700.0, "recon.d", 8.00, {"code": "D_UM", "units": "um", "note": "0.40*20.00=8.00"}),
            (2880.0, "skin.C", 322.0, {"code": "SKIN_C", "units": "C"}),
            (3000.0, "espi.N", 30.00, {"code": "N_FR", "units": "fringe", "note": "isolate-floor frame; raster sidecar"}),
            (3000.0015, "espi.L", 0.80, {"code": "L_M", "units": "m", "note": "1.5 ms gauge-norm after fringe count"}),
            (3180.0, "recon.d", 12.00, {"code": "D_UM", "units": "um", "note": "0.40*30.00=12.00 exact; isolate floor 8.00, tripwire 16.00"}),
            (3360.0, "recon.eps", 15.00, {"code": "EPS_UE", "units": "ue", "note": "12.00/0.80=15.00 exact"}),
            (3540.0, "recon.Ninv", 2.50, {"code": "N_PER_UM", "units": "fringe_um", "note": "30.00/12.00=2.50 exact; 1/k_e"}),
            (3720.0, "espi.snr", 16.0, {"code": "ESPI_SNR", "units": "1", "note": "16.0 >= 12.0 lock"}),
            (3900.0, "speckleveil.d", 1.20, {"code": "VENDOR_UM", "units": "um"}),
            (4200.0, "ops.prop", 1.0, {"code": "ISOL_S4", "units": "bool", "note": "survey lead Ivo Marsh: isolate skirt S-4 only; Speckleveil 1.20 um is last-good not SoT"}),
            (4500.0, "gate.ok", 1.0, {"code": "ACCEPT", "units": "decision", "note": "bounded ACCEPT of S-4 isolate; S-1..S-3 out of scope"}),
            (4800.0, "skirt.lock", 1.0, {"code": "S4_ISOL", "units": "bool"}),
            (5100.0, "lvdt.um", 12.2, {"code": "LVDT_UM", "units": "um"}),
            (6000.0, "soak.start", 1.0, {"code": "SOAK_START", "units": "bool", "note": "bookend 1 of the 12.0 min survey floor"}),
            (6720.0, "soak.floor", 1.0, {"code": "SOAK_FLOOR", "units": "bool", "note": "6000 s + 720 s = 6720 s = 12.0 min"}),
            (6900.0, "ops.xtra", 1.0, {"code": "SKIP_ISOL", "units": "bool", "note": "Jory Flint: skip S-4 isolate and keep 1.00 pu while the crew is on site"}),
            (7200.0, "gate.no", 1.0, {"code": "REJECT", "units": "decision", "note": "companion t2 REJECTS skip-isolate; S-4 isolate already authorized"}),
            (7500.0, "espi.N", 38.00, {"code": "N_FR", "units": "fringe"}),
            (7800.0, "recon.d", 15.20, {"code": "D_UM", "units": "um", "note": "0.40*38.00=15.20; still under 16.00 tripwire so S-4 isolate may complete without extra skirts"}),
            (8100.0, "recon.eps", 19.00, {"code": "EPS_UE", "units": "ue", "note": "15.20/0.80=19.00"}),
            (8400.0, "speckleveil.d", 1.15, {"code": "VENDOR_UM", "units": "um"}),
            (8700.0, "lvdt.um", 12.0, {"code": "LVDT_UM", "units": "um"}),
            (9000.0, "skirt.held", 1.0, {"code": "S4_HELD", "units": "bool"}),
