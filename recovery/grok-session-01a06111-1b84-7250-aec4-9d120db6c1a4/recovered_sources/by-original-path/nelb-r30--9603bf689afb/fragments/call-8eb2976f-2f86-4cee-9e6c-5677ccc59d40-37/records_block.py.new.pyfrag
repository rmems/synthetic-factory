                "reconstruction_model": "discharged as an on-record calculator",
            },
            "latency_ms": 2700000.0,
        },
        "reward_components": reward(
            0.41,
            [
                ("mossbauer_reconstruction", 0.14),
                ("overox_floor_derate", 0.12),
                ("vendor_stamp_nonsubstitution", 0.10),
                ("soak_floor_in_stream", 0.08),
                ("air_cut_conversion_cost", -0.03),
            ],
            "scored for a keep-1.00 MODIFY on a recomputable Fe-57 isomer shift while refusing a Mossveil last-good corridor; 24 min floor is priced as downtime not as a reason to wait",
        ),
        "meta": meta_common(
            tags=["MODIFY", "mossbauer-fe57", "serialized-reconstruction", "operational-companion"],
            distillation_note="Mössbauer air gate: drive-channel isomer-shift reconstruction beats a green vendor last-good dashboard; companion t2 holds 0.85 pu rather than restoring on Mossveil",
        ),
    }
    traj2 = {
        "id": "nelb-r30-091-t2",
        "state": {
