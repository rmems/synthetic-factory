# ---------------------------------------------------------------------------
# Record 091 — Fe-57 Mössbauer isomer-shift FCC regenerator, designed, MODIFY / ACCEPT
# ---------------------------------------------------------------------------
def rec_091():
    k_ch = 0.040
    ch0 = 12.00
    ch = 42.00
    delta = k_ch * (ch - ch0)
    a_fe2 = 1.20
    a_fe3 = 4.80
    f_fe3 = a_fe3 / (a_fe2 + a_fe3)
    if abs(delta - 1.20) > 1e-12:
        raise RuntimeError(delta)
    if abs(f_fe3 - 0.80) > 1e-12:
        raise RuntimeError(f_fe3)
    if abs(0.040 * (18.00 - 12.00) - 0.24) > 1e-12:
        raise RuntimeError("early delta")
    if abs(0.040 * (30.00 - 12.00) - 0.72) > 1e-12:
        raise RuntimeError("mid delta")
    if abs(0.040 * (38.00 - 12.00) - 1.04) > 1e-12:
        raise RuntimeError("post delta")
    if abs(6600 + 1440 - 8040) > 1e-12:
        raise RuntimeError("soak floor")
    if abs(12.00 * 0.85 - 10.20) > 1e-12:
        raise RuntimeError("air cut")

    raster = make_raster(
        neurons=20,
        mean_rate_hz=50.0,
        window_ms=36.0,
        seed=202609091,
        source="gm7.moss.drive",
        target="gorsemere.air_cut_core",
        table=[
            {"from": "moss_ch", "to": "isomer_estimator", "weight": 1.40},
            {"from": "moss_k", "to": "drive_norm_core", "weight": 1.20},
            {"from": "mossveil_d", "to": "vendor_continue_advocate", "weight": 0.45},
        ],
        third_factor={
            "modulator": "na.fe3_isomer_salience",
            "tau_e_s": 1.6,
            "tau_e_ms": 1600.0,
            "eligibility": "pre-post coincidence on regenerator-air synapses; the Mössbauer modulator enables potentiation only while drive-norm is co-active inside tau_e so a Mossveil last-good corridor cannot hide a 1.20 mm/s Fe3+ isomer shift",
        },
        channel_prefix="moss.n",
        anchor="GM-7 Mössbauer 36 ms frame at ch 42.00 / k_ch 0.040 mm/s (t_s 3000) reconstructing 1.20 mm/s above the 0.90 mm/s over-oxidation floor",
    )
    w_s = 0.036
    events = [
        ev(0.0, "moss.ch", 18.00, code="CH", units="channel", note="plant-owned Fe-57 constant-acceleration drive on regenerator RG-2 fines; not LIBS, not PGNAA, not fab OES"),
        ev(300000.0, "moss.k", 0.040, code="K_CH", units="mm_s_per_ch", note="drive calibration; delta = k_ch * (ch - ch0)"),
        ev(600000.0, "recon.d", 0.24, code="DELTA_MM_S", units="mm_s", note="0.040*(18.00-12.00) = 0.24 exact"),
        ev(1200000.0, "o2.pct", 2.10, code="O2_PCT", units="pct", note="regenerator dense-bed O2 corridor; looks lean"),
        ev(1800000.0, "mossveil.d", 0.22, code="VENDOR_MM_S", units="mm_s", note="Mossveil last-good fresh-catalyst stamp; not admissible SoT"),
        ev(2400000.0, "moss.ch", 30.00, code="CH", units="channel"),
        ev(2700000.0, "recon.d", 0.72, code="DELTA_MM_S", units="mm_s", note="0.040*(30.00-12.00) = 0.72"),
        ev(3000000.0, "moss.ch", 42.00, code="CH", units="channel", note="over-oxidation-floor frame; raster sidecar"),
        ev(3000001.4, "moss.k", 0.040, code="K_CH", units="mm_s_per_ch", note="1.4 ms drive-norm after channel"),
        ev(3300000.0, "recon.d", 1.20, code="DELTA_MM_S", units="mm_s", note="0.040*(42.00-12.00) = 1.20 exact; floor 0.90"),
        ev(3600000.0, "a.fe2", 1.20, code="A_FE2", units="au", note="low-velocity Fe2+ doublet area"),
        ev(3900000.0, "a.fe3", 4.80, code="A_FE3", units="au", note="high-velocity Fe3+ doublet area"),
        ev(4200000.0, "recon.f", 0.80, code="F_FE3", units="frac", note="4.80/(1.20+4.80) = 0.80 exact; floor 0.65"),
        ev(4500000.0, "o2.pct", 1.80, code="O2_PCT", units="pct"),
        ev(4800000.0, "mossveil.d", 0.22, code="VENDOR_MM_S", units="mm_s"),
        ev(5100000.0, "regen.T", 705.0, code="REGEN_C", units="C", note="dense-bed temperature corridor; not isomer shift"),
        ev(5400000.0, "ops.prop", 1.0, code="KEEP_1PU_AIR", units="bool", note="shift chemist Tamsin Quag: keep 1.00 air; Mossveil 0.22 and O2 1.80"),
        ev(5700000.0, "gate.air", 1.0, code="MODIFY", units="decision", note="derate combustion air to 0.85 pu; 1.20 mm/s and f_Fe3 0.80"),
        ev(6000000.0, "air.set", 0.85, code="PU", units="pu", note="12.00 * 0.85 = 10.20 t/h"),
        ev(6600000.0, "soak.start", 1.0, code="SOAK_START", units="bool", note="bookend 1 of the 24.0 min regenerator settle floor"),
        ev(7200000.0, "moss.lock", 1.20, code="LOCKED_MM_S", units="mm_s"),
        ev(7800000.0, "regen.T", 698.0, code="REGEN_C", units="C"),
        ev(8040000.0, "soak.floor", 1.0, code="SOAK_FLOOR", units="bool", note="6600 s + 1440 s = 8040 s = 24.0 min"),
        ev(9000000.0, "ops.restore", 1.0, code="RESTORE_1PU", units="bool", note="Quag: Mossveil 0.20, restore 1.00 air"),
        ev(9600000.0, "gate.exec", 1.0, code="ACCEPT", units="decision", note="companion t2: hold 0.85; Mossveil restore refused"),
        ev(10200000.0, "air.held", 0.85, code="PU_HELD", units="pu"),
        ev(10800000.0, "mossveil.d", 0.20, code="VENDOR_MM_S", units="mm_s"),
        ev(11400000.0, "recon.d", 1.04, code="DELTA_MM_S", units="mm_s", note="post-cut sample 0.040*(38.00-12.00) = 1.04"),
        ev(12000000.0, "o2.pct", 1.70, code="O2_PCT", units="pct"),
        ev(12600000.0, "dump.hold", 0.0, code="DUMP_T", units="t", note="inventory dump not taken; isolate floor is 1.80 mm/s"),
        ev(13200000.0, "regen.T", 680.0, code="REGEN_C", units="C"),
        ev(13800000.0, "trip.hold", 0.0, code="TRIP_MM_S", units="mm_s", note="peak 1.20 vs 1.80 isolate floor; regenerator trip not taken"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r30-091-t1",
        "state": {
            "sim_or_real": "designed",
            "episode_id": "GM-MOSS-2026-0611",
            "domain": "mossbauer_fcc_regenerator",
            "setting": "Gorsemere FCC GM-7 (invented), regenerator RG-2. Plant-owned Fe-57 constant-acceleration Mössbauer drive on cyclone fines. Mossveil vendor last-good isomer-shift cloud is a corridor witness, not the oxidation SoT. Invented plant; designed campaign. Not LIBS (r19/r21/r22), not PGNAA Bogue (r15), not fab OES (r11), not QEPAS DGA (r19), not helium RGA (r24).",
