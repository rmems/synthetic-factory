# ---------------------------------------------------------------------------
# Record 092 — GB-InSAR tailings-dam LOS, hil, REJECT / MODIFY
# ---------------------------------------------------------------------------
def rec_092():
    k_los = 2.50
    phi = 4.80
    d_mm = k_los * phi
    dt_d = 0.50
    v_mm_d = d_mm / dt_d
    if abs(d_mm - 12.00) > 1e-12:
        raise RuntimeError(d_mm)
    if abs(v_mm_d - 24.00) > 1e-12:
        raise RuntimeError(v_mm_d)
    if abs(2.50 * 1.20 - 3.00) > 1e-12:
        raise RuntimeError("early d")
    if abs(2.50 * 2.40 - 6.00) > 1e-12:
        raise RuntimeError("mid d")
    if abs(2.50 * 3.20 - 8.00) > 1e-12:
        raise RuntimeError("post d")
    if abs(8.00 / 0.50 - 16.00) > 1e-12:
        raise RuntimeError("post v")
    if abs(1800 + 2700 - 4500) > 1e-12:
        raise RuntimeError("survey floor")
    if abs(14.00 - 1.50 - 12.50) > 1e-12:
        raise RuntimeError("pool drop")

    raster = make_raster(
        neurons=25,
        mean_rate_hz=50.0,
        window_ms=28.0,
        seed=202609092,
        source="bt4.insar.ku",
        target="brindlescree.pool_stop_core",
        table=[
            {"from": "insar_phi", "to": "los_estimator", "weight": 1.35},
            {"from": "insar_k", "to": "los_gain_core", "weight": 1.25},
            {"from": "slopeveil_v", "to": "vendor_continue_advocate", "weight": 0.40},
        ],
        third_factor={
            "modulator": "da.slope_los_error",
            "tau_e_s": 0.9,
            "tau_e_ms": 900.0,
            "eligibility": "pre-post coincidence on keep-pool synapses; the InSAR modulator depresses keep-pool links when wrapped phase stays high inside tau_e of a LOS-gain sample",
        },
        channel_prefix="insar.n",
        anchor="BT-4 HIL corner-cube 28 ms frame at phi 4.80 rad / k_los 2.50 mm/rad (t_s 600) reconstructing 12.00 mm / 24.00 mm/d above the 8.00 mm/d slope floor",
    )
    w_s = 0.028
    events = [
        ev(0.0, "insar.phi", 1.20, code="PHI_RAD", units="rad", note="HIL spare corner-cube in Corner-HIL-2; plant-owned Ku GB-InSAR, not DAS phi-OTDR, not BOTDA"),
        ev(30000.0, "insar.k", 2.50, code="K_LOS", units="mm_per_rad", note="lumped two-way LOS gain lambda/(4*pi); d = k_los * phi"),
        ev(60000.0, "recon.d", 3.00, code="D_MM", units="mm", note="2.50*1.20 = 3.00 exact"),
        ev(180000.0, "piez.m", 0.08, code="PIEZ_M", units="m", note="crest piezometer corridor; alarm 0.40 m"),
        ev(240000.0, "slopeveil.v", 2.10, code="VENDOR_MM_D", units="mm_d", note="Slopeveil piezometer-inverted LOS cloud; the only OEM slope SoT"),
        ev(360000.0, "insar.phi", 2.40, code="PHI_RAD", units="rad"),
        ev(420000.0, "recon.d", 6.00, code="D_MM", units="mm", note="2.50*2.40 = 6.00"),
