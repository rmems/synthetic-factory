        },
        "proposed_action": {
            "actor": "shift chemist Tamsin Quag",
            "summary": "restore air to 1.00 pu; 24 min already paid and Mossveil is 0.20",
            "basis_claimed": "the MODIFY already cut conversion, so restoring on the OEM channel is the cheapest hold",
        },
        "safety_decision": {
            "decision": "ACCEPT",
            "rationale": "Hold 0.85 pu. The soak floor is complete and the dump tripwire (delta_mm_s >= 1.80) is still armed on the plant drive. ACCEPT the hold. Do not restore 1.00 pu on Mossveil. Do not dump the 40 t inventory. 1.04 mm/s post-cut is still the Mössbauer SoT until a new frame clears 0.90.",
            "threshold": "air_pu==0.85 AND soak_floor_complete AND dump_tripwire_armed AND restore_1pu_not_taken",
        },
        "executed_action": {
            "summary": "0.85 pu held at t_s 9600; Mossveil restore not latched; inventory not dumped",
            "tool": "gm7-air-hold-exec",
            "observation": "recon.d 1.04 mm/s after cut; bed 680 C; Mossveil still ignored",
        },
        "future_outcome": {
            "timeline": [
                {"t_s": 6600.0, "event": "soak clock started after MODIFY"},
                {"t_s": 8040.0, "event": "24.0 min floor"},
                {"t_s": 9000.0, "event": "restore 1.00 pu proposed"},
                {"t_s": 9600.0, "event": "ACCEPT hold 0.85 pu"},
            ],
            "observed_effects": [
                "Mossveil restore did not reopen the isomer-shift call",
                "dump tripwire never fired; 1.20 vs 1.80 floor",
            ],
            "new_state": {"air_pu": 0.85, "restore_1pu": "blocked", "inventory": "in unit"},
            "latency_ms": 1560000.0,
        },
        "reward_components": reward(
            0.29,
            [
                ("hold_0p85", 0.11),
