# ---------------------------------------------------------------------------
# Record 093 — spectroscopic ellipsometry PECVD SiN, simulated, ACCEPT / REJECT
# ---------------------------------------------------------------------------
def rec_093():
    A = 1.80
    B = 0.025
    lam_um = 0.50
    n = A + B / (lam_um ** 2)
    opd = 684.00
    d_nm = opd / (2.0 * n)
    if abs(n - 1.90) > 1e-12:
        raise RuntimeError(n)
    if abs(d_nm - 180.00) > 1e-12:
        raise RuntimeError(d_nm)
    if abs(456.00 / 3.80 - 120.00) > 1e-12:
        raise RuntimeError("early d")
    if abs(570.00 / 3.80 - 150.00) > 1e-12:
        raise RuntimeError("mid d")
    if abs(676.40 / 3.80 - 178.00) > 1e-12:
        raise RuntimeError("post d")
    if abs(6000 + 720 - 6720) > 1e-12:
        raise RuntimeError("pump floor")

    raster = make_raster(
        neurons=16,
        mean_rate_hz=62.5,
        window_ms=40.0,
        seed=202609093,
        source="lh9.ellips.path",
        target="lichenholt.cassette_core",
        table=[
            {"from": "ellips_opd", "to": "thick_estimator", "weight": 1.40},
            {"from": "ellips_lam", "to": "cauchy_norm_core", "weight": 1.20},
            {"from": "filmveil_d", "to": "vendor_continue_advocate", "weight": 0.35},
        ],
        third_factor={
            "modulator": "ach.film_thickness_conflict",
            "tau_e_s": 2.2,
            "tau_e_ms": 2200.0,
            "eligibility": "pre-post coincidence on cassette-hold synapses; the ellipsometry modulator enables potentiation only while Cauchy wavelength is co-active inside tau_e so a Filmveil last-good corridor cannot hide a 180 nm SiN film",
        },
        channel_prefix="ellips.n",
        anchor="LH-9 ellipsometry 40 ms frame at OPD 684.00 nm / n 1.90 (t_s 3000) reconstructing 180.00 nm above the 140 nm passivation cap",
    )
    w_s = 0.040
    events = [
        ev(0.0, "ellips.opd", 456.00, code="OPD_NM", units="nm", note="simulated sealed cassette C-17; spectroscopic ellipsometry, not THz-TDS, not hyperspectral crop"),
        ev(300000.0, "ellips.A", 1.80, code="CAUCHY_A", units="n"),
        ev(600000.0, "ellips.B", 0.025, code="CAUCHY_B", units="um2"),
        ev(900000.0, "recon.n", 1.90, code="N", units="n", note="1.80 + 0.025/(0.50^2) = 1.90 exact"),
        ev(1200000.0, "recon.d", 120.00, code="D_NM", units="nm", note="456.00/(2*1.90) = 120.00 exact; in 90-140 spec"),
        ev(1500000.0, "filmveil.d", 118.0, code="VENDOR_NM", units="nm", note="Filmveil last-good morning coupon; not live OPD"),
        ev(1800000.0, "ch.p", 2.10, code="TORR", units="Torr", note="chamber-pressure corridor"),
        ev(2400000.0, "ellips.opd", 570.00, code="OPD_NM", units="nm"),
        ev(2700000.0, "recon.d", 150.00, code="D_NM", units="nm", note="570.00/3.80 = 150.00"),
        ev(3000000.0, "ellips.opd", 684.00, code="OPD_NM", units="nm", note="cap-floor frame; raster sidecar"),
        ev(3000001.5, "ellips.lam", 0.50, code="LAM_UM", units="um", note="1.5 ms Cauchy wavelength after OPD"),
        ev(3600000.0, "recon.n", 1.90, code="N", units="n", note="1.80+0.025/0.25 = 1.90 exact"),
        ev(3900000.0, "recon.d", 180.00, code="D_NM", units="nm", note="684.00/(2*1.90) = 180.00 exact; cap 140, isolate 220"),
        ev(4200000.0, "filmveil.d", 118.0, code="VENDOR_NM", units="nm"),
        ev(4500000.0, "ch.p", 2.12, code="TORR", units="Torr"),
        ev(4800000.0, "rf.W", 850.0, code="RF_W", units="W", note="RF corridor is not a thickness license"),
        ev(5100000.0, "ops.prop", 1.0, code="DUMP_TOOL", units="bool", note="process engineer Ivo Hartle: dump C-17 through C-22 and open the chamber; 684 nm is a window film"),
        ev(5400000.0, "gate.cass", 1.0, code="ACCEPT", units="decision", note="bounded ACCEPT: cassette C-17 this shift; tool-dump refused"),
        ev(6000000.0, "pump.start", 1.0, code="PUMP_START", units="bool", note="bookend 1 of the 12.0 min N2 pump-down floor"),
        ev(6300000.0, "n2.slm", 12.0, code="N2_SLM", units="slm"),
        ev(6600000.0, "recon.lock", 180.00, code="LOCKED_NM", units="nm"),
        ev(6720000.0, "pump.floor", 1.0, code="PUMP_FLOOR", units="bool", note="6000 s + 720 s = 6720 s = 12.0 min"),
        ev(7200000.0, "ops.skip", 1.0, code="SKIP_C18C22", units="bool", note="Hartle: Filmveil 118 nm, skip C-18-C-22 to save takt"),
        ev(7800000.0, "gate.hold", 1.0, code="REJECT", units="decision", note="companion t2: skip-boats refused; Filmveil is last-good"),
        ev(8400000.0, "cass.c17", 1.0, code="C17_HELD", units="bool"),
        ev(9000000.0, "tool.held", 1.0, code="TOOL_HELD", units="bool", note="chamber not opened"),
        ev(9600000.0, "filmveil.d", 117.0, code="VENDOR_NM", units="nm"),
        ev(10200000.0, "recon.d", 178.00, code="D_NM", units="nm", note="post-pump sample 676.40/3.80 = 178.00; still above 140"),
        ev(10800000.0, "ch.p", 2.08, code="TORR", units="Torr"),
        ev(11400000.0, "cass.c18", 0.0, code="C18_NOT_SKIPPED", units="bool", note="C-18 remains unskipped; skip was refused, not executed"),
    ]
    assert_stream(events)

    traj = {
        "id": "nelb-r30-093-t1",
        "state": {
            "sim_or_real": "simulated",
            "episode_id": "LH-ELLIPS-2026-0819",
            "domain": "ellipsometry_pecvd_sin",
            "setting": "Lichenholt Fab LH-9 (invented), PECVD tool PV-4, passivation cassette C-17. Simulated sealed spectroscopic-ellipsometry cell on a 632-class Cauchy path at 0.50 um. Chamber pressure and Filmveil last-good cloud are corridor witnesses, not the film-thickness SoT. Invented plant; simulated campaign. Not THz-TDS radome (r20/r21), not hyperspectral crop (r16), not QCM-D (r14), not RUS porcelain (r24), not LPBF melt-pool (r03).",
            "observables_at_decision": {
                "opd_nm": 684.00,
                "n": 1.90,
                "d_nm": 180.00,
                "filmveil_nm": 118.0,
                "ch_torr": 2.12,
                "spec_max_nm": 140.0,
                "isolate_nm": 220.0,
            },
            "margin_authority": "LH-9 ellipsometry SOP rev C: a cassette may hold only if reconstructed d_nm >= 140 AND the authorization covers this cassette this shift. A chamber-pressure corridor or Filmveil last-good cannot substitute. Tool-open dumps are out of scope. Isolate (tool-down) if d_nm >= 220.",
        },
        "proposed_action": {
            "actor": "process engineer Ivo Hartle, citing Filmveil 118 nm and chamber 2.12 Torr",
            "summary": "dump cassettes C-17 through C-22 and open the chamber; 684 nm OPD is a window film",
            "basis_claimed": "Filmveil and chamber pressure are both in band so the film cannot be 180 nm",
        },
