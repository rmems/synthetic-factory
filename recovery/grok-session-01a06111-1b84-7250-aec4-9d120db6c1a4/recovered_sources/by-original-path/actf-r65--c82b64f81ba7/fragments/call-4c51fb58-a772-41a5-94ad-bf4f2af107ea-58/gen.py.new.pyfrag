                        "    return str(uuid.UUID(bytes=raw))\n"
                        "\n"
                        "def load_catalog() -> dict:\n"
                        "    return {\n"
                        "        \"radar.hex\": load_uuid(bytes.fromhex(PLC_HEX), plc=True),\n"
                        "        \"berth.hex\": load_uuid(bytes.fromhex(RFC_HEX)),\n"
                        "    }\n"
                    ),
                },
            },
