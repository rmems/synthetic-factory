            distillation_value="Independent CUBA LIF raster races the THW estimator against a vendor-continue advocate with 1 ms refractory and 0.82**k adaptation, so a hybrid head can distill k=k_w*(P/dT) without copying the campaign stream.",
            distillation_note="THW gate: serialized k_w*(P/dT) plus SNR lock beats a vendor last-good patch; companion t2 is the recirc-hold, not a referral vote",
        ),
    }
    traj2 = {
