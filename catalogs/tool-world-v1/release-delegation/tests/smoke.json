{
  "suite": "smoke",
  "cases": [
    {
      "id": "smoke_test_present",
      "check": {
        "kind": "file_exists",
        "path": "tests/test_feature.py"
      }
    },
    {
      "id": "smoke_test_asserts_feature",
      "check": {
