{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oracle-grounded-v1.schema.json",
  "title": "OracleGroundedRecord",
  "description": "Shared envelope for the oracle-grounded neuromorphic dataset families of issue #77. A generator proposes `scenario`, `intervention`, and `candidate_prediction`; an oracle produces `result`. The two halves never mix: `proposal_hash` covers exactly the generator sections, `result_hash` covers exactly the oracle result, and `result.produced_by` must name the oracle the record declares. Validation is implemented in pipelines/oracle_grounded/record.py, which enforces every constraint here plus the per-family invariants that JSON Schema cannot express (hash recomputation, stage/authority consistency, and the family quality gates).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "family",
    "generator",
    "scenario",
    "intervention",
    "candidate_prediction",
    "proposal_hash",
    "oracle",
    "result",
    "result_hash",
    "provenance",
    "validation",
    "meta"
  ],
  "properties": {
    "schema": { "const": "oracle-grounded/v1" },
    "id": { "type": "string", "minLength": 1 },
    "family": {
      "type": "string",
      "enum": [
        "spike-encoder-equivalence-pairs",
        "neuron-dynamics-counterfactuals",
        "synaptic-delay-causal-trajectories",
        "neuromodulator-credit-assignment",
        "temporal-memory-spike-challenges"
      ]
    },
    "generator": {
      "type": "object",
      "description": "Who proposed the scenario. Never authoritative.",
      "required": ["name", "version", "role", "authoritative", "seed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "role": { "type": "string" },
        "authoritative": {
          "const": false,
          "description": "A generator may never self-certify a measurement."
        },
        "seed": { "type": "integer" },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "minProperties": 1,
      "description": "Generator-authored situation. Family-specific; see schemas/oracle-grounded/."
    },
    "intervention": {
      "type": ["object", "null"],
      "description": "Generator-authored perturbation, or null for families whose scenario is itself the manipulation."
    },
    "candidate_prediction": {
      "type": ["object", "null"],
      "description": "The generator's guess, scored against the oracle but never treated as truth.",
      "properties": {
        "kind": { "const": "non_authoritative_guess" },
        "basis": { "type": "string" }
      },
      "required": ["kind"],
      "additionalProperties": true
    },
    "proposal_hash": {
      "$ref": "#/$defs/digest",
      "description": "sha256 over the canonical JSON of {generator, scenario, intervention, candidate_prediction}. Recomputed on validation, so a measurement cannot be back-written into a scenario."
    },
    "oracle": { "$ref": "#/$defs/oracle" },
    "result": {
      "type": "object",
      "minProperties": 1,
      "required": ["produced_by", "measured", "units"],
      "description": "Oracle-authored. Curation fails closed when this is missing or empty.",
      "properties": {
        "produced_by": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal oracle.id."
        },
        "measured": { "type": "object", "minProperties": 1 },
        "units": { "type": "object", "minProperties": 1 }
      },
      "additionalProperties": false
    },
    "result_hash": { "$ref": "#/$defs/digest" },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "claimed",
        "oracle_grounded",
        "generator_authored",
        "oracle_authored"
      ],
      "properties": {
        "kind": {
          "enum": ["designed", "simulated", "hil"],
          "description": "schemas/provenance.md vocabulary. 'real' is never emitted, and 'unknown' is not allowed on a new record."
        },
        "claimed": { "type": "string" },
        "oracle_grounded": { "const": true },
        "generator_authored": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "oracle_authored": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "reasons",
        "checks",
        "candidate_prediction_correct",
        "publishable",
        "publishable_reason"
      ],
      "properties": {
        "status": { "enum": ["accepted", "rejected"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Must match the findings recomputed at validation time. A rejected record with an unrelated reason is itself invalid."
        },
        "checks": {
          "type": "object",
          "required": ["envelope", "family_invariants"],
          "properties": {
            "envelope": { "type": "boolean" },
            "family_invariants": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "candidate_prediction_correct": { "type": ["boolean", "null"] },
        "publishable": {
          "type": "boolean",
          "description": "True only when a named runtime measured the record and provenance resolved. A reference simulator never earns publication."
        },
        "publishable_reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["factory", "round", "tags"],
      "properties": {
        "factory": { "type": "string" },
        "round": { "type": "integer", "minimum": 1 },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oracle": {
      "type": "object",
      "description": "Which oracle ran, in what configuration, from what code. Every field here is retained in every accepted record.",
      "required": [
        "id",
        "type",
        "implementation",
        "authority",
        "requested_runtime",
        "runtime_bound",
        "repo",
        "commit",
        "dirty",
        "module",
        "module_digest",
        "version",
        "configuration",
        "seed",
        "units",
        "stages",
        "availability"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "implementation": {
          "enum": ["reference", "named-runtime", "mixed"],
          "description": "'reference' means the deterministic in-repo simulator ran, not the runtime named by the issue."
        },
        "authority": {
          "enum": ["reference-simulator", "measured-runtime", "mixed-reference-and-runtime"]
        },
        "requested_runtime": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "The runtime(s) the family is specified against, whether or not they were available."
        },
        "runtime_bound": { "type": "boolean" },
        "repo": { "type": "string", "minLength": 1 },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "description": "Resolved lowercase 40- or 64-hex source commit. A record whose commit cannot be resolved is rejected."
        },
        "dirty": {
          "type": ["boolean", "null"],
          "description": "Whether the working tree carried uncommitted changes when the oracle ran."
        },
        "module": { "type": "string" },
        "module_digest": {
          "$ref": "#/$defs/digest",
          "description": "sha256 over the oracle implementation sources (the simulators, adapters, family wiring, scenario RNG, and canonical form). This, not the git commit, is what pins the code that produced a measurement."
        },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "configuration": {
          "type": "object",
          "minProperties": 1,
          "description": "Everything the oracle needs, alongside the stored scenario, to reproduce the measurement."
        },
        "seed": {
          "type": ["integer", "null"],
          "description": "The seed that produced the scenario. The reference oracles draw no randomness of their own."
        },
        "units": { "type": "object", "minProperties": 1 },
        "stages": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per executed oracle stage; a chain such as limbic-critic -> plasticity-lab has one per stage. The stages are the evidence for oracle.implementation.",
          "items": {
            "type": "object",
            "required": ["stage", "implementation", "oracle_id", "version"],
            "properties": {
              "stage": { "type": "string" },
              "requested_runtime": { "type": ["string", "array", "null"] },
              "implementation": { "enum": ["reference", "named-runtime"] },
              "oracle_id": { "type": "string" },
              "version": { "type": "string" },
              "module_digest": { "$ref": "#/$defs/digest" },
              "runtime_commit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$",
                "description": "Resolved hexadecimal source revision for the named runtime."
              },
              "executable": {
                "type": "string",
                "minLength": 1,
                "description": "Basename-only executable identity. Command arguments are never retained because they may contain secrets."
              }
            },
            "additionalProperties": false
          }
        },
        "availability": {
          "type": "object",
          "required": ["protocol", "runtimes", "all_bound", "unbound"],
          "properties": {
            "protocol": { "const": "sf-oracle/1" },
            "runtimes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["runtime", "binding_env", "bound"],
                "properties": {
                  "runtime": { "type": "string" },
                  "binding_env": { "type": "string" },
                  "bound": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "all_bound": { "type": "boolean" },
            "unbound": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
