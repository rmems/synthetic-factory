  "reason_codes": [
    {
      "id": "DEEPSEEK_TERMS_SNAPSHOT_PENDING",
      "description": "DeepSeek outputs stay blocked until the reviewed terms/channel snapshot hash is recorded on this profile."
    },
    {
      "id": "HOSTED_FRONTIER_RESEARCH_ONLY",
      "description": "Hosted frontier output is retained for research only and blocked from project training."
    },
    {
      "id": "NEMOTRON_TERMS_SNAPSHOT_PENDING",
      "description": "Nemotron outputs stay blocked until the reviewed terms/channel snapshot hash is recorded on this profile."
    },
    {
      "id": "OPENROUTER_DISTILLABLE_CANDIDATE",
      "description": "OpenRouter distillable catalog membership is candidate evidence for that API channel only; generation-time snapshots and underlying terms still fail closed."
    },
    {
      "id": "OPEN_WEIGHT_LOCAL_CANDIDATE",
      "description": "Pinned local open-weight checkpoint on an isolated local runtime channel is a training candidate, not an automatic publish or training-ready claim."
    },
    {
      "id": "PROCEDURAL_ATTESTED_LOCAL",
      "description": "Deterministic local generation with a catalog-authorship attestation and generator source digest."
    },
    {
      "id": "SIMULATOR_ORACLE_PINNED",
      "description": "Deterministic in-repo simulator admitted as an oracle, pinned by commit SHA and normalized-source module digest."
    },
    {
      "id": "UNKNOWN_PROVENANCE",
      "description": "Provenance is insufficient to authorize any less restrictive project decision."
    }
  ],
