# Historical mill/leftover generators. Patterns are the reviewed quality policy
# in config/MILL-SCRIPT-INVENTORY.json. They match machine-local copies and
# origin/legacy-mill-lane scripts without ignoring production mill modules
# (leftover_mill.py, compose_mill.py, training_audit_mill.py, mill_family.py)
# or the tracked harvest notes under experiments/.
experiments/*mill*.py
experiments/**/*mill*.py
experiments/*leftover*.py
experiments/**/*leftover*.py
experiments/_gen_*.py
experiments/**/_gen_*.py
experiments/*plants*.py
experiments/**/*plants*.py
scripts/*_mill/
scripts/*_mill.py
pipelines/*_mill_leftover*.py
/mill_*_r*.py

experiments/*-loop*.py
experiments/*_loop*.py
experiments/*-hop*.py
experiments/*_hop*.py
experiments/*-chain-*.py
experiments/irc-pub-r*.py

# Rust build artifacts
/target/
