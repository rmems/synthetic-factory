# Raw dumps can get huge
outputs/raw/
outputs/staging/
*.log
*.tmp

# Local secrets / keys
.env
.env.*
*.pem

# Python / Node / Rust build artifacts
__pycache__/
*.pyc
node_modules/
target/
.venv/
venv/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Large curated datasets (promote to hf/ when ready)
outputs/cleaned/
outputs/curated/
outputs/curated/*.parquet
outputs/curated/*.jsonl.gz

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
