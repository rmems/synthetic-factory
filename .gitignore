# Raw dumps can get huge
outputs/raw/
outputs/staging/
outputs/code-repair/
*.log
*.tmp

# Local secrets / keys
.env
.env.*
*.pem

# Python / Node / Rust build artifacts
__pycache__/
*.pyc
node_modules/
target/
.venv/
venv/
.coverage
coverage.xml
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Large curated datasets (promote to hf/ when ready)
outputs/cleaned/
outputs/curated/
outputs/curated/*.parquet
outputs/curated/*.jsonl.gz

# Agent tool runtime state (never committed; regenerable or machine-local)
.beads/
.opencode/
.codex/
.grok/
.scratch*/
.swarm/
uv.lock
time_snapshot_stage.py

# Worktrees — promoted from .git/info/exclude, which is machine-local only.
# .codex/worktrees was previously excluded nowhere while holding a live worktree.
**/.claude/worktrees/
**/.codex/worktrees/
